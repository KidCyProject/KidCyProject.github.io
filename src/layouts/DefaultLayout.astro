---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getCurrentLocale } from '../i18n/i18n'
import { useTranslations } from '../i18n/index'

/**
 * DefaultLayout
 *
 * Root layout wrapping every page. Provides:
 * - <html lang> set from the current locale for screen readers
 * - <head> with charset, viewport, Content-Security-Policy, preloaded fonts, and SEO meta
 * - Sticky footer via CSS grid (header auto | main 1fr | footer auto)
 * - SkipLink component lives inside Header.astro (accessible-astro-components)
 *
 * Accessibility:
 * - lang attribute enables correct pronunciation by screen readers
 * - <main id="main-content"> is the skip-link target (WCAG 2.4.1)
 * - Semantic landmark flow: <header> → <main> → <footer>
 *
 * Performance:
 * - Font preloaded for fast first paint (Atkinson Hyperlegible — high readability)
 * - Meta description auto-truncated to 155 chars for SEO
 *
 * @see WCAG 2.4.1 — Bypass Blocks
 * @see WCAG 3.1.1 — Language of Page
 */

interface Props {
  /** Page title (the site name is appended) */
  title?: string
  /** Plain-text or simple-HTML summary for search results; defaults to the site tagline in the page language */
  description?: string
  /** Social sharing image */
  image?: string
  author?: string
  /** Keep the page out of search engines (404) */
  noindex?: boolean
  /** Extra schema.org objects describing this page */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const currentLocale = getCurrentLocale(Astro.currentLocale)
const { t } = useTranslations(Astro.currentLocale)

const {
  title = 'KidCy',
  description = t('layout.hero.subtitle'),
  image = '/og-image.jpg',
  author = 'KidCy Team',
  noindex = false,
  jsonLd,
} = Astro.props

// Content-Security-Policy. GitHub Pages cannot send HTTP headers, so the policy travels in a
// <meta> tag (which is why there is no frame-ancestors: browsers ignore it there).
// Scripts: only files from this site plus the inline scripts whose hashes the build puts in
// place of the token (scripts/csp-hashes.mjs). The dev server has no such step, so it allows
// inline scripts. Styles keep 'unsafe-inline' because the pages set colours through style="".
const scriptSources = import.meta.env.DEV ? "'unsafe-inline'" : '__CSP_SCRIPT_HASHES__'
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
  "img-src 'self' data: blob:",
  "font-src 'self'",
  "media-src 'self' blob:",
  `script-src 'self' ${scriptSources}`,
  "style-src 'self' 'unsafe-inline'",
  "connect-src 'self'",
  'upgrade-insecure-requests',
].join('; ')

// Page subtitles are reused as descriptions and may carry inline markup or line breaks
const cleanDescription = description.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim()
const metaDescription =
  cleanDescription.length > 155 ? `${cleanDescription.slice(0, 152).trimEnd()}...` : cleanDescription
---

<html lang={currentLocale} dir="ltr">
  <head>
    <!-- Browser language detection — runs before paint to avoid redirect flash.
         Auto-redirects once on first visit; manual switcher clicks override the preference. -->
    <script is:inline>
      ;(function () {
        var SUPPORTED = ['cs', 'de', 'lt', 'no']
        var STORAGE_KEY = 'kidcy-locale-pref'
        try {
          var firstSegment = window.location.pathname.split('/').filter(Boolean)[0] || ''
          var onLocalizedPage = SUPPORTED.indexOf(firstSegment) !== -1

          // Landing on a locale-prefixed page — persist it as the preference
          if (onLocalizedPage) {
            localStorage.setItem(STORAGE_KEY, firstSegment)
            return
          }

          // On English path — check stored preference
          var stored = localStorage.getItem(STORAGE_KEY)
          if (stored !== null) {
            if (SUPPORTED.indexOf(stored) !== -1) {
              window.location.replace('/' + stored + window.location.pathname + window.location.search + window.location.hash)
            }
            return
          }

          // No preference yet — detect from browser
          var langs = [].slice.call(navigator.languages || (navigator.language ? [navigator.language] : ['en']))
          var detected = 'en'
          for (var i = 0; i < langs.length; i++) {
            var base = langs[i].toLowerCase().split('-')[0]
            if (base === 'nb' || base === 'nn') base = 'no'
            if (SUPPORTED.indexOf(base) !== -1) {
              detected = base
              break
            }
          }

          localStorage.setItem(STORAGE_KEY, detected)
          if (detected !== 'en') {
            window.location.replace('/' + detected + window.location.pathname + window.location.search + window.location.hash)
          }
        } catch (_) {}
      })()
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/WWW-icon.svg" />

    <!-- Preload the body font and the heading font for fast first contentful paint -->
    <link rel="preload" href="/fonts/AtkinsonHyperlegibleNext-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Rubik-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <SiteMeta
      title={title}
      description={metaDescription}
      image={image}
      imageAlt={t('layout.hero.eyebrow')}
      author={author}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class="site-shell">
    <Header />
    <main id="main-content" class="site-main" transition:animate="fade">
      <slot />
    </main>
    <Footer />

    <style lang="scss" is:global>
      /* ── Sticky footer via CSS grid ── */
      html {
        block-size: 100%;
      }

      body {
        min-block-size: 100%;     /* fallback for browsers without dvh support */
        min-block-size: 100dvh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        /* minmax(0, …) stops wide content (e.g. the non-wrapping Aim / Objectives /
           Outcomes tab bar, which scrolls on its own) from stretching the whole
           page beyond the viewport on phones. */
        grid-template-columns: minmax(0, 1fr);
        overflow-x: clip;
        background-color: var(--background-color);
      }

      .site-main {
        inline-size: 100%;
        padding-block-end: max(var(--space-s), env(safe-area-inset-bottom));
      }

      /* Fallback for browsers that don't support overflow: clip */
      @supports not (overflow: clip) {
        body {
          overflow-x: hidden;
        }
      }

      @media (max-width: 48rem) {
        .site-main {
          padding-block-end: max(var(--space-xs), env(safe-area-inset-bottom));
        }
      }

      /* Scrollable code blocks — role="region" added via JS would be ideal,
         but tabindex="0" is handled by browsers for overflow content */
      pre {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-inline-size: 100%;
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }

      /* Respect reduced motion preference globally */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
