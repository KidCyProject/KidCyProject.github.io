---
/**
 * FileMeta — small "PDF · 1,2 MB" line for a download: file type and approximate size, read from the files on
 * disk at build time (src/utils/fileInfo.ts). Several files (language versions) show the largest size.
 * Renders nothing when none of the files exists.
 */
import { fileMeta } from '../utils/fileInfo'

interface Props {
  /** Public URLs of the file or of its language versions. */
  hrefs: ReadonlyArray<string | undefined>
  class?: string
}

const { hrefs, class: className } = Astro.props
const text = fileMeta(hrefs, Astro.currentLocale)
---

{text && <p class:list={['file-meta', className]}>{text}</p>}

<style>
  .file-meta {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--color-neutral-700);
  }

  :global(html.darkmode) .file-meta {
    color: var(--dm-fg-muted);
  }
</style>
