---
import { Icon } from 'astro-icon/components'
import { useTranslations } from 'src/i18n/index'
import { GUIDE_IDS, getGameVideos, getGuideFiles, getHubVideo, formatFileSize } from 'src/data/games'
import type { GameVideo, GuideId } from 'src/data/games'
import { MATERIAL_LANGUAGE_LABELS } from 'src/data/moduleParts'
import type { ModuleId } from 'src/data/modules'

/**
 * GameResources Component
 *
 * Second column of the game pages: guides (developer / teacher / student,
 * one language dropdown each) and the video walkthroughs of this game plus
 * the Games Hub. Everything is discovered from disk — see src/data/games.ts.
 *
 * Accessibility:
 * - Links name the file they download (title, type, size); icons are aria-hidden
 * - Language dropdowns follow the keyboard contract of src/utils/downloadMenu.ts
 */
interface Props {
  /** Module whose game videos are listed. */
  moduleId: ModuleId
  /** CSS colour of the module brand, e.g. `var(--brand-MW)`. */
  color: string
}

const { moduleId, color } = Astro.props
const locale = Astro.currentLocale
const { t } = useTranslations(locale)

const R = 'pages.hub.games.resources'
const gameTitle = t(`pages.hub.games.${moduleId}.title`)

const guides = GUIDE_IDS.map((id: GuideId) => ({
  id,
  title: t(`${R}.guides.${id}.title`),
  description: t(`${R}.guides.${id}.description`),
  files: getGuideFiles(id),
}))

const videos = getGameVideos(moduleId)
const hubVideo = getHubVideo()

const videoTitle = (video: GameVideo) => {
  switch (video.kind) {
    case 'minigame':
      return `${t(`${R}.videoKinds.minigame`)} ${video.label}`
    case 'other':
      return video.label
    default:
      return t(`${R}.videoKinds.${video.kind}`)
  }
}

const size = (bytes: number) => formatFileSize(bytes, locale)
---

<section class="game-resources" style={`--game-color: ${color}`} aria-labelledby={`game-resources-${moduleId}`}>
  <h2 id={`game-resources-${moduleId}`} class="mb-2">{t(`${R}.heading`)}</h2>
  <p>{t(`${R}.description`)}</p>

  <h3 class="game-resources__subtitle">{t(`${R}.guidesTitle`)}</h3>
  <ul class="game-resources__list">
    {
      guides.map((guide) => (
        <li class="game-resources__item">
          <div class="game-resources__text">
            <strong>{guide.title}</strong>
            <span>{guide.description}</span>
          </div>

          {guide.files.length === 0 && <span class="game-resources__soon">{t(`${R}.comingSoon`)}</span>}

          {guide.files.length === 1 && (
            <a
              class="button has-icon game-resources__button"
              href={guide.files[0].href}
              download={guide.files[0].filename}
              aria-label={`${t(`${R}.download`)}: ${guide.title} (${guide.files[0].type})`}
            >
              <Icon name="lucide:download" />
              <span>{t(`${R}.download`)}</span>
            </a>
          )}

          {guide.files.length > 1 && (
            <div class="game-resources__menu-wrap">
              <button
                type="button"
                class="button has-icon game-resources__button gr-trigger"
                aria-expanded="false"
                aria-controls={`game-guide-${moduleId}-${guide.id}`}
                aria-label={`${t(`${R}.download`)}: ${guide.title}`}
                data-download-trigger
              >
                <Icon name="lucide:download" />
                <span>{t(`${R}.download`)}</span>
                <Icon name="lucide:chevron-down" />
              </button>
              <ul
                class="gr-menu"
                id={`game-guide-${moduleId}-${guide.id}`}
                style={`--game-color: ${color}`}
                aria-label={`${t(`${R}.download`)}: ${guide.title}`}
                data-download-menu
                hidden
              >
                {guide.files.map((file) => (
                  <li>
                    <a class="gr-option" href={file.href} download={file.filename} hreflang={file.lang}>
                      <span class="gr-code" aria-hidden="true">{file.lang.toUpperCase()}</span>
                      <span lang={file.lang}>{MATERIAL_LANGUAGE_LABELS[file.lang]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))
    }
  </ul>

  <h3 class="game-resources__subtitle">{t(`${R}.videosTitle`)}</h3>
  <p class="game-resources__hint">{t(`${R}.videosDescription`)}</p>
  <ul class="game-resources__list">
    {
      [...videos.map((video) => ({ video, title: videoTitle(video) })), ...(hubVideo ? [{ video: hubVideo, title: t(`${R}.videoKinds.hub`) }] : [])].map(
        ({ video, title }) => (
          <li class="game-resources__item">
            <div class="game-resources__text">
              <strong>{title}</strong>
              <span>MP4{size(video.bytes) ? ` · ${size(video.bytes)}` : ''}</span>
            </div>
            <a
              class="button has-icon game-resources__button"
              href={video.href}
              download={video.filename}
              aria-label={`${t(`${R}.download`)}: ${title} (MP4${size(video.bytes) ? `, ${size(video.bytes)}` : ''})`}
            >
              <Icon name="lucide:download" />
              <span>{t(`${R}.download`)}</span>
            </a>
          </li>
        ),
      )
    }
  </ul>
</section>

<script>
  import { initDownloadMenus } from '../utils/downloadMenu'

  document.addEventListener('astro:page-load', initDownloadMenus)
  initDownloadMenus()
</script>

<style>
  .game-resources {
    padding: 1.5rem 1.75rem;
    border-radius: 0.9rem;
    border: 1px solid color-mix(in oklab, var(--game-color), white 50%);
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--game-color), white 92%),
      color-mix(in oklab, var(--game-color), white 97%)
    );
  }

  .game-resources h2 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.15;
  }

  .game-resources__subtitle {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem;
  }

  .game-resources__hint {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }

  .game-resources__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .game-resources__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-radius: 0.6rem;
    border: 1px solid color-mix(in oklab, var(--game-color), white 70%);
    background: rgb(255 255 255 / 0.65);
  }

  .game-resources__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 0.95rem;
  }

  .game-resources__text span {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .game-resources__soon {
    flex-shrink: 0;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    background: color-mix(in oklab, var(--game-color), white 85%);
    color: color-mix(in oklab, var(--game-color), black 45%);
  }

  .game-resources__button {
    flex-shrink: 0;
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
    border-radius: 10px;
    background: var(--game-color);
    border: 2px solid color-mix(in oklab, var(--game-color), black 10%);
    color: #fff;
    text-decoration: none;
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .game-resources__button:hover {
    background: color-mix(in oklab, var(--game-color), black 12%);
    color: #fff;
    transform: translateY(-1px);
  }

  .gr-trigger :global(svg:last-child) {
    transition: transform 0.2s ease;
  }

  .gr-trigger[aria-expanded='true'] :global(svg:last-child) {
    transform: rotate(180deg);
  }

  /* ── Language dropdown (behaviour: src/utils/downloadMenu.ts) ──────────────── */
  .gr-menu {
    position: fixed;
    z-index: 1000;
    min-width: 12rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: #fff;
    border: 1px solid color-mix(in oklab, var(--game-color), white 45%);
    border-radius: 10px;
    box-shadow: 0 12px 28px -8px rgb(0 0 0 / 0.22);
  }

  .gr-menu[hidden] {
    display: none;
  }

  .gr-menu li {
    margin: 0;
  }

  .gr-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    color: var(--color-neutral-900, #1c1917);
    font-weight: 600;
    font-size: var(--font-size--1);
    text-decoration: none;
  }

  .gr-option:hover,
  .gr-option:focus-visible {
    background: color-mix(in oklab, var(--game-color), white 88%);
    outline: none;
  }

  .gr-option:focus-visible {
    box-shadow: inset 0 0 0 2px var(--game-color);
  }

  .gr-code {
    min-width: 2rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: color-mix(in oklab, var(--game-color), white 85%);
    color: color-mix(in oklab, var(--game-color), black 45%);
    font-size: 0.75rem;
    font-weight: 800;
    text-align: center;
  }

  /* ── Dark mode ──────────────────────────────────────────────────────────────── */
  :global(html.darkmode) .game-resources {
    background: var(--dm-surface-1);
    border-color: var(--dm-border-sub);
    color: var(--dm-fg-muted);
  }

  :global(html.darkmode) .game-resources__item {
    background: var(--dm-surface-2);
    border-color: var(--dm-border-sub);
  }

  :global(html.darkmode) .game-resources__soon,
  :global(html.darkmode) .gr-code {
    background: color-mix(in oklab, var(--game-color) 25%, var(--dm-surface-3));
    color: var(--dm-fg);
  }

  :global(html.darkmode) .game-resources__button {
    color: #1c1917;
  }

  :global(html.darkmode) .game-resources__button:hover {
    color: #1c1917;
  }

  :global(html.darkmode) .gr-menu {
    background: var(--dm-surface-2);
    border-color: color-mix(in oklab, var(--game-color) 40%, var(--dm-border-sub));
  }

  :global(html.darkmode) .gr-option {
    color: var(--dm-fg);
  }

  :global(html.darkmode) .gr-option:hover,
  :global(html.darkmode) .gr-option:focus-visible {
    background: color-mix(in oklab, var(--game-color) 18%, var(--dm-surface-2));
  }

  @media (max-width: 30rem) {
    .game-resources__item {
      flex-direction: column;
      align-items: stretch;
    }

    .game-resources__soon {
      align-self: flex-start;
    }
  }
</style>
