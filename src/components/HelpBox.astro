---
/**
 * HelpBox — "Need to talk to someone?" (collapsed on phones).
 *
 * The text, and above all the helpline numbers, come from the `help` translations, so every language shows
 * the numbers of its own country.
 */
import HintPanel from './HintPanel.astro'
import { useTranslations } from 'src/i18n/index'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const { t, v } = useTranslations(Astro.currentLocale)
const items = v<ReadonlyArray<{ icon: string; text: string }>>('help.items') ?? []
---

<HintPanel class={className} title={t('help.title')} subtitle={t('help.subtitle')}>
  {items.map((item) => (
    <div class="flex gap-2 text-sm">
      <span class="shrink-0" aria-hidden="true">{item.icon}</span>
      <div>{item.text}</div>
    </div>
  ))}
  <p class="mt-3 text-xs font-semibold text-slate-700">{t('help.note')}</p>
</HintPanel>
