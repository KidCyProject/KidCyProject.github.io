<script>
  import { initDownloadMenus } from '../utils/downloadMenu'

  // When a URL contains a hash that targets a <details> element (e.g. a direct
  // link to a module part like /content#digital-environments), open it and
  // scroll to it. requestAnimationFrame gives the browser one paint cycle to
  // render the newly open details before scrollIntoView fires — without it the
  // element may not yet have layout and scrolling lands in the wrong position.
  const expandFromHash = () => {
    const hash = window.location.hash.slice(1)
    if (!hash) return

    const target = document.getElementById(hash)
    if (target instanceof HTMLDetailsElement) {
      target.open = true
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      })
    }
  }

  // astro:page-load fires on every view-transition navigation, so both handlers
  // must be re-registered here to stay active after client-side routing.
  document.addEventListener('astro:page-load', expandFromHash)
  expandFromHash()
  // the "Part N" buttons beside each part are in-page links: open the part they point to
  window.addEventListener('hashchange', expandFromHash)

  // Tabs (Aim / Objectives / Outcomes and the per-part Activity / Materials / Video tabs).
  // Follows the WAI-ARIA tabs pattern: each tab names its panel (aria-controls), each panel
  // is named by its tab (aria-labelledby), only the selected tab is in the Tab order, and
  // Arrow keys / Home / End move between tabs.
  const initTabs = () => {
    document.querySelectorAll<HTMLElement>('.mc-tabs').forEach(tabs => {
      const bar = tabs.querySelector<HTMLElement>('.mc-tabs__bar')
      // astro:page-load also fires on the first load — bind each tab bar only once
      if (!bar || bar.dataset.bound === 'true') return
      bar.dataset.bound = 'true'

      const tabButtons = Array.from(bar.querySelectorAll<HTMLElement>('[role="tab"]'))
      const panels = Array.from(tabs.querySelectorAll<HTMLElement>('[role="tabpanel"]'))
        .filter(panel => panel.closest('.mc-tabs') === tabs)

      const select = (btn: HTMLElement, moveFocus = false) => {
        const targetId = btn.dataset.panel
        if (!targetId) return
        tabButtons.forEach(tab => {
          const selected = tab === btn
          tab.setAttribute('aria-selected', selected ? 'true' : 'false')
          tab.tabIndex = selected ? 0 : -1
        })
        panels.forEach(panel => {
          panel.hidden = panel.id !== targetId
        })
        if (moveFocus) btn.focus()
      }

      tabButtons.forEach(tab => {
        const panelId = tab.dataset.panel
        if (!panelId) return
        tab.id = `tab-${panelId}`
        tab.setAttribute('aria-controls', panelId)
        tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1
        const panel = panels.find(p => p.id === panelId)
        if (panel) {
          panel.setAttribute('aria-labelledby', tab.id)
          // lets keyboard users reach panels that hold only text
          panel.tabIndex = 0
        }
      })

      bar.addEventListener('click', e => {
        const btn = (e.target as Element).closest<HTMLElement>('[role="tab"]')
        if (btn) select(btn)
      })

      bar.addEventListener('keydown', e => {
        const current = tabButtons.indexOf(document.activeElement as HTMLElement)
        if (current === -1) return
        let next = -1
        if (e.key === 'ArrowRight') next = (current + 1) % tabButtons.length
        else if (e.key === 'ArrowLeft') next = (current - 1 + tabButtons.length) % tabButtons.length
        else if (e.key === 'Home') next = 0
        else if (e.key === 'End') next = tabButtons.length - 1
        if (next === -1) return
        e.preventDefault()
        select(tabButtons[next], true)
      })
    })
  }

  document.addEventListener('astro:page-load', initTabs)
  initTabs()

  document.addEventListener('astro:page-load', initDownloadMenus)
  initDownloadMenus()
</script>

