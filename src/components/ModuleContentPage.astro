---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ModuleActivities from '@components/ModuleActivities.astro'
import ModuleRowList from '@components/ModuleRowList.astro'
import FileMeta from '@components/FileMeta.astro'
import FileSize from '@components/FileSize.astro'
import { downloadExists } from '../utils/fileInfo'
import { Icon } from 'astro-icon/components'
import { localizePath } from 'src/i18n/i18n'
import { getModule, introMaterials } from 'src/data/modules'
import type { ModuleId } from 'src/data/modules'
import { modulePartsData, mergeParts, MATERIAL_LANGUAGE_LABELS, languageDownloadName } from 'src/data/moduleParts'
import type { LanguagePackage, TranslationPart, TeachingGuide, RelatedModuleCard, MergedPart, MergedMaterial, MergedActivityStep, PartMeta } from 'src/data/moduleParts'
import { useTranslations } from 'src/i18n/index'

/**
 * ModuleContentPage
 *
 * The whole "content" page of a learning module (Aim / Objectives / Outcomes tabs,
 * teaching guide, parts with materials and videos, activities, related modules).
 * All seven modules share this one template; the page files in
 * src/pages/learning-hub/<module>/content.astro only pass their module id.
 *
 * Per-module differences come from data, not from markup:
 * - texts:   translation namespace content<ID> (e.g. contentMW)
 * - assets:  src/data/moduleParts.ts and src/data/modules.ts
 * - colour:  --module-brand, set on :root below from --brand-<ID>
 */
interface Props {
  moduleId: ModuleId
}

const { moduleId } = Astro.props
const ns = `content${moduleId.toUpperCase()}`
const brand = `var(--brand-${moduleId.toUpperCase()})`

// File-name base of the "all materials" download, e.g. "Malware Material Package (EN).zip".
const PACKAGE_NAMES: Record<ModuleId, string> = {
  dc: 'Digital Citizenship Material Package',
  ap: 'Attacker Perspective Material Package',
  at: 'Authentication Material Package',
  dp: 'Data Privacy Material Package',
  se: 'Social Engineering Material Package',
  mw: 'Malware Material Package',
  dm: 'Digital Misuse Material Package',
}

const locale = Astro.currentLocale
const { t, v, formatCount } = useTranslations(locale)

const objectives = v<ReadonlyArray<string>>(`${ns}.objectives`) ?? []
const outcomes = v<ReadonlyArray<string>>(`${ns}.outcomes`) ?? []
const teachingGuide = v<TeachingGuide>(`${ns}.teachingGuide`) ?? {}
const currentModule = getModule(moduleId)!
// Language options for the page-header download dropdowns. Languages that have no
// material yet are left out, so no option leads to a missing file.
const headerLanguages = (pkg: LanguagePackage, base: string) =>
  pkg.languages.filter((file) => downloadExists(file.href)).map((file) => ({
    lang: file.lang,
    label: MATERIAL_LANGUAGE_LABELS[file.lang],
    href: file.href,
    download: languageDownloadName(base, file),
  }))
// mergeParts combines structural asset data (file paths, video sources) from
// modulePartsData with the locale-specific text from <namespace>.parts. The
// result is what the template consumes — neither source alone is sufficient.
const parts = mergeParts(moduleId, v<ReadonlyArray<TranslationPart>>(`${ns}.parts`) ?? [])

// Related module cards are authored in the translation file but their counts
// (parts, materials, videos, etc.) are overwritten here with live values from
// modulePartsData. This keeps cards accurate when a module gains new content
// without requiring editors to update every locale's translation file.
const relatedModuleCards = (v<ReadonlyArray<RelatedModuleCard>>(`${ns}.relatedModuleCards`) ?? []).map(card => { const mod = getModule(card.moduleId); if (!mod) return card; return { ...card, parts: modulePartsData[mod.id].length, materials: mod.materials, videos: mod.videos, challenges: mod.challenges, games: mod.games } })

// Header download buttons; a button whose package has no language to offer is not shown.
const headerButtons = [
  {
    text: t('pages.hub.contentPage.downloadIntro'),
    languages: headerLanguages(introMaterials, t('pages.hub.contentPage.introPackage')),
  },
  {
    text: t('pages.hub.contentPage.downloadAll'),
    languages: headerLanguages(currentModule.materialsPackage, PACKAGE_NAMES[moduleId]),
  },
]
  .filter((button) => button.languages.length > 0)
  .map((button) => ({ ...button, href: button.languages[0].href, variant: 'primary' as const, icon: 'lucide:download' }))

const hasCount = (value: unknown): value is number => typeof value === 'number' && value > 0

const getPartTitle = (part: MergedPart) => part.titleKey ? t(part.titleKey) : ''

const moduleImages = {
  dc: '/images/learning-hub/01_digital-citizenship.webp',
  ap: '/images/learning-hub/02_attacker-perspective.webp',
  at: '/images/learning-hub/03_authentication.webp',
  dp: '/images/learning-hub/04_data-privacy.webp',
  se: '/images/learning-hub/05_social-engineering.webp',
  mw: '/images/learning-hub/06_malware.webp',
  dm: '/images/learning-hub/07_digital-misuse.webp',
}
---

<DefaultLayout
  title={t(`pages.hub.modules.${moduleId}.title`)}
  description={t(`pages.hub.modules.${moduleId}.description`)}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: t(`pages.hub.modules.${moduleId}.title`),
    description: t(`pages.hub.modules.${moduleId}.description`),
    inLanguage: locale ?? 'en',
    isAccessibleForFree: true,
    educationalLevel: 'Upper elementary',
    provider: { '@type': 'Organization', name: 'KidCy', url: new URL('/', Astro.site).toString() },
  }}
>
  <PageHeader
      title={t(`pages.hub.modules.${moduleId}.title`)}
      subtitle={t(`pages.hub.modules.${moduleId}.description`)}
      underlineColor={brand}
      bgType="module"
      buttons={headerButtons}
      />

  <style is:inline set:html={`:root{--module-brand:${brand}}`}></style>

  <!-- Main Content Area -->
  <section class="my-12">
    <div class="container">

      <!-- Learning Overview: Aim / Objectives / Outcomes tabs -->
      <div class="aoo-card">
        <div class="mc-tabs">
          <div class="mc-tabs__bar" role="tablist">
            <button class="mc-tab" role="tab" aria-selected="true" data-panel="aoo-aim">
              <img class="mc-tab-img-icon" src="/images/learning-hub/aim.webp" alt="" aria-hidden="true" width="22" height="22" />
              {t('pages.hub.contentPage.aimTitle')}
            </button>
            <button class="mc-tab" role="tab" aria-selected="false" data-panel="aoo-objectives">
              <img class="mc-tab-img-icon" src="/images/learning-hub/objectives.webp" alt="" aria-hidden="true" width="22" height="22" />
              {t('pages.hub.contentPage.objectivesTitle')}
              <span class="mc-tab__badge">{objectives.length}</span>
            </button>
            <button class="mc-tab" role="tab" aria-selected="false" data-panel="aoo-outcomes">
              <img class="mc-tab-img-icon" src="/images/learning-hub/outcomes.webp" alt="" aria-hidden="true" width="22" height="22" />
              {t('pages.hub.contentPage.outcomesTitle')}
              <span class="mc-tab__badge">{outcomes.length}</span>
            </button>
          </div>

          <div class="mc-tab-panel" role="tabpanel" id="aoo-aim">
            <div class="mc-aim-content">
              <p class="mc-aim-text">{t(`${ns}.aim`)}</p>
            </div>
          </div>

          <div class="mc-tab-panel" role="tabpanel" id="aoo-objectives" hidden>
            <ul class="mc-step-list">
              {objectives.map((obj, i) => (
                <li class="mc-step-item mc-step-item--plain">
                  <span class="mc-step-num">{String(i + 1).padStart(2, '0')}</span>
                  <p class="mc-step-title">{obj}</p>
                </li>
              ))}
            </ul>
          </div>

          <div class="mc-tab-panel" role="tabpanel" id="aoo-outcomes" hidden>
            <ul class="mc-step-list">
              {outcomes.map((outcome, i) => (
                <li class="mc-step-item mc-step-item--plain">
                  <span class="mc-step-num">{String(i + 1).padStart(2, '0')}</span>
                  <p class="mc-step-title">{outcome}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Section Divider -->
      <div class="mc-divider mc-divider--center" style="margin-top: var(--space-xl);">{t('pages.hub.contentPage.dividerContent')}</div>

      <!-- Module Content -->
      <div class="mc-section" id="module-content">
        <div class="mc-section__header">
          <h2>{t('pages.hub.contentPage.moduleContent')}</h2>
          <p class="mc-section__subtitle">{t('pages.hub.contentPage.moduleContentSubtitle')}</p>
        </div>
        <div class="mc-module-list">
          <div class="mc-module-row">
            <a class="mc-part-button" href="#teaching-guide">{t('pages.hub.labels.guide')}</a>
            <div class="mc-teaching-guide" id="teaching-guide">
              <div class="mc-package-banner__copy">
                <h3>{t('pages.hub.contentPage.guideTitle')}</h3>
                <p class="mc-package-banner__sub">{t('pages.hub.contentPage.guideDescription')}</p>
              </div>
              <div class="mc-package-btn-wrap">
                <button
                  type="button"
                  class="button has-icon mc-package-btn mc-download-trigger"
                  aria-expanded="false"
                  aria-controls="teaching-guide-download"
                  aria-label={String(teachingGuide.ariaLabel || t('pages.hub.contentPage.downloadGuide'))}
                  data-download-trigger
                >
                  <Icon name="lucide:download" />
                  <span>{t('pages.hub.contentPage.downloadGuide')}</span>
                  <Icon name="lucide:chevron-down" />
                </button>
                <ul
                  class="mc-download-menu"
                  id="teaching-guide-download"
                  aria-label={String(teachingGuide.ariaLabel || t('pages.hub.contentPage.downloadGuide'))}
                  data-download-menu
                  hidden
                >
                  {(currentModule.teachingGuide.languages ?? []).filter((file) => downloadExists(file.href)).map((file) => (
                    <li>
                      <a
                        class="mc-download-option"
                        href={file.href}
                        download={languageDownloadName(teachingGuide.download || t('pages.hub.contentPage.guideTitle'), file)}
                        hreflang={file.lang}
                      >
                        <span class="mc-download-code" aria-hidden="true">{file.lang.toUpperCase()}</span>
                        <span lang={file.lang}>{MATERIAL_LANGUAGE_LABELS[file.lang]}</span>
                        <FileSize href={file.href} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          {parts.map((part) => {
            const meta: PartMeta = part.meta ?? { steps: 0, materials: 0, videos: 0 }
            const included = part.included ?? {}
            const partMaterials = included.materials ?? []
            const partActivity = included.activityPlan ?? []
            const featuredVideo = part.featuredVideo
            const title = getPartTitle(part)
            // Activity plan opens first when present — it is the primary teaching
            // sequence. Materials are secondary. Video is the fallback tab.
            const firstPanel = partActivity.length ? 'activity' : partMaterials.length ? 'materials' : 'video'

            return (
              <div class="mc-module-row">
                <a class="mc-part-button" href={`#${part.anchorId}`}>{t('pages.hub.labels.part')} {part.number}</a>
                <details class="mc-module" id={part.anchorId}>
                  <summary class="mc-module__header">
                    <div class="mc-module__copy">
                      <h3>{title}</h3>
                      <div class="mc-module__meta">
                        {hasCount(meta.steps) ? (
                          <span class="mc-meta-item"><Icon name="lucide:list-checks" /> {formatCount(meta.steps, 'step')}</span>
                        ) : null}
                        {hasCount(meta.materials) ? (
                          <span class="mc-meta-item"><Icon name="lucide:file-text" /> {formatCount(meta.materials, 'material')}</span>
                        ) : null}
                        {hasCount(meta.videos) ? (
                          <span class="mc-meta-item"><Icon name="lucide:play-circle" /> {formatCount(meta.videos, 'video')}</span>
                        ) : null}
                      </div>
                      <p class="mc-goal"><b>{t('pages.hub.labels.goal')}</b> {String(part.goal ?? '')}</p>
                    </div>
                    <span class="mc-module__toggle" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M8 5l8 7-8 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </summary>
                  <div class="mc-module__content">
                    <div class="mc-package-banner">
                      <div class="mc-package-banner__copy">
                        <p class="mc-package-banner__title">{t('pages.hub.contentPage.materialPackage')}</p>
                        <p class="mc-package-banner__sub">{t('pages.hub.contentPage.materialPackageSub')}</p>
                      </div>
                      <div class="mc-package-btn-wrap">
                        <button
                          type="button"
                          class="button has-icon mc-package-btn mc-download-trigger"
                          aria-expanded="false"
                          aria-controls={`package-${part.anchorId}`}
                          aria-label={`${t('pages.hub.contentPage.downloadPackage')}: ${title}`}
                          data-download-trigger
                        >
                          <Icon name="lucide:download" />
                          <span>{t('pages.hub.contentPage.downloadPackage')}</span>
                          <Icon name="lucide:chevron-down" />
                        </button>
                        <ul
                          class="mc-download-menu"
                          id={`package-${part.anchorId}`}
                          aria-label={`${t('pages.hub.contentPage.downloadPackage')}: ${title}`}
                          data-download-menu
                          hidden
                        >
                          {(part.bundle?.languages ?? []).filter((file) => downloadExists(file.href)).map((file) => (
                            <li>
                              <a
                                class="mc-download-option"
                                href={file.href}
                                download={languageDownloadName(part.bundle?.filename, file)}
                                hreflang={file.lang}
                              >
                                <span class="mc-download-code" aria-hidden="true">{file.lang.toUpperCase()}</span>
                                <span lang={file.lang}>{MATERIAL_LANGUAGE_LABELS[file.lang]}</span>
                                <FileSize href={file.href} />
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    {(partMaterials.length || partActivity.length || featuredVideo) ? (
                      <div class="mc-tabs">
                        <div class="mc-tabs__bar" role="tablist">
                          {partActivity.length ? (
                            <button
                              class="mc-tab"
                              role="tab"
                              aria-selected={firstPanel === 'activity' ? 'true' : 'false'}
                              data-panel={`activity-${part.anchorId}`}
                            >
                              <Icon name="lucide:list" />
                              {t('pages.hub.labels.activityPlan')}
                              <span class="mc-tab__badge">{partActivity.length}</span>
                            </button>
                          ) : null}
                          {partMaterials.length ? (
                            <button
                              class="mc-tab"
                              role="tab"
                              aria-selected={firstPanel === 'materials' ? 'true' : 'false'}
                              data-panel={`materials-${part.anchorId}`}
                            >
                              <Icon name="lucide:file-text" />
                              {t('pages.hub.labels.materials')}
                              <span class="mc-tab__badge">{partMaterials.length}</span>
                            </button>
                          ) : null}
                          {featuredVideo ? (
                            <button
                              class="mc-tab"
                              role="tab"
                              aria-selected={firstPanel === 'video' ? 'true' : 'false'}
                              data-panel={`video-${part.anchorId}`}
                            >
                              <Icon name="lucide:video" />
                              {t('pages.hub.labels.videos')}
                              <span class="mc-tab__badge">1</span>
                            </button>
                          ) : null}
                        </div>

                        {partMaterials.length ? (
                          <div
                            class="mc-tab-panel"
                            role="tabpanel"
                            id={`materials-${part.anchorId}`}
                            hidden={firstPanel !== 'materials'}
                          >
                            <ModuleRowList
                              accent={brand}
                              rows={partMaterials.map((item: MergedMaterial, i: number) => ({
                                num: item.id ?? String(i + 1).padStart(2, '0'),
                                label: String(item.kind ?? ''),
                                title: String(item.name ?? ''),
                                files: item.languages?.length ? item.languages.map((file) => file.href) : [item.href],
                              }))}
                            >
                              {(i: number) => {
                                const item = partMaterials[i]
                                return item.languages?.length ? (
                                  <div class="mc-material-download">
                                    <button
                                      type="button"
                                      class="mc-item-download mc-download-trigger"
                                      aria-expanded="false"
                                      aria-controls={`material-${part.anchorId}-${i}`}
                                      aria-label={`${t('pages.hub.contentPage.download')}: ${String(item.kind ?? '')} – ${String(item.name ?? '')}`}
                                      data-download-trigger
                                    >
                                      <Icon name="lucide:download" />
                                      <span>{t('pages.hub.contentPage.download')}</span>
                                      <Icon name="lucide:chevron-down" />
                                    </button>
                                    <ul
                                      class="mc-download-menu"
                                      id={`material-${part.anchorId}-${i}`}
                                      aria-label={String(item.ariaLabel ?? t('pages.hub.contentPage.download'))}
                                      data-download-menu
                                      hidden
                                    >
                                      {item.languages.map((file) => (
                                        <li>
                                          <a
                                            class="mc-download-option"
                                            href={file.href}
                                            download={item.filename ? `${item.filename} (${file.lang.toUpperCase()}).${file.href.split('.').pop()}` : file.href.split('/').pop()}
                                            hreflang={file.lang}
                                          >
                                            <span class="mc-download-code" aria-hidden="true">{file.lang.toUpperCase()}</span>
                                            <span lang={file.lang}>{MATERIAL_LANGUAGE_LABELS[file.lang]}</span>
                                            <FileSize href={file.href} />
                                          </a>
                                        </li>
                                      ))}
                                    </ul>
                                  </div>
                                ) : (
                                  <a
                                    class="mc-item-download"
                                    href={String(item.href ?? '')}
                                    download={String(item.filename ?? '')}
                                    aria-label={String(item.ariaLabel ?? '')}
                                  >
                                    <Icon name="lucide:download" />
                                    <span>{t('pages.hub.contentPage.download')}</span>
                                  </a>
                                )
                              }}
                            </ModuleRowList>
                          </div>
                        ) : null}

                        {partActivity.length ? (
                          <div
                            class="mc-tab-panel"
                            role="tabpanel"
                            id={`activity-${part.anchorId}`}
                            hidden={firstPanel !== 'activity'}
                          >
                            <ModuleRowList
                              accent={brand}
                              rows={partActivity.map((step: MergedActivityStep) => ({
                                num: String(step.stepNumber ?? 0).padStart(2, '0'),
                                label: `${t('pages.hub.labels.step')} ${String(step.stepNumber ?? '')}`,
                                title: String(step.title ?? ''),
                              }))}
                            />
                          </div>
                        ) : null}

                        {featuredVideo ? (
                          <div
                            class="mc-tab-panel"
                            role="tabpanel"
                            id={`video-${part.anchorId}`}
                            hidden={firstPanel !== 'video'}
                          >
                            <div class="mc-video-preview">
                              <div class="mc-video-preview__thumb">
                                <video
                                  controls
                                  preload="metadata"
                                  poster={String(featuredVideo.posterSrc ?? '')}
                                >
                                  <source src={String(featuredVideo.videoSrc ?? '')} />
                                  {(featuredVideo.tracks ?? []).map((track) => (
                                    <track
                                      label={String(track.label ?? '')}
                                      kind="subtitles"
                                      srclang={String(track.srclang ?? '')}
                                      src={String(track.src ?? '')}
                                    />
                                  ))}
                                </video>
                              </div>
                              <div class="mc-video-preview__info">
                                <h4 class="mc-video-preview__title">{String(featuredVideo.title ?? '')}</h4>
                                <FileMeta hrefs={[featuredVideo.downloads?.video?.href]} />
                                <p class="mc-video-preview__desc">{String(featuredVideo.supportText ?? '')}</p>
                                <div class="mc-video-preview__actions">
                                  <div class="mc-video-action-wrap">
                                    <a
                                      class="mc-item-download"
                                      href={String(featuredVideo.downloads?.video?.href ?? '')}
                                      download={String(featuredVideo.downloads?.video?.filename ?? '')}
                                      aria-label={String(featuredVideo.downloads?.video?.ariaLabel ?? '')}
                                    >
                                      <Icon name="lucide:download" />
                                      <span>{t('pages.hub.labels.video')}</span>
                                    </a>
                                  </div>
                                  <div class="mc-video-action-wrap">
                                    <button
                                      type="button"
                                      class="mc-item-download mc-download-trigger"
                                      aria-expanded="false"
                                      aria-controls={`subtitles-${part.anchorId}`}
                                      data-download-trigger
                                    >
                                      <Icon name="lucide:captions" />
                                      <span>{t('pages.hub.labels.subtitles')}</span>
                                      <Icon name="lucide:chevron-down" />
                                    </button>
                                    <ul
                                      class="mc-download-menu"
                                      id={`subtitles-${part.anchorId}`}
                                      aria-label={String(featuredVideo.downloads?.subtitles?.ariaLabel ?? t('pages.hub.labels.subtitles'))}
                                      data-download-menu
                                      hidden
                                    >
                                      {(featuredVideo.tracks ?? []).map((track) => (
                                        <li>
                                          <a
                                            class="mc-download-option"
                                            href={String(track.src ?? '')}
                                            download={String(track.src ?? '').split('/').pop()}
                                            hreflang={String(track.srclang ?? '')}
                                          >
                                            <span class="mc-download-code" aria-hidden="true">{String(track.srclang ?? '').toUpperCase()}</span>
                                            <span lang={String(track.srclang ?? '')}>{String(track.label ?? '')}</span>
                                            <FileSize href={String(track.src ?? '')} />
                                          </a>
                                        </li>
                                      ))}
                                    </ul>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        ) : null}
                      </div>
                    ) : null}
                  </div>
                </details>
              </div>
            )
          })}
        </div>
      </div>

      <!-- Section Divider -->
      <div class="mc-divider mc-divider--center">{t('pages.hub.contentPage.dividerActivities')}</div>

      <!-- Additional Activities: challenge + game (same cards as the Learning Hub introduction) -->
      <section id="additional-activities" aria-labelledby="additional-activities-heading">
        <h2 id="additional-activities-heading" class="sr-only">{t('pages.hub.contentPage.dividerActivities')}</h2>
        <ModuleActivities moduleId={moduleId} />
      </section>

      <!-- Section Divider -->
      <div class="mc-divider mc-divider--center">{t('pages.hub.contentPage.dividerMore')}</div>

      <!-- Related Modules -->
      <div class="mc-section">
        <div class="mc-section__header">
          <h2>{t('pages.hub.contentPage.relatedModules')}</h2>
          <p class="mc-section__subtitle">{t('pages.hub.contentPage.relatedModulesSubtitle')}</p>
        </div>

        <div class="mc-rm-list">
          {relatedModuleCards.map((card, idx) => {
            const moduleId = String(card.moduleId ?? '')
            const title = t(`pages.hub.modules.${moduleId}.title`)
            const href = localizePath(locale, String(card.href ?? ''))
            const image = moduleImages[moduleId as keyof typeof moduleImages]
            const brandVar = `var(--brand-${String(card.brand ?? '')})`

            return (
              <a
                class={`mc-rm-row${idx === 0 ? ' mc-rm-row--first' : ''}`}
                href={href}
                style={`--rm-color: ${brandVar};`}
              >
                <div class="mc-rm-icon">
                  <img src={image} alt="" width="56" height="56" decoding="async" loading="lazy" />
                </div>
                <div class="mc-rm-body">
                  <strong class="mc-rm-title">{title}</strong>
                  <span class="mc-rm-desc">{t(`pages.hub.modules.${moduleId}.description`)}</span>
                </div>
                <div class="mc-rm-meta" aria-label={title}>
                  {hasCount(card.parts) ? (
                    <span class="mc-rm-stat">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                      {card.parts}
                    </span>
