---
/**
 * ModuleRowList — the table-like rows used in a module part's "Materials" and
 * "Activity Plan" tabs on every module content page:
 *
 *   number/ID | type pill (e.g. "Scenario Cards", "Step 1") | title | (action)
 *
 * The list is a grid and each row uses subgrid, so the pill and title columns
 * line up across all rows. The layout responds to the width of the list itself
 * (container query), not the viewport: the part cards sit next to a "Part N"
 * column on wider screens, so the viewport alone doesn't say how much room the
 * rows have. When narrow, the number stays on the left and the rest stacks.
 *
 * Optional action column: pass a function as the child. It is called once per
 * row with the row index and its markup is rendered in the last column. The
 * markup belongs to the calling page, so the page's own (scoped) styles apply
 * to it — e.g. the download buttons:
 *
 *   <ModuleRowList accent="var(--brand-MW)" rows={rows}>
 *     {(i: number) => <a class="mw-item-download" href={…}>…</a>}
 *   </ModuleRowList>
 */

interface Row {
  /** Short identifier in the first column, e.g. "1.2.1" or "01". */
  num: string
  /** Type label shown as a pill, e.g. "Worksheet" or "Step 1". */
  label: string
  title: string
}

interface Props {
  rows: ReadonlyArray<Row>
  /** Module brand colour, e.g. "var(--brand-MW)". */
  accent: string
}

const { rows, accent } = Astro.props
const hasAction = Astro.slots.has('default')
const actions = hasAction
  ? await Promise.all(rows.map((_, i) => Astro.slots.render('default', [i])))
  : []
---

<div class="rows" style={`--row-accent: ${accent}`}>
  <ul class:list={['row-list', { 'row-list--action': hasAction }]}>
    {rows.map((row, i) => (
      <li class="row">
        <span class="row__num">{row.num}</span>
        <span class="row__pill">{row.label}</span>
        <p class="row__title">{row.title}</p>
        {hasAction ? <div class="row__action"><Fragment set:html={actions[i]} /></div> : null}
      </li>
    ))}
  </ul>
</div>

<style>
  .rows {
    container: row-list / inline-size;
  }

  .row-list {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr);
    column-gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row-list--action {
    grid-template-columns: max-content max-content minmax(0, 1fr) auto;
  }

  .row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    padding: var(--space-s) 0;
    border-bottom: 1px solid color-mix(in oklab, var(--row-accent), white 80%);
  }

  .row:last-child {
    border-bottom: none;
  }

  .row__num {
    font-size: var(--font-size-0);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    color: color-mix(in oklab, var(--row-accent), black 15%);
  }

  .row__pill {
    justify-self: start;
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
    background: color-mix(in oklab, var(--row-accent), white 85%);
    color: color-mix(in oklab, var(--row-accent), black 40%);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  .row__title {
    margin: 0;
    font-size: var(--font-size-0);
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-neutral-900);
    /* Long words (German compounds, file names) must never spill into the
       action column. <html lang> is set per locale, so hyphenation works. */
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .row__action {
    justify-self: end;
  }

  @media (max-width: 480px) {
    .row__title {
      font-size: 0.9rem;
    }
  }

  /* Narrow list: number on the left, pill / title / action stacked. */
  @container row-list (max-width: 36rem) {
    .row-list {
      display: block;
    }

    .row {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      column-gap: var(--space-s);
      row-gap: var(--space-2xs);
      align-items: start;
    }

    .row-list:not(.row-list--action) .row {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .row__num {
      grid-row: 1 / span 2;
      padding-top: 0.2rem;
    }

    .row-list--action .row__num {
      grid-row: 1 / span 3;
    }

    .row__pill,
    .row__title,
    .row__action {
      grid-column: 2;
      justify-self: start;
    }

    .row__pill {
      white-space: normal;
    }
  }

  :global(html.darkmode) .row {
    border-bottom-color: color-mix(in oklab, var(--row-accent) 18%, var(--dm-border-sub));
  }

  :global(html.darkmode) .row__num {
    color: color-mix(in oklab, var(--row-accent), white 25%);
  }

  :global(html.darkmode) .row__pill {
    background: color-mix(in oklab, var(--row-accent) 22%, var(--dm-surface-3));
    /* ≥ 5:1 on the pill background for every module colour (WCAG AA needs 4.5:1). */
    color: color-mix(in oklab, var(--row-accent), white 65%);
  }

  :global(html.darkmode) .row__title {
    color: var(--dm-fg);
  }
</style>
