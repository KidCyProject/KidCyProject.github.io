---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import GameSupport from '@components/GameSupport.astro'
import type { ModuleId } from 'src/data/modules'
import { robloxPlayUrl } from 'src/data/games'
import { useTranslations } from 'src/i18n/index'

/**
 * ModuleGamePage
 *
 * The Roblox game page of a learning module: instructions, tip, "Play" button
 * and the downloads / videos block (GameSupport). All module game pages share
 * this template; src/pages/learning-hub/<module>/game.astro only passes its id.
 *
 * Per-module differences come from data:
 * - texts:   pages.hub.games.<id>.*
 * - link:    ROBLOX_PLACE_IDS in src/data/games.ts
 * - colour:  --brand-<ID>, exposed to the styles below as --game-brand
 */
interface Props {
  moduleId: ModuleId
}

const { moduleId } = Astro.props
const { t } = useTranslations(Astro.currentLocale)
const brand = `var(--brand-${moduleId.toUpperCase()})`
const playUrl = robloxPlayUrl(moduleId)

if (!playUrl) {
  throw new Error(`No Roblox place id for module "${moduleId}" — add it to ROBLOX_PLACE_IDS in src/data/games.ts.`)
}
---

<DefaultLayout title={t(`pages.hub.games.${moduleId}.title`)} description={t(`pages.hub.games.${moduleId}.description`)}>
  <PageHeader
    title={t(`pages.hub.games.${moduleId}.title`)}
    subtitle={t(`pages.hub.games.${moduleId}.subtitle`)}
    underlineColor={brand}
    bgType="module"
  />
  <section class="my-12">
    <div class="container mb-12" style={`--game-brand: ${brand}`}>
      <div class="mb-10 flex flex-col gap-6">
        <h2 class="mb-2">{t('pages.hub.games.howItWorks')}</h2>
        <p>
          {t('pages.hub.games.gameInstructions')}
        </p>
        <div class="tip-card">
          <div class="tip-card__lead">
            <span class="tip-card__icon" aria-hidden="true">💬</span>
            <strong class="tip-card__label">{t('pages.hub.games.tipLabel')}</strong>
          </div>
          <div class="tip-card__body">{t('pages.hub.games.tip')}</div>
        </div>
      </div>
      <div class="roblox-embed">
        <div class="game-frame" id="gameFrame">
          <img
            src="/images/learning-hub/roblox-background.webp"
            class="game-thumbnail"
            width="3024"
            height="1701"
            decoding="async"
            alt={t(`pages.hub.games.${moduleId}.altText`)}
          />

          <div class="play-overlay">
            <a href={playUrl} class="button" rel="noopener noreferrer" aria-label={t('pages.hub.aria.playAriaLabel')}>
              <span aria-hidden="true">▶</span> {t('pages.hub.games.playGame')}
            </a>
          </div>
        </div>
      </div>
      <GameSupport moduleId={moduleId} color={brand} />
    </div>
  </section>
</DefaultLayout>

<style>
  .roblox-embed {
    max-width: 100%;
    margin: auto;
    margin-top: 2rem;
    font-family: var(--font-body);
  }

  .tip-card {
    border-radius: 0.9rem;
    border: 1px solid color-mix(in oklab, var(--game-brand), white 50%);
    background: linear-gradient(135deg, color-mix(in oklab, var(--game-brand), white 88%), color-mix(in oklab, var(--game-brand), white 96%));
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--game-brand), black 40%);
  }

  .game-frame {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: 10px;
    overflow: hidden;
  }

  .game-thumbnail {
    width: 100%;
    height: auto;
    display: block;
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.3);
  }

  .button {
    /* Same size as the download buttons at the top of the module pages */
    font-size: 1.15rem;
    padding: 0.5rem 1rem;
    background: var(--game-brand);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
  }

  .button:hover {
    background: #fff;
    color: var(--game-brand);
    transition: all 0.5s ease;
  }
</style>
