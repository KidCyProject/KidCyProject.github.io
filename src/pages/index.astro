---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import { Icon } from 'astro-icon/components'
import { localizePath } from '../i18n/i18n'
import { useTranslations } from '../i18n/index'
import {
  modules,
  moduleCount,
  partCount,
  materialCount,
  videoCount,
  challengeCount,
  gameCount,
} from '../data/modules'
import { modulePartsData } from '../data/moduleParts'

const locale = Astro.currentLocale
const { t, tHtml, formatCount } = useTranslations(locale)

const hub = localizePath(locale, '/learning-hub/introduction/')
const about = localizePath(locale, '/about')

// Darker shade of each module colour so white numbers pass contrast on the badges.
const badgeColors: Record<string, string> = {
  dc: '#15803D',
  ap: '#6D3FC0',
  at: '#B45309',
  dp: '#0F766E',
  se: '#A21CAF',
  mw: '#4D7C0F',
  dm: '#B91C1C',
}

// Illustration files are numbered in module order: 01_digital-citizenship.webp … 07_digital-misuse.webp
const tiles = modules.map((m, i) => ({
  num: i + 1,
  title: t(`pages.hub.modules.${m.id}.title`),
  href: localizePath(locale, `/learning-hub/${m.slug}/content/`),
  color: m.color,
  badge: badgeColors[m.id],
  image: `/images/learning-hub/0${i + 1}_${m.slug}.webp`,
  meta: [
    formatCount(modulePartsData[m.id]?.length ?? 0, 'part'),
    formatCount(m.materials, 'material'),
    formatCount(m.videos, 'video'),
  ],
}))

const activityLinks = (kind: 'challenge' | 'game') =>
  modules
    .map((m, i) => ({ m, num: i + 1 }))
    .filter(({ m }) => (kind === 'challenge' ? m.challenges : m.games) > 0)
    .map(({ m, num }) => ({
      num,
      title: t(`pages.hub.modules.${m.id}.title`),
      badge: badgeColors[m.id],
      href: localizePath(locale, `/learning-hub/${m.slug}/${kind}/`),
    }))

const challengeLinks = activityLinks('challenge')
const gameLinks = activityLinks('game')

const stats = [
  { count: moduleCount, label: 'statModulesLabel' },
  { count: partCount, label: 'statPartsLabel' },
  { count: materialCount, label: 'statMaterialsLabel' },
  { count: videoCount, label: 'statVideosLabel' },
  { count: challengeCount, label: 'statChallengesLabel' },
  { count: gameCount, label: 'statGamesLabel' },
]

const insideItems = ['insideItem1', 'insideItem2', 'insideItem3', 'insideItem4']
const quickSteps = ['quickStep1', 'quickStep2', 'quickStep3', 'quickStep4']
const languages = ['English', 'Čeština', 'Deutsch', 'Lietuvių', 'Norsk']
---

<DefaultLayout title={t('pages.home.title')}>
  <Hero />

  <!-- The journey: seven module tiles -->
  <section class="home-section home-section--alt" id="learning-modules" aria-labelledby="journey-title">
    <div class="container">
      <p class="eyebrow">{t('pages.home.journeyEyebrow')}</p>
      <h2 class="section-title" id="journey-title">{t('pages.home.journeyTitle')}</h2>
      <p class="section-sub">{t('pages.home.journeySub')}</p>

      <details class="read-more">
        <summary>
          <span class="rm-closed">{t('pages.home.readMore')}</span>
          <span class="rm-open">{t('pages.home.readLess')}</span>
        </summary>
        <p>{t('pages.home.learningModulesText')}</p>
      </details>

      <ul class="tile-grid" role="list">
        {tiles.map((tile) => (
          <li>
            <a class="tile" href={tile.href} style={`--tile-color: ${tile.color}; --tile-badge: ${tile.badge}`}>
              <span class="tile__num" aria-hidden="true">{tile.num}</span>
              <img src={tile.image} alt="" width="140" height="140" loading="lazy" decoding="async" />
              <span class="tile__title">{tile.title}</span>
              <ul class="tile__meta" role="list">{tile.meta.map((item) => <li>{item}</li>)}</ul>
            </a>
          </li>
        ))}
        <li>
          <a class="tile tile--cta" href={hub}>
            <span>{t('pages.home.openHub')}</span>
            <Icon name="lucide:arrow-right" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- What is inside: stats + checklist -->
  <section class="home-section" aria-labelledby="inside-title">
    <div class="container">
      <p class="eyebrow">{t('pages.home.insideEyebrow')}</p>
      <h2 class="section-title" id="inside-title">{t('pages.home.insideTitle')}</h2>

      <div class="inside-grid">
        <div class="intro-stats">
          {stats.map((stat) => (
            <div class="stat-card">
              <span class="stat-number">{stat.count}</span>
              <span class="stat-title" set:html={tHtml(`pages.home.${stat.label}`)} />
            </div>
          ))}
        </div>

        <ul class="check-list" role="list">
          {insideItems.map((key) => (
            <li>
              <Icon name="lucide:circle-check" />
              <span set:html={tHtml(`pages.home.${key}`)} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Practise: challenges and games -->
  <section class="home-section home-section--alt" aria-labelledby="practise-title">
    <div class="container">
      <p class="eyebrow">{t('pages.home.practiseEyebrow')}</p>
      <h2 class="section-title" id="practise-title">{t('pages.home.practiseTitle')}</h2>

      <div class="practice-grid">
        <article class="practice-card">
          <img src="/images/index/challenges.webp" alt="" width="140" height="140" loading="lazy" decoding="async" />
          <h3 set:html={tHtml('pages.home.challengesTitle')} />
          <p>{t('pages.home.challengesShort')}</p>
          <div class="dot-links">
            <span>{t('pages.home.challengesPick')}</span>
            <ul role="list">
              {challengeLinks.map((link) => (
                <li>
                  <a class="dot" href={link.href} title={link.title} aria-label={link.title} style={`--dot: ${link.badge}`}>
                    {link.num}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <details class="read-more">
            <summary>
              <span class="rm-closed">{t('pages.home.readMore')}</span>
              <span class="rm-open">{t('pages.home.readLess')}</span>
            </summary>
            <p>{t('pages.home.challengesText')}</p>
          </details>
        </article>

        <article class="practice-card">
          <img src="/images/index/cybersecurity-games.webp" alt="" width="140" height="140" loading="lazy" decoding="async" />
          <h3 set:html={tHtml('pages.home.gamesTitle')} />
          <p>{t('pages.home.gamesShort')}</p>
          <div class="dot-links">
            <span>{t('pages.home.gamesPick')}</span>
            <ul role="list">
              {gameLinks.map((link) => (
                <li>
                  <a class="dot" href={link.href} title={link.title} aria-label={link.title} style={`--dot: ${link.badge}`}>
                    {link.num}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <details class="read-more">
            <summary>
              <span class="rm-closed">{t('pages.home.readMore')}</span>
              <span class="rm-open">{t('pages.home.readLess')}</span>
            </summary>
            <p>{t('pages.home.gamesText')}</p>
          </details>
        </article>
      </div>
    </div>
  </section>

  <!-- Quick start -->
  <section class="home-section" aria-labelledby="quick-title">
    <div class="container">
      <p class="eyebrow">{t('pages.home.quickEyebrow')}</p>
      <h2 class="section-title" id="quick-title">{t('pages.home.quickTitle')}</h2>

      <ol class="steps" role="list">
        {quickSteps.map((key, i) => (
          <li>
            <span class="steps__num" aria-hidden="true">{i + 1}</span>
            <span>{t(`pages.home.${key}`)}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Languages and mission -->
  <section class="home-section home-section--alt" aria-label={`${t('pages.home.languagesTitle')}, ${t('pages.home.missionTitle')}`}>
    <div class="container two-col">
      <div>
        <p class="eyebrow">{t('pages.home.languagesEyebrow')}</p>
        <h2 class="section-title">{t('pages.home.languagesTitle')}</h2>
        <ul class="chips" role="list">
          {languages.map((language) => <li>{language}</li>)}
        </ul>
        <p class="section-sub">{t('pages.home.languagesText')}</p>
      </div>
      <div>
        <p class="eyebrow">{t('pages.home.missionEyebrow')}</p>
        <h2 class="section-title">{t('pages.home.missionTitle')}</h2>
        <p class="section-sub">{t('pages.home.missionText')}</p>
      </div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="home-section final-cta" aria-label={t('pages.home.aboutInitiative')}>
    <div class="container">
      <p class="eu-note">{t('pages.about.cofundEUDesc')}</p>
      <div class="cta-row">
        <a class="button has-icon" href={hub}>
          <Icon name="lucide:graduation-cap" />
          {t('layout.hero.explore')}
        </a>
        <a class="button has-icon is-outline" href={about}>
          <Icon name="lucide:lightbulb" />
          {t('pages.home.aboutInitiative')}
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .home-section {
    padding-block: 3.5rem;
  }

  /* Same soft fade as the page headers (see .bg-module in PageHeader.astro) */
  .home-section--alt {
    background: linear-gradient(155deg, color-mix(in oklab, #2563eb 10%, #ffffff) 20%, var(--background-color) 60%);
    border-block: 1px solid color-mix(in oklab, #2563eb 40%, #ffffff);
  }

  :global(html.darkmode) .home-section--alt {
    background: linear-gradient(155deg, color-mix(in oklab, #2563eb 22%, var(--dm-surface-2)) 0%, var(--dm-surface-1) 65%);
    border-color: color-mix(in oklab, #2563eb 40%, var(--dm-border-sub));
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--link-color);
    margin-bottom: 0.35rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem);
    font-weight: 900;
    line-height: 1.15;
    text-decoration: underline;
    text-decoration-color: #2563eb;
    margin-bottom: 0.75rem;
  }

  .section-sub {
    font-size: 1.125rem;
    color: light-dark(#475569, var(--dm-fg-muted));
    margin-bottom: 1rem;
  }

  /* ── Read more (native <details>) ─────────────────────────────────────── */
  .read-more {
    margin-bottom: 1.5rem;
  }

  .read-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    font-weight: 700;
    color: var(--link-color);
    list-style: none;
  }

  .read-more summary::-webkit-details-marker {
    display: none;
  }

  .read-more summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease;
  }

  .read-more[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }

  .read-more:not([open]) .rm-open,
  .read-more[open] .rm-closed {
    display: none;
  }

  .read-more p {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
  }

  /* ── Module tiles ─────────────────────────────────────────────────────── */
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 1024px) {
    .tile-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .tile-grid > li {
    display: flex;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem 0.75rem 1.1rem;
    text-align: center;
    color: inherit;
    text-decoration: none;
    background: light-dark(#ffffff, var(--dm-surface-2));
    border: 1px solid light-dark(#dbe2ea, var(--dm-border-sub));
    border-top: 4px solid var(--tile-color);
    border-radius: 1rem;
    box-shadow: var(--elevation-1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tile:hover,
  .tile:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--elevation-3);
  }

  .tile img {
    width: min(100%, 140px);
    height: auto;
    aspect-ratio: 1;
  }

  .tile__num {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: var(--tile-badge);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .tile__title {
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-weight: 800;
    line-height: 1.2;
  }

  .tile__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.1rem 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    color: light-dark(#475569, var(--dm-fg-muted));
  }

  .tile--cta {
    justify-content: center;
    gap: 0.5rem;
    min-height: 12rem;
    font-size: 1.125rem;
    font-weight: 800;
    color: #ffffff;
    background: #2563eb;
    border-color: #2563eb;
  }

  :global(html.darkmode) .tile--cta {
    background: var(--dm-primary-dim);
    border-color: var(--dm-primary-dim);
  }

  /* ── What is inside ───────────────────────────────────────────────────── */
  .inside-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .inside-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 3rem;
    }
  }

  .intro-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .intro-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  :global(.stat-card) {
    border: 1px solid #dbe2ea;
    border-radius: 1rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 100%;
    text-align: center;
    box-shadow: var(--elevation-1);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .stat-card:hover,
  .stat-card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--elevation-3);
    border-color: #2563eb;
  }

  .stat-number {
    display: block;
    font-size: clamp(2.5rem, 2rem + 1.5vw, 3.5rem);
    line-height: 1;
    font-weight: 900;
    color: var(--link-color);
  }

  .stat-title {
    display: block;
    white-space: pre-line;
    overflow-wrap: anywhere;
    hyphens: auto;
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.25rem);
    line-height: 1.2;
    font-weight: 800;
    color: var(--text-decoration-color);
  }

  .check-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .check-list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 1.125rem;
  }

  .check-list :global(svg) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    color: var(--link-color);
  }

  /* ── Practise ─────────────────────────────────────────────────────────── */
  .practice-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .practice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .practice-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: light-dark(#ffffff, var(--dm-surface-2));
    border: 1px solid light-dark(#dbe2ea, var(--dm-border-sub));
    border-radius: 1rem;
    box-shadow: var(--elevation-1);
  }

  .practice-card img {
    width: 140px;
    height: auto;
    aspect-ratio: 1;
    align-self: center;
  }

  .practice-card h3 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
    font-weight: 900;
    line-height: 1.15;
  }

  .practice-card p {
    font-size: 1.0625rem;
  }

  .dot-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-block: 0.5rem 0.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .dot-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: var(--dot);
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .dot:hover,
  .dot:focus-visible {
    transform: scale(1.12);
  }

  .practice-card .read-more {
    margin-bottom: 0;
  }

  /* ── Quick start ──────────────────────────────────────────────────────── */
  .steps {
    display: grid;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .steps li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    font-size: 1.125rem;
  }

  .steps__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: #2563eb;
    color: #ffffff;
    font-weight: 800;
  }

  :global(html.darkmode) .steps__num {
    background: var(--dm-primary-dim);
  }

  /* ── Languages and mission ────────────────────────────────────────────── */
  .two-col {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .two-col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .chips li {
    padding: 0.2rem 0.8rem;
    border-radius: 9999px;
    font-weight: 700;
    background: rgba(37, 99, 235, 0.1);
    color: light-dark(#1e3a8a, var(--dm-fg));
  }

  /* ── Closing call to action ───────────────────────────────────────────── */
  .final-cta {
    text-align: center;
  }

  .eu-note {
    font-size: 1.0625rem;
    color: light-dark(#475569, var(--dm-fg-muted));
    margin-bottom: 1.25rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .button {
    border-radius: 10px;
    color: var(--button-text-color);
  }

  .button.is-outline {
    color: var(--link-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .stat-card,
    .dot,
    .read-more summary::after {
      transition: none;
    }
  }
</style>
