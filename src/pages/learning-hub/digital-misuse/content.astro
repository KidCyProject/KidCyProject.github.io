---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ModuleActivities from '@components/ModuleActivities.astro'
import { Icon } from 'astro-icon/components'
import { localizePath } from 'src/i18n/i18n'
import { getModule, introMaterials } from 'src/data/modules'
import type { ModuleId } from 'src/data/modules'
import { modulePartsData, mergeParts, MATERIAL_LANGUAGE_LABELS, languageDownloadName } from 'src/data/moduleParts'
import type { LanguagePackage, TranslationPart, TeachingGuide, RelatedModuleCard, MergedPart, MergedMaterial, MergedActivityStep, PartMeta } from 'src/data/moduleParts'
import { useTranslations } from 'src/i18n/index'

const locale = Astro.currentLocale
const { t, v } = useTranslations(locale)

const objectives = v<ReadonlyArray<string>>('contentDM.objectives') ?? []
const outcomes = v<ReadonlyArray<string>>('contentDM.outcomes') ?? []
const teachingGuide = v<TeachingGuide>('contentDM.teachingGuide') ?? {}
const currentModule = getModule('dm')!
// Language options for the page-header download dropdowns.
const headerLanguages = (pkg: LanguagePackage, base: string) =>
  pkg.languages.map((file) => ({
    lang: file.lang,
    label: MATERIAL_LANGUAGE_LABELS[file.lang],
    href: file.href,
    download: languageDownloadName(base, file),
  }))
// mergeParts combines structural asset data (file paths, video sources) from
// modulePartsData with the locale-specific text from contentDM.parts. The
// result is what the template consumes — neither source alone is sufficient.
const parts = mergeParts('dm', v<ReadonlyArray<TranslationPart>>('contentDM.parts') ?? [])

// Related module cards are authored in the translation file but their counts
// (parts, materials, videos, etc.) are overwritten here with live values from
// modulePartsData. This keeps cards accurate when a module gains new content
// without requiring editors to update every locale's translation file.
const relatedModuleCards = (v<ReadonlyArray<RelatedModuleCard>>('contentDM.relatedModuleCards') ?? []).map(card => { const mod = getModule(card.moduleId); if (!mod) return card; return { ...card, parts: modulePartsData[mod.id].length, materials: mod.materials, videos: mod.videos, challenges: mod.challenges, games: mod.games } })

const hasCount = (value: unknown): value is number => typeof value === 'number' && value > 0

const formatCount = (count: number, singularKey: string, pluralKey: string) =>
  `${count} ${t(count === 1 ? singularKey : pluralKey)}`

const getPartTitle = (part: MergedPart) => part.titleKey ? t(part.titleKey) : ''

const moduleImages = {
  dc: '/images/learning-hub/01_digital-citizenship.webp',
  ap: '/images/learning-hub/02_attacker-perspective.webp',
  at: '/images/learning-hub/03_authentication.webp',
  dp: '/images/learning-hub/04_data-privacy.webp',
  se: '/images/learning-hub/05_social-engineering.webp',
  mw: '/images/learning-hub/06_malware.webp',
  dm: '/images/learning-hub/07_digital-misuse.webp',
}
---

<DefaultLayout title={t('pages.hub.modules.dm.title')}>
  <PageHeader
      title={t('pages.hub.modules.dm.title')}
      subtitle={t('pages.hub.modules.dm.description')}
      underlineColor="var(--brand-DM)"
      bgType="module"
      buttons={[
        {
          text: t('pages.hub.contentPage.downloadIntro'),
          href: introMaterials.languages[0].href,
          variant: 'primary',
          icon: 'lucide:download',
          languages: headerLanguages(introMaterials, t('pages.hub.contentPage.introPackage')),
        },
        {
          text: t('pages.hub.contentPage.downloadAll'),
          href: currentModule.materialsPackage.languages[0].href,
          variant: 'primary',
          icon: 'lucide:download',
          languages: headerLanguages(currentModule.materialsPackage, 'Digital Misuse Material Package'),
        },
      ]}
      />

  <!-- Main Content Area -->
  <section class="my-12">
    <div class="container dm-theme">

      <!-- Learning Overview: Aim / Objectives / Outcomes tabs -->
      <div class="aoo-card">
        <div class="dm-tabs">
          <div class="dm-tabs__bar" role="tablist">
            <button class="dm-tab" role="tab" aria-selected="true" data-panel="aoo-aim">
              <img class="dm-tab-img-icon" src="/images/learning-hub/aim.webp" alt="" aria-hidden="true" />
              {t('pages.hub.contentPage.aimTitle')}
            </button>
            <button class="dm-tab" role="tab" aria-selected="false" data-panel="aoo-objectives">
              <img class="dm-tab-img-icon" src="/images/learning-hub/objectives.webp" alt="" aria-hidden="true" />
              {t('pages.hub.contentPage.objectivesTitle')}
              <span class="dm-tab__badge">{objectives.length}</span>
            </button>
            <button class="dm-tab" role="tab" aria-selected="false" data-panel="aoo-outcomes">
              <img class="dm-tab-img-icon" src="/images/learning-hub/outcomes.webp" alt="" aria-hidden="true" />
              {t('pages.hub.contentPage.outcomesTitle')}
              <span class="dm-tab__badge">{outcomes.length}</span>
            </button>
          </div>

          <div class="dm-tab-panel" role="tabpanel" id="aoo-aim">
            <div class="dm-aim-content">
              <p class="dm-aim-text">{t('contentDM.aim')}</p>
            </div>
          </div>

          <div class="dm-tab-panel" role="tabpanel" id="aoo-objectives" hidden>
            <ul class="dm-step-list">
              {objectives.map((obj, i) => (
                <li class="dm-step-item dm-step-item--plain">
                  <span class="dm-step-num">{String(i + 1).padStart(2, '0')}</span>
                  <p class="dm-step-title">{obj}</p>
                </li>
              ))}
            </ul>
          </div>

          <div class="dm-tab-panel" role="tabpanel" id="aoo-outcomes" hidden>
            <ul class="dm-step-list">
              {outcomes.map((outcome, i) => (
                <li class="dm-step-item dm-step-item--plain">
                  <span class="dm-step-num">{String(i + 1).padStart(2, '0')}</span>
                  <p class="dm-step-title">{outcome}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Section Divider -->
      <div class="dm-divider dm-divider--center" style="margin-top: var(--space-xl);">{t('pages.hub.contentPage.dividerContent')}</div>

      <!-- Module Content -->
      <div class="dm-section" id="module-content">
        <div class="dm-section__header">
          <h2>{t('pages.hub.contentPage.moduleContent')}</h2>
          <p class="dm-section__subtitle">{t('pages.hub.contentPage.moduleContentSubtitle')}</p>
        </div>
        <div class="dm-module-list">
          <div class="dm-module-row">
            <a class="dm-part-button" href="#teaching-guide">{t('pages.hub.labels.guide')}</a>
            <div class="dm-teaching-guide" id="teaching-guide">
              <div class="dm-package-banner__copy">
                <h3>{t('pages.hub.contentPage.guideTitle')}</h3>
                <p class="dm-package-banner__sub">{t('pages.hub.contentPage.guideDescription')}</p>
              </div>
              <div class="dm-package-btn-wrap">
                <button
                  type="button"
                  class="button has-icon dm-package-btn dm-download-trigger"
                  aria-expanded="false"
                  aria-controls="teaching-guide-download"
                  aria-label={String(teachingGuide.ariaLabel || t('pages.hub.contentPage.downloadGuide'))}
                  data-download-trigger
                >
                  <Icon name="lucide:download" />
                  <span>{t('pages.hub.contentPage.downloadGuide')}</span>
                  <Icon name="lucide:chevron-down" />
                </button>
                <ul
                  class="dm-download-menu"
                  id="teaching-guide-download"
                  aria-label={String(teachingGuide.ariaLabel || t('pages.hub.contentPage.downloadGuide'))}
                  data-download-menu
                  hidden
                >
                  {(currentModule.teachingGuide.languages ?? []).map((file) => (
                    <li>
                      <a
                        class="dm-download-option"
                        href={file.href}
                        download={languageDownloadName(teachingGuide.download || t('pages.hub.contentPage.guideTitle'), file)}
                        hreflang={file.lang}
                      >
                        <span class="dm-download-code" aria-hidden="true">{file.lang.toUpperCase()}</span>
                        <span lang={file.lang}>{MATERIAL_LANGUAGE_LABELS[file.lang]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          {parts.map((part) => {
            const meta: PartMeta = part.meta ?? { steps: 0, materials: 0, videos: 0 }
            const included = part.included ?? {}
            const partMaterials = included.materials ?? []
            const partActivity = included.activityPlan ?? []
            const featuredVideo = part.featuredVideo
            const title = getPartTitle(part)
            // Activity plan opens first when present — it is the primary teaching
            // sequence. Materials are secondary. Video is the fallback tab.
            const firstPanel = partActivity.length ? 'activity' : partMaterials.length ? 'materials' : 'video'

            return (
              <div class="dm-module-row">
                <a class="dm-part-button" href={`#${part.anchorId}`}>{t('pages.hub.labels.part')} {part.number}</a>
                <details class="dm-module" id={part.anchorId}>
                  <summary class="dm-module__header">
                    <div class="dm-module__copy">
                      <h3>{title}</h3>
                      <div class="dm-module__meta">
                        {hasCount(meta.steps) ? (
                          <span class="dm-meta-item"><Icon name="lucide:list-checks" /> {formatCount(meta.steps, 'pages.hub.labels.step', 'pages.hub.labels.steps')}</span>
                        ) : null}
                        {hasCount(meta.materials) ? (
                          <span class="dm-meta-item"><Icon name="lucide:file-text" /> {formatCount(meta.materials, 'pages.hub.labels.material', 'pages.hub.labels.materials')}</span>
                        ) : null}
                        {hasCount(meta.videos) ? (
                          <span class="dm-meta-item"><Icon name="lucide:play-circle" /> {formatCount(meta.videos, 'pages.hub.labels.video', 'pages.hub.labels.videos')}</span>
                        ) : null}
                      </div>
                      <p class="dm-goal"><b>{t('pages.hub.labels.goal')}</b> {String(part.goal ?? '')}</p>
                    </div>
                    <span class="dm-module__toggle" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M8 5l8 7-8 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </summary>
                  <div class="dm-module__content">
                    <div class="dm-package-banner">
                      <div class="dm-package-banner__copy">
                        <p class="dm-package-banner__title">{t('pages.hub.contentPage.materialPackage')}</p>
                        <p class="dm-package-banner__sub">{t('pages.hub.contentPage.materialPackageSub')}</p>
                      </div>
                      <div class="dm-package-btn-wrap">
                        <button
                          type="button"
                          class="button has-icon dm-package-btn dm-download-trigger"
                          aria-expanded="false"
                          aria-controls={`package-${part.anchorId}`}
                          aria-label={`${t('pages.hub.contentPage.downloadPackage')}: ${title}`}
                          data-download-trigger
                        >
                          <Icon name="lucide:download" />
                          <span>{t('pages.hub.contentPage.downloadPackage')}</span>
                          <Icon name="lucide:chevron-down" />
                        </button>
                        <ul
                          class="dm-download-menu"
                          id={`package-${part.anchorId}`}
                          aria-label={`${t('pages.hub.contentPage.downloadPackage')}: ${title}`}
                          data-download-menu
                          hidden
                        >
                          {(part.bundle?.languages ?? []).map((file) => (
                            <li>
                              <a
                                class="dm-download-option"
                                href={file.href}
                                download={languageDownloadName(part.bundle?.filename, file)}
                                hreflang={file.lang}
                              >
                                <span class="dm-download-code" aria-hidden="true">{file.lang.toUpperCase()}</span>
                                <span lang={file.lang}>{MATERIAL_LANGUAGE_LABELS[file.lang]}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    {(partMaterials.length || partActivity.length || featuredVideo) ? (
                      <div class="dm-tabs">
                        <div class="dm-tabs__bar" role="tablist">
                          {partActivity.length ? (
                            <button
                              class="dm-tab"
                              role="tab"
                              aria-selected={firstPanel === 'activity' ? 'true' : 'false'}
                              data-panel={`activity-${part.anchorId}`}
                            >
                              <Icon name="lucide:list" />
                              {t('pages.hub.labels.activityPlan')}
                              <span class="dm-tab__badge">{partActivity.length}</span>
                            </button>
                          ) : null}
                          {partMaterials.length ? (
                            <button
                              class="dm-tab"
                              role="tab"
                              aria-selected={firstPanel === 'materials' ? 'true' : 'false'}
                              data-panel={`materials-${part.anchorId}`}
                            >
                              <Icon name="lucide:file-text" />
                              {t('pages.hub.labels.materials')}
                              <span class="dm-tab__badge">{partMaterials.length}</span>
                            </button>
                          ) : null}
                          {featuredVideo ? (
                            <button
                              class="dm-tab"
                              role="tab"
                              aria-selected={firstPanel === 'video' ? 'true' : 'false'}
                              data-panel={`video-${part.anchorId}`}
                            >
                              <Icon name="lucide:video" />
                              {t('pages.hub.labels.videos')}
                              <span class="dm-tab__badge">1</span>
                            </button>
                          ) : null}
                        </div>

                        {partMaterials.length ? (
                          <div
                            class="dm-tab-panel"
                            role="tabpanel"
                            id={`materials-${part.anchorId}`}
                            hidden={firstPanel !== 'materials'}
                          >
                            <ul class="dm-step-list">
                              {partMaterials.map((item: MergedMaterial, i: number) => (
                                <li class="dm-step-item dm-step-item--material">
                                  <span class="dm-step-num dm-material-id">{item.id ?? String(i + 1).padStart(2, '0')}</span>
                                  <p class="dm-step-title"><b>{String(item.kind ?? '')} –</b> {String(item.name ?? '')}</p>
                                  {item.languages?.length ? (
                                    <div class="dm-material-download">
                                      <button
                                        type="button"
                                        class="dm-item-download dm-download-trigger"
                                        aria-expanded="false"
                                        aria-controls={`material-${part.anchorId}-${i}`}
                                        aria-label={`${t('pages.hub.contentPage.download')}: ${String(item.kind ?? '')} – ${String(item.name ?? '')}`}
                                        data-download-trigger
                                      >
                                        <Icon name="lucide:download" />
                                        <span>{t('pages.hub.contentPage.download')}</span>
                                        <Icon name="lucide:chevron-down" />
                                      </button>
                                      <ul
                                        class="dm-download-menu"
                                        id={`material-${part.anchorId}-${i}`}
                                        aria-label={String(item.ariaLabel ?? t('pages.hub.contentPage.download'))}
                                        data-download-menu
                                        hidden
                                      >
                                        {item.languages.map((file) => (
                                          <li>
                                            <a
                                              class="dm-download-option"
                                              href={file.href}
                                              download={item.filename ? `${item.filename} (${file.lang.toUpperCase()}).${file.href.split('.').pop()}` : file.href.split('/').pop()}
                                              hreflang={file.lang}
                                            >
                                              <span class="dm-download-code" aria-hidden="true">{file.lang.toUpperCase()}</span>
                                              <span lang={file.lang}>{MATERIAL_LANGUAGE_LABELS[file.lang]}</span>
                                            </a>
                                          </li>
                                        ))}
                                      </ul>
                                    </div>
                                  ) : (
                                    <a
                                      class="dm-item-download"
                                      href={String(item.href ?? '')}
                                      download={String(item.filename ?? '')}
                                      aria-label={String(item.ariaLabel ?? '')}
                                    >
                                      <Icon name="lucide:download" />
                                      <span>{t('pages.hub.contentPage.download')}</span>
                                    </a>
                                  )}
                                </li>
                              ))}
                            </ul>
                          </div>
                        ) : null}

                        {partActivity.length ? (
                          <div
                            class="dm-tab-panel"
                            role="tabpanel"
                            id={`activity-${part.anchorId}`}
                            hidden={firstPanel !== 'activity'}
                          >
                            <ul class="dm-step-list">
                              {partActivity.map((step: MergedActivityStep) => (
                                <li class="dm-step-item dm-step-item--plain">
                                  <span class="dm-step-num">{String(step.stepNumber ?? 0).padStart(2, '0')}</span>
                                  <p class="dm-step-title"><b>{t('pages.hub.labels.step')} {String(step.stepNumber ?? '')} –</b> {String(step.title ?? '')}</p>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ) : null}

                        {featuredVideo ? (
                          <div
                            class="dm-tab-panel"
                            role="tabpanel"
                            id={`video-${part.anchorId}`}
                            hidden={firstPanel !== 'video'}
                          >
                            <div class="dm-video-preview">
                              <div class="dm-video-preview__thumb">
                                <video
                                  controls
                                  preload="metadata"
                                  poster={String(featuredVideo.posterSrc ?? '')}
                                >
                                  <source src={String(featuredVideo.videoSrc ?? '')} />
                                  {(featuredVideo.tracks ?? []).map((track) => (
                                    <track
                                      label={String(track.label ?? '')}
                                      kind="subtitles"
                                      srclang={String(track.srclang ?? '')}
                                      src={String(track.src ?? '')}
                                    />
                                  ))}
                                </video>
                              </div>
                              <div class="dm-video-preview__info">
                                <h4 class="dm-video-preview__title">{String(featuredVideo.title ?? '')}</h4>
                                <p class="dm-video-preview__desc">{String(featuredVideo.supportText ?? '')}</p>
                                <div class="dm-video-preview__actions">
                                  <div class="dm-video-action-wrap">
                                    <a
                                      class="dm-item-download"
                                      href={String(featuredVideo.downloads?.video?.href ?? '')}
                                      download={String(featuredVideo.downloads?.video?.filename ?? '')}
                                      aria-label={String(featuredVideo.downloads?.video?.ariaLabel ?? '')}
                                    >
                                      <Icon name="lucide:download" />
                                      <span>{t('pages.hub.labels.video')}</span>
                                    </a>
                                  </div>
                                  <div class="dm-video-action-wrap">
                                    <button
                                      type="button"
                                      class="dm-item-download dm-download-trigger"
                                      aria-expanded="false"
                                      aria-controls={`subtitles-${part.anchorId}`}
                                      data-download-trigger
                                    >
                                      <Icon name="lucide:captions" />
                                      <span>{t('pages.hub.labels.subtitles')}</span>
                                      <Icon name="lucide:chevron-down" />
                                    </button>
                                    <ul
                                      class="dm-download-menu"
                                      id={`subtitles-${part.anchorId}`}
                                      aria-label={String(featuredVideo.downloads?.subtitles?.ariaLabel ?? t('pages.hub.labels.subtitles'))}
                                      data-download-menu
                                      hidden
                                    >
                                      {(featuredVideo.tracks ?? []).map((track) => (
                                        <li>
                                          <a
                                            class="dm-download-option"
                                            href={String(track.src ?? '')}
                                            download={String(track.src ?? '').split('/').pop()}
                                            hreflang={String(track.srclang ?? '')}
                                          >
                                            <span class="dm-download-code" aria-hidden="true">{String(track.srclang ?? '').toUpperCase()}</span>
                                            <span lang={String(track.srclang ?? '')}>{String(track.label ?? '')}</span>
                                          </a>
                                        </li>
                                      ))}
                                    </ul>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        ) : null}
                      </div>
                    ) : null}
                  </div>
                </details>
              </div>
            )
          })}
        </div>
      </div>

      <!-- Section Divider -->
      <div class="dm-divider dm-divider--center">{t('pages.hub.contentPage.dividerActivities')}</div>

      <!-- Additional Activities: challenge + game (same cards as the Learning Hub introduction) -->
      <section id="additional-activities" aria-labelledby="additional-activities-heading">
        <h2 id="additional-activities-heading" class="sr-only">{t('pages.hub.contentPage.dividerActivities')}</h2>
        <ModuleActivities moduleId="dm" />
      </section>

      <!-- Section Divider -->
      <div class="dm-divider dm-divider--center">{t('pages.hub.contentPage.dividerMore')}</div>

      <!-- Related Modules -->
      <div class="dm-section">
        <div class="dm-section__header">
          <h2>{t('pages.hub.contentPage.relatedModules')}</h2>
          <p class="dm-section__subtitle">{t('pages.hub.contentPage.relatedModulesSubtitle')}</p>
        </div>

        <div class="dm-rm-list">
          {relatedModuleCards.map((card, idx) => {
            const moduleId = String(card.moduleId ?? '')
            const title = t(`pages.hub.modules.${moduleId}.title`)
            const href = localizePath(locale, String(card.href ?? ''))
            const image = moduleImages[moduleId as keyof typeof moduleImages]
            const brandVar = `var(--brand-${String(card.brand ?? '')})`

            return (
              <a
                class={`dm-rm-row${idx === 0 ? ' dm-rm-row--first' : ''}`}
                href={href}
                style={`--rm-color: ${brandVar};`}
              >
                <div class="dm-rm-icon">
                  <img src={image} alt="" decoding="async" loading="eager" />
                </div>
                <div class="dm-rm-body">
                  <strong class="dm-rm-title">{title}</strong>
                  <span class="dm-rm-desc">{t(`pages.hub.modules.${moduleId}.description`)}</span>
                </div>
                <div class="dm-rm-meta" aria-label={title}>
                  {hasCount(card.parts) ? (
                    <span class="dm-rm-stat">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                      {card.parts}
                    </span>
                  ) : null}
                  {hasCount(card.materials) ? (
                    <span class="dm-rm-stat">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
                      {card.materials}
                    </span>
                  ) : null}
                  {hasCount(card.videos) ? (
                    <span class="dm-rm-stat">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                      {card.videos}
                    </span>
                  ) : null}
                  {hasCount(card.challenges) ? (
                    <span class="dm-rm-stat">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                      {card.challenges}
                    </span>
                  ) : null}
                  {hasCount(card.games) ? (
                    <span class="dm-rm-stat">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 12h4M8 10v4"/><circle cx="15" cy="11" r="0.8" fill="currentColor" stroke="none"/><circle cx="17" cy="13" r="0.8" fill="currentColor" stroke="none"/><path d="M2 9a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1c0 1-0.5 2-1 2.5L19 17a3 3 0 0 1-2.5 1.5h-9A3 3 0 0 1 5 17l-2-4.5C2.5 12 2 11 2 10V9z"/></svg>
