<script>
  import { initDownloadMenus } from '../../../utils/downloadMenu'

  // When a URL contains a hash that targets a <details> element (e.g. a direct
  // link to a module part like /content#digital-environments), open it and
  // scroll to it. requestAnimationFrame gives the browser one paint cycle to
  // render the newly open details before scrollIntoView fires — without it the
  // element may not yet have layout and scrolling lands in the wrong position.
  const expandFromHash = () => {
    const hash = window.location.hash.slice(1)
    if (!hash) return

    const target = document.getElementById(hash)
    if (target instanceof HTMLDetailsElement) {
      target.open = true
      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      })
    }
  }

  // astro:page-load fires on every view-transition navigation, so both handlers
  // must be re-registered here to stay active after client-side routing.
  document.addEventListener('astro:page-load', expandFromHash)
  expandFromHash()

  const initTabs = () => {
    document.querySelectorAll('.dm-tabs').forEach(tabs => {
      const bar = tabs.querySelector('.dm-tabs__bar')
      if (!bar) return
      bar.addEventListener('click', e => {
        const btn = (e.target as Element).closest('[role="tab"]') as HTMLElement | null
        if (!btn) return
        const targetId = btn.dataset.panel
        if (!targetId) return
        bar.querySelectorAll('[role="tab"]').forEach(t => {
          t.setAttribute('aria-selected', t === btn ? 'true' : 'false')
        })
        tabs.querySelectorAll('[role="tabpanel"]').forEach(p => {
          (p as HTMLElement).hidden = p.id !== targetId
        })
      })
    })
  }

  document.addEventListener('astro:page-load', initTabs)
  initTabs()

  document.addEventListener('astro:page-load', initDownloadMenus)
  initDownloadMenus()
</script>

