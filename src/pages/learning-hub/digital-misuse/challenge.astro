  <script>
    import { recordResult } from '../../../utils/challengeProgress'

    // ── Types ─────────────────────────────────────────────────────────────────
    interface Choice {
      text: string
      next: string
      points: number
    }

    interface StoryNode {
      text: string
      mood: string
      choices?: Choice[]
      ending?: true
      type?: 'good' | 'okay' | 'bad'
      stars?: number
      title?: string
      lesson?: string
    }

    interface Story {
      id: number
      sensitive?: true
      title: string
      emoji: string
      topic: string
      nodes: Record<string, StoryNode>
    }

    interface Labels {
      storyLabel: string
      watchOutTitle: string
      welcomeDesc: string
      startStory: string
      whatWeLearned: string
      tryDifferentPath: string
      nextStory: string
      seeFinalScore: string
      allStoriesComplete: string
      finalScoreDesc: string
      playAgain: string
      rankChampion: string
      rankChampionMsg: string
      rankDefender: string
      rankDefenderMsg: string
      rankNavigator: string
      rankNavigatorMsg: string
      rankBeginning: string
      rankBeginningMsg: string
      yourBestScore: string
      bestResultDesc: string
      badgeGood: string
      badgeOkay: string
      badgeBad: string
      topicLabel: string
      storyOfTemplate: string
      storyLabelTemplate: string
      pointsLabel: string
      sensitiveNoteTitle: string
      sensitiveNoteTemplate: string
      skipStory: string
      skippedLabel: string
      scoreDenomTemplate: string
    }

    // ── Load data ─────────────────────────────────────────────────────────────
    function initGame() {
      const dataEl = document.getElementById('dm-challenge-data')
      if (!dataEl) return
      const { stories, labels } = JSON.parse(dataEl.textContent ?? '{}') as { stories: Story[]; labels: Labels }

      // ── State ───────────────────────────────────────────────────────────────
      let currentStoryIdx  = 0
      let currentNodeId    = 'start'
      let sessionPoints    = 0
      let completedSet     = new Set<number>()
      let skippedSet       = new Set<number>()   // sensitive stories the player chose to skip: no stars, no penalty
      let bestStars        : Record<number, number> = {}
      // Sensitive stories stay out of the list until switched on (a per-viewer choice, remembered when the browser allows)
      const sensitiveKey   = 'kidcy-dm-sensitive'
      let sensitiveOn      = false
      try { sensitiveOn = localStorage.getItem(sensitiveKey) === '1' } catch { /* storage blocked: stay off */ }
      // Pending story-flow timer (choice → next node → choices/ending). Cancelled whenever the
      // story is reloaded or switched, otherwise a stale callback renders into the wrong story.
      let pendingTimer     : ReturnType<typeof setTimeout> | null = null

      const schedule = (fn: () => void, ms: number) => {
        if (pendingTimer !== null) clearTimeout(pendingTimer)
        pendingTimer = setTimeout(() => { pendingTimer = null; fn() }, ms)
      }
      const cancelPending = () => {
        if (pendingTimer !== null) clearTimeout(pendingTimer)
        pendingTimer = null
      }

      // ── DOM refs ────────────────────────────────────────────────────────────
      const getEl = (id: string) => document.getElementById(id) as HTMLElement

      // ── Helpers ─────────────────────────────────────────────────────────────
      const fmt = (template: string, vars: Record<string, string | number>) =>
        template.replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''))

      // The stories in play: every story, or all but the sensitive ones
      const visibleIdx     = () => stories.map((_s, i) => i).filter((i) => sensitiveOn || !stories[i].sensitive)
      const maxStars       = () => visibleIdx().filter((i) => !skippedSet.has(i)).length * 3
      const totalBestStars = () => visibleIdx().reduce((sum, i) => sum + (bestStars[i] ?? 0), 0)

      const moodEmoji: Record<string, string> = {
        neutral: '\u{1F4D6}', worried: '\u{1F61F}', sad: '\u{1F622}', supportive: '\u{1F4AA}',
        good: '\u{1F60A}', bad: '\u{1F61E}', okay: '\u{1F610}', danger: '\u26A0\uFE0F',
      }

      // ── Sidebar ─────────────────────────────────────────────────────────────
      function updateSidebar() {
        getEl('total-stars-display').textContent = String(totalBestStars())
        getEl('score-denom').textContent = fmt(labels.scoreDenomTemplate, { max: maxStars() })

        const container = getEl('story-rows')
        container.innerHTML = ''

        const visible = visibleIdx()
        visible.forEach((idx, pos) => {
          const story    = stories[idx]
          const isDone   = completedSet.has(idx)
          const isSkipped = skippedSet.has(idx)
          const isActive = idx === currentStoryIdx
          const before   = visible[pos - 1]
          const isLocked = pos > 0 && !completedSet.has(before) && !skippedSet.has(before) && !isActive

          const row = document.createElement('div')
          row.className = `s-row${isActive ? ' s-row-active' : ''}`
          if (!isLocked) {
            row.style.cursor = 'pointer'
            row.addEventListener('click', () => { if (idx !== currentStoryIdx) loadStory(idx, true) })
          }

          const dot = document.createElement('div')
          dot.className = `s-dot ${isDone ? 's-dot-done' : isActive ? 's-dot-active' : 's-dot-locked'}`

          const info = document.createElement('div')
          info.className = 's-row-info'

          const lbl = document.createElement('span')
          lbl.className = 's-row-label'
          lbl.textContent = fmt(labels.storyLabelTemplate, { n: pos + 1 }) + ' '

          const ttl = document.createElement('span')
          ttl.className = 's-row-title'
          ttl.textContent = story.title

          info.appendChild(lbl)
          info.appendChild(ttl)

          const starsEl = document.createElement('div')
          starsEl.className = 's-row-stars'
          if (isSkipped && !isDone) {
            starsEl.textContent = '\u23ED'
            starsEl.setAttribute('aria-label', labels.skippedLabel)
          } else if (isDone) {
            const s = bestStars[idx] ?? 0
            starsEl.textContent = '\u2605'.repeat(s) + '\u2606'.repeat(3 - s)
            starsEl.style.color = s === 3 ? '#f59e0b' : s >= 2 ? '#94a3b8' : '#d1d5db'
          } else {
            starsEl.textContent = isLocked ? '\u{1F512}' : (isActive ? '\u{1F4AC}' : '\u{1F513}')
          }

          row.appendChild(dot)
          row.appendChild(info)
          row.appendChild(starsEl)
          container.appendChild(row)
        })
      }

      // ── Load / reset a story ─────────────────────────────────────────────────
      function loadStory(idx: number, moveFocus = false) {
        cancelPending()
        currentStoryIdx = idx
        currentNodeId   = 'start'
        sessionPoints   = 0

        const story = stories[idx]
        const visible = visibleIdx()
        const position = visible.indexOf(idx) + 1

        getEl('story-emoji').textContent      = story.emoji
        getEl('story-number').textContent     = fmt(labels.storyOfTemplate, { n: position, total: visible.length })
        getEl('story-title-text').textContent = story.title
        getEl('session-pts').textContent      = '0'

        getEl('welcome-emoji').textContent  = story.emoji
        getEl('welcome-title').textContent  = `${fmt(labels.storyLabelTemplate, { n: position })} ${story.title}`
        getEl('welcome-topic').textContent  = `${labels.topicLabel}: ${story.topic}`
        getEl('welcome-desc').textContent   = labels.welcomeDesc
        getEl('start-btn').textContent      = labels.startStory

        // Content note for the sensitive stories
        const note = getEl('sensitive-note')
        note.classList.toggle('hidden', !story.sensitive)
        getEl('sensitive-note-title').textContent = labels.sensitiveNoteTitle
        getEl('sensitive-note-text').textContent  = fmt(labels.sensitiveNoteTemplate, { topic: story.topic })
        getEl('skip-btn').classList.toggle('hidden', !story.sensitive)
        getEl('skip-btn').textContent = labels.skipStory

        // Reset panel
        getEl('messages-area').innerHTML = ''
        getEl('messages-area').classList.add('hidden')
        getEl('choices-container').innerHTML = ''
        getEl('choices-container').classList.add('hidden')
        getEl('ending-card').classList.add('hidden')
        getEl('action-buttons').classList.add('hidden')
        getEl('welcome-state').classList.remove('hidden')

        updateSidebar()
        if (moveFocus) getEl('start-btn').focus()
      }

      // ── Start button \u2192 play first node ──────────────────────────────────────
      function startStory() {
        getEl('welcome-state').classList.add('hidden')
        getEl('messages-area').classList.remove('hidden')
        displayNode('start')
      }

      // ── Display a story node ─────────────────────────────────────────────────
      function displayNode(nodeId: string) {
        currentNodeId = nodeId
        const node = stories[currentStoryIdx].nodes[nodeId]
        if (!node) return

        addNarratorMsg(node.text, node.mood)

        schedule(() => {
          if (node.ending) {
            showEnding(node)
          } else if (node.choices) {
            showChoices(node.choices)
          }
        }, 500)
      }

      // ── Narrator message bubble ──────────────────────────────────────────────
      function addNarratorMsg(text: string, mood: string) {
        const area = getEl('messages-area')

        const bubble  = document.createElement('div')
        bubble.className = 'msg-bubble msg-narrator'

        const avatar  = document.createElement('div')
        avatar.className = 'msg-avatar-narrator'
        avatar.textContent = moodEmoji[mood] ?? '\u{1F4D6}'

        const content = document.createElement('div')
        content.className = 'msg-content'
        content.textContent = text

        bubble.appendChild(avatar)
        bubble.appendChild(content)
        area.appendChild(bubble)
        area.scrollTop = area.scrollHeight
      }

      // ── Player choice message bubble ─────────────────────────────────────────
      function addPlayerMsg(text: string) {
        const area = getEl('messages-area')

        const bubble  = document.createElement('div')
        bubble.className = 'msg-bubble msg-player'

        const avatar  = document.createElement('div')
        avatar.className = 'msg-avatar-player'
        avatar.textContent = '\u{1F464}'

        const content = document.createElement('div')
        content.className = 'msg-content'
        content.textContent = text

        bubble.appendChild(avatar)
        bubble.appendChild(content)
        area.appendChild(bubble)
        area.scrollTop = area.scrollHeight
      }

      // ── Show choices ─────────────────────────────────────────────────────────
      function showChoices(choices: Choice[]) {
        const container = getEl('choices-container')
        container.innerHTML = ''
        container.classList.remove('hidden')

        choices.forEach(choice => {
          const btn = document.createElement('button')
          btn.className = 'choice-btn'
          btn.textContent = choice.text
          btn.addEventListener('click', () => selectChoice(choice))
          container.appendChild(btn)
        })
        ;(container.querySelector('.choice-btn') as HTMLElement | null)?.focus({ preventScroll: true })
      }

      // ── Handle choice selection ──────────────────────────────────────────────
      function selectChoice(choice: Choice) {
        getEl('choices-container').innerHTML = ''
        getEl('choices-container').classList.add('hidden')

        sessionPoints += choice.points
        getEl('session-pts').textContent = String(sessionPoints)

        addPlayerMsg(choice.text)

        schedule(() => displayNode(choice.next), 600)
      }

      // ── Show ending card ─────────────────────────────────────────────────────
      function showEnding(node: StoryNode) {
        const stars   = node.stars  ?? 0
        const type    = node.type   ?? 'bad'
        const title   = node.title  ?? ''
        const lesson  = node.lesson ?? ''

        // Record best
        const prev = bestStars[currentStoryIdx] ?? -1
        if (stars > prev) bestStars[currentStoryIdx] = stars
        completedSet.add(currentStoryIdx)
        skippedSet.delete(currentStoryIdx)

        const badgeText  = { good: labels.badgeGood, okay: labels.badgeOkay, bad: labels.badgeBad }
        const cardClass  = { good: 'ending-card-good', okay: 'ending-card-okay', bad: 'ending-card-bad' }
        const badgeClass = { good: 'ending-badge ending-good', okay: 'ending-badge ending-okay', bad: 'ending-badge ending-bad' }

        const card = getEl('ending-card')
        card.className = `ending-card ${cardClass[type]}`

        const badge = getEl('ending-badge')
        badge.className = badgeClass[type]
        badge.textContent = badgeText[type]

        getEl('ending-title').textContent       = title
        getEl('ending-stars').textContent       = '\u2605'.repeat(stars) + '\u2606'.repeat(3 - stars)
        getEl('ending-lesson-text').textContent = lesson

        card.classList.remove('hidden')
        card.focus({ preventScroll: true })

        // Action buttons
        const actions  = getEl('action-buttons')
        const nextBtn  = getEl('next-story-btn')
        const doneBtn  = getEl('all-done-btn')
        const visible  = visibleIdx()
        const isLast   = currentStoryIdx === visible[visible.length - 1]

        getEl('retry-btn').textContent  = labels.tryDifferentPath
        nextBtn.textContent             = labels.nextStory
        doneBtn.textContent             = labels.seeFinalScore

        actions.classList.remove('hidden')
        nextBtn.style.display = isLast ? 'none' : 'inline-block'
        doneBtn.style.display = isLast ? 'inline-block' : 'none'

        updateSidebar()
      }

      // ── Final score overlay ──────────────────────────────────────────────────
      function showFinalScore() {
        const total = totalBestStars()
        const share = maxStars() ? total / maxStars() : 0
        recordResult('dm', total, maxStars())
        getEl('final-stars-count').textContent = String(total)
        getEl('final-denom').textContent = fmt(labels.scoreDenomTemplate, { max: maxStars() })

        let rank = '', msg = ''
        if      (share >= 0.9) { rank = labels.rankChampion;  msg = labels.rankChampionMsg  }
        else if (share >= 0.7) { rank = labels.rankDefender;  msg = labels.rankDefenderMsg  }
        else if (share >= 0.5) { rank = labels.rankNavigator; msg = labels.rankNavigatorMsg }
        else                   { rank = labels.rankBeginning; msg = labels.rankBeginningMsg }

        getEl('final-rank').textContent     = rank
        getEl('final-rank-msg').textContent = msg
        getEl('final-overlay').classList.remove('hidden')
        ;(getEl('dm-grid') as HTMLElement).inert = true   // keep keyboard and screen readers inside the dialog
        getEl('play-again-btn').focus()
      }

      // ── Init ─────────────────────────────────────────────────────────────────
      const guard = document.getElementById('story-rows')
      if (!guard || guard.dataset.initialized === 'true') return
      guard.dataset.initialized = 'true'

      loadStory(visibleIdx()[0])

      const toggle = getEl('sensitive-toggle') as HTMLInputElement
      toggle.checked = sensitiveOn
      toggle.addEventListener('change', () => {
        sensitiveOn = toggle.checked
        try { localStorage.setItem(sensitiveKey, sensitiveOn ? '1' : '0') } catch { /* storage blocked: keep it for this visit only */ }
        const visible = visibleIdx()
        if (visible.includes(currentStoryIdx)) {
          updateSidebar()
        } else {
          // The story on screen was just switched off: continue with the next one that is still in
          loadStory(visible.find((i) => i > currentStoryIdx) ?? visible[visible.length - 1])
        }
      })

      getEl('start-btn').addEventListener('click', startStory)
      getEl('skip-btn').addEventListener('click', () => {
        skippedSet.add(currentStoryIdx)
        const next = visibleIdx().find((i) => i > currentStoryIdx)
        if (next !== undefined) loadStory(next, true)
        else showFinalScore()
      })
      getEl('retry-btn').addEventListener('click', () => loadStory(currentStoryIdx, true))
      getEl('next-story-btn').addEventListener('click', () => {
        const next = visibleIdx().find((i) => i > currentStoryIdx)
        if (next !== undefined) loadStory(next, true)
      })
      getEl('all-done-btn').addEventListener('click', showFinalScore)
      // The final dialog has one control, so Tab simply stays on it
      getEl('final-overlay').addEventListener('keydown', (e) => {
        if (e.key === 'Tab') { e.preventDefault(); getEl('play-again-btn').focus() }
      })
      getEl('play-again-btn').addEventListener('click', () => {
        getEl('final-overlay').classList.add('hidden')
        ;(getEl('dm-grid') as HTMLElement).inert = false
        completedSet.clear()
        skippedSet.clear()
        bestStars = {}
        loadStory(visibleIdx()[0], true)
      })
    }

    document.addEventListener('astro:page-load', initGame)
    initGame()
  </script>
</DefaultLayout>
