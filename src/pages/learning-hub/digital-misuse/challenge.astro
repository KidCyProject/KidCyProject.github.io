// ── Merge translated text with structural data ─────────────────────────────
const rawStories = v<ReadonlyArray<Record<string, unknown>>>('challengeDM.stories') ?? []
const enStories  = vEn<ReadonlyArray<Record<string, unknown>>>('challengeDM.stories') ?? []

const stories: Story[] = storyStructure.map((struct, idx) => {
  const raw = (rawStories[idx] ?? {}) as Record<string, unknown>
  const fb  = (enStories[idx]  ?? {}) as Record<string, unknown>

  const rawNodes = (raw.nodes ?? fb.nodes ?? []) as Array<Record<string, unknown>>
  const nodeMap: Record<string, Record<string, unknown>> = {}
  rawNodes.forEach(n => { nodeMap[String(n.id ?? '')] = n })

  const nodes: Record<string, StoryNode> = {}
  Object.entries(struct.nodes).forEach(([nodeId, structNode]) => {
    const tn = nodeMap[nodeId] ?? {}
    const structChoices = structNode.choices ?? []
    const textChoices   = (tn.choices ?? []) as string[]

    const builtNode: StoryNode = {
      text: String(tn.text ?? ''),
      mood: structNode.mood,
    }
    if (structNode.ending)              builtNode.ending = true
    if (structNode.type)                builtNode.type   = structNode.type
    if (structNode.stars !== undefined) builtNode.stars  = structNode.stars
    if (tn.title)                       builtNode.title  = String(tn.title)
    if (tn.lesson)                      builtNode.lesson = String(tn.lesson)
    if (structChoices.length) {
      builtNode.choices = structChoices.map((c, i) => ({
        text:   String(textChoices[i] ?? ''),
        next:   c.next,
        points: c.points,
      }))
    }
    nodes[nodeId] = builtNode
  })

  return {
    id:    struct.id,
    ...(struct.sensitive ? { sensitive: true as const } : {}),
    title: String(raw.title ?? fb.title ?? ''),
    emoji: String(raw.emoji ?? fb.emoji ?? ''),
    topic: String(raw.topic ?? fb.topic ?? ''),
    nodes,
  }
})

// ── Labels from translations ───────────────────────────────────────────────
const labels = {
  storyLabel:       t('challengeDM.storiesTitle'),
  watchOutTitle:    t('challengeDM.watchOutTitle'),
  welcomeDesc:      t('challengeDM.welcomeDesc'),
  startStory:       t('challengeDM.startStory'),
  whatWeLearned:    t('challengeDM.whatWeLearned'),
  tryDifferentPath: t('challengeDM.tryDifferentPath'),
  nextStory:        t('challengeDM.nextStory'),
  seeFinalScore:    t('challengeDM.seeFinalScore'),
  allStoriesComplete: t('challengeDM.allStoriesComplete'),
  finalScoreDesc:   t('challengeDM.finalScoreDesc'),
  playAgain:        t('challengeDM.playAgain'),
  rankChampion:     t('challengeDM.rankChampion'),
  rankChampionMsg:  t('challengeDM.rankChampionMsg'),
  rankDefender:     t('challengeDM.rankDefender'),
  rankDefenderMsg:  t('challengeDM.rankDefenderMsg'),
  rankNavigator:    t('challengeDM.rankNavigator'),
  rankNavigatorMsg: t('challengeDM.rankNavigatorMsg'),
  rankBeginning:    t('challengeDM.rankBeginning'),
  rankBeginningMsg: t('challengeDM.rankBeginningMsg'),
  yourBestScore:    t('challengeDM.yourBestScore'),
  bestResultDesc:   t('challengeDM.bestResultDesc'),
  badgeGood:        t('challengeDM.badgeGood'),
  badgeOkay:        t('challengeDM.badgeOkay'),
  badgeBad:         t('challengeDM.badgeBad'),
  topicLabel:       t('challengeDM.topicLabel'),
  storyOfTemplate:  t('challengeDM.storyOfTemplate'),
  storyLabelTemplate: t('challengeDM.storyLabelTemplate'),
  pointsLabel:      t('challengeDM.pointsLabel'),
  sensitiveNoteTitle:    t('challengeDM.sensitiveNoteTitle'),
  sensitiveNoteTemplate: t('challengeDM.sensitiveNoteTemplate'),
  skipStory:             t('challengeDM.skipStory'),
  skippedLabel:          t('challengeDM.skippedLabel'),
  scoreDenomTemplate:    t('challengeDM.scoreDenomTemplate'),
}

// Server-side defaults for the first story, so no English placeholder flashes before the script runs
const fmt = (template: string, vars: Record<string, string | number>) =>
  template.replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''))

const watchOutItems = v<string[]>('challengeDM.watchOutItems') ?? vEn<string[]>('challengeDM.watchOutItems') ?? []
const firstVisibleStory = stories.find((story) => !story.sensitive) ?? stories[0]
---

<DefaultLayout title={t('challengeDM.title')}>
  <PageHeader
    title={t('challengeDM.title')}
    subtitle={t('challengeDM.subtitle')}
    bgType="module"
    underlineColor="var(--brand-DM)"
  />

  <ChallengeProgress />

  <script
    type="application/json"
    id="dm-challenge-data"
    set:html={toJsonScript({ stories, labels })}
  />

  <section class="my-12">
    <div class="container">

      <!-- How It Works -->
      <ChallengeIntro ns="challengeDM" brand="DM" />

      <!-- Two-column layout -->
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_300px]" id="dm-grid">

        <!-- ── Main: Story Area ─────────────────────────────────────────── -->
        <div>

          <!-- Story header bar -->
          <div class="story-header">
            <div class="story-header-left">
              <span class="story-emoji" id="story-emoji">📖</span>
              <div class="story-header-text">
                <span class="story-number" id="story-number">{fmt(labels.storyOfTemplate, { n: 1, total: stories.filter((story) => !story.sensitive).length })}</span>
                <span class="story-title-text" id="story-title-text">…</span>
              </div>
            </div>
            <div class="session-pts-box">
              <span class="pts-label" id="pts-label-el">{labels.pointsLabel}</span>
              <span class="pts-value" id="session-pts">0</span>
            </div>
          </div>

          <!-- Story panel -->
          <div class="story-panel">

            <!-- Welcome / between-story state -->
            <div id="welcome-state" class="welcome-state">
              <div class="welcome-icon" id="welcome-emoji">📱</div>
              <h3 class="welcome-title" id="welcome-title">{fmt(labels.storyLabelTemplate, { n: 1 })} {firstVisibleStory?.title}</h3>
              <p class="welcome-topic" id="welcome-topic">{labels.topicLabel}: {firstVisibleStory?.topic}</p>
              <p class="welcome-desc" id="welcome-desc">{labels.welcomeDesc}</p>
              <div class="sensitive-note hidden" id="sensitive-note">
                <strong id="sensitive-note-title">{labels.sensitiveNoteTitle}</strong>
                <p id="sensitive-note-text"></p>
              </div>
              <div class="welcome-buttons">
                <button class="btn btn-primary" id="start-btn">{labels.startStory}</button>
                <button class="btn btn-secondary hidden" id="skip-btn">{labels.skipStory}</button>
              </div>
            </div>

            <!-- Messages area -->
            <div id="messages-area" class="messages-area hidden" aria-live="polite" aria-label={t('challengeDM.messagesAriaLabel')}></div>

            <!-- Choices -->
            <div id="choices-container" class="choices-container hidden"></div>

            <!-- Ending card -->
            <div id="ending-card" class="ending-card hidden" tabindex="-1" role="group" aria-labelledby="ending-title">
              <div class="ending-badge" id="ending-badge">{labels.badgeGood}</div>
              <div class="ending-title" id="ending-title">…</div>
              <div class="ending-stars" id="ending-stars">★★★</div>
              <div class="ending-lesson">
                <strong>{labels.whatWeLearned}</strong>
                <p id="ending-lesson-text">…</p>
              </div>
            </div>

          </div><!-- .story-panel -->

          <!-- Action buttons (shown after ending) -->
          <div id="action-buttons" class="action-buttons hidden">
            <button class="btn btn-secondary" id="retry-btn">{labels.tryDifferentPath}</button>
            <button class="btn btn-primary" id="next-story-btn">{labels.nextStory}</button>
            <button class="btn btn-primary" id="all-done-btn" style="display:none">{labels.seeFinalScore}</button>
          </div>

          <!-- Where to find help (collapsed on phones) -->
          <HelpBox class="mt-6" />

        </div><!-- main column -->

        <!-- ── Sidebar ──────────────────────────────────────────────────── -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm h-fit">

          <!-- Total score -->
          <div class="mb-4">
            <h3 class="text-base font-bold text-slate-900">{labels.yourBestScore}</h3>
            <p class="mt-1 text-xs text-slate-600">{labels.bestResultDesc}</p>
          </div>
          <div class="score-display border-t border-slate-200 pt-4 mb-6">
            <span class="score-big" id="total-stars-display">0</span>
            <span class="score-denom" id="score-denom"></span>
          </div>

          <!-- Sensitive stories are off until a teacher or the player switches them on -->
          <div class="mb-6 border-t border-slate-200 pt-4">
            <label class="sensitive-toggle" for="sensitive-toggle">
              <input type="checkbox" id="sensitive-toggle" aria-describedby="sensitive-toggle-note" />
              <span class="text-sm font-semibold text-slate-900">{t('challengeDM.sensitiveToggleLabel')}</span>
            </label>
            <p id="sensitive-toggle-note" class="mt-1 text-xs text-slate-700">{t('challengeDM.sensitiveToggleNote')}</p>
          </div>

          <!-- Story progress -->
          <div class="mb-6 border-t border-slate-200 pt-4">
            <h3 class="text-sm font-bold text-slate-900 mb-3">{labels.storyLabel}</h3>
            <div id="story-rows" class="story-rows-list"></div>
          </div>

          <!-- Tips -->
          <div class="border-t border-slate-200 pt-4">
            <h3 class="text-sm font-bold text-slate-900 mb-3">{labels.watchOutTitle}</h3>
            <div class="space-y-2">
              {watchOutItems.map((item) => (
                <div class="rounded-lg bg-red-50 p-3">
                  <p class="text-xs font-semibold text-red-900">{item}</p>
                </div>
              ))}
            </div>
          </div>

        </div><!-- sidebar -->

      </div><!-- grid -->

      <!-- Final score overlay -->
      <div class="final-overlay hidden" id="final-overlay" role="dialog" aria-modal="true" aria-labelledby="final-title">
        <div class="final-card">
          <div class="final-icon">🎉</div>
          <h2 class="final-title" id="final-title">{labels.allStoriesComplete}</h2>
