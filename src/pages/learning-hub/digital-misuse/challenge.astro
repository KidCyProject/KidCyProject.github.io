---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ChallengeIntro from '@components/ChallengeIntro.astro'
import ChallengeProgress from '@components/ChallengeProgress.astro'
import HelpBox from '@components/HelpBox.astro'
import { useTranslations } from 'src/i18n/index'
import { toJsonScript } from '../../../utils/jsonScript'

const { t, v } = useTranslations(Astro.currentLocale)
const { v: vEn } = useTranslations('en')

// ── Types ──────────────────────────────────────────────────────────────────
type StructChoice = { next: string; points: number }
type StructStory = { id: number; sensitive?: true; nodes: Record<string, StructNode> }
type StructNode = {
  mood: string
  ending?: true
  type?: 'good' | 'okay' | 'bad'
  stars?: number
  choices?: StructChoice[]
}

type Choice = { text: string; next: string; points: number }
type StoryNode = {
  text: string
  mood: string
  choices?: Choice[]
  ending?: true
  type?: 'good' | 'okay' | 'bad'
  stars?: number
  title?: string
  lesson?: string
}
type Story = {
  id: number
  sensitive?: true
  title: string
  emoji: string
  topic: string
  nodes: Record<string, StoryNode>
}

// ── Story structure (game mechanics — not translated) ──────────────────────
// Star rule: good = 3, okay = 2, bad = 1. 0 stars only when the player hands over photos, an address
// or a password. `points` is live per-choice feedback ("Points this run"); it does not decide the stars.
// `sensitive` stories (private photos, strangers asking for your address) are left out unless the player
// switches them on, and they open with a content note.
