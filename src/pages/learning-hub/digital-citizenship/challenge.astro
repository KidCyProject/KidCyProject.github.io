---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import ChallengeShell from '@components/ChallengeShell.astro'
import HintPanel from '@components/HintPanel.astro'
import { useTranslations } from 'src/i18n/index'
import { toJsonScript } from '../../../utils/jsonScript'
import { DC_ZONES } from '../../../data/challengeDC'

const { t, v } = useTranslations(Astro.currentLocale)
const { v: vEn } = useTranslations('en')

type ZoneText = { icon: string; title: string; hint: string }
type PostText = { id: number; text: string; emoji: string; explanation: string }
type StopQuestion = { icon: string; text: string }

const zonesEn = vEn<Record<string, ZoneText>>('challengeDC.zones') ?? {}
const zonesLocal = v<Record<string, ZoneText>>('challengeDC.zones') ?? {}
const zoneTexts = Object.fromEntries(DC_ZONES.map((zone) => [zone, { ...zonesEn[zone], ...zonesLocal[zone] }])) as Record<string, ZoneText>

// Post texts by id: the page language, with English filling any gap
const postsEn = vEn<ReadonlyArray<PostText>>('challengeDC.posts') ?? []
const postsLocal = v<ReadonlyArray<PostText>>('challengeDC.posts') ?? []
const posts: ReadonlyArray<PostText> = postsEn.map((en) => ({ ...en, ...postsLocal.find((post) => post.id === en.id) }))

const stopQuestions = v<ReadonlyArray<StopQuestion>>('challengeDC.stopQuestions') ?? vEn<ReadonlyArray<StopQuestion>>('challengeDC.stopQuestions') ?? []

const labels = {
  scoreLabel: t('challengeDC.correctCountLabel'),
  tryOtherZone: t('challengeDC.tryOtherZone'),
  correctInTemplate: t('challengeDC.correctInTemplate'),
  winSummaryTemplate: t('challengeDC.winSummaryTemplate'),
  winGreat: t('challengeDC.winGreat'),
  winGood: t('challengeDC.winGood'),
  winPractise: t('challengeDC.winPractise'),
}
---

<DefaultLayout title={t('challengeDC.title')}>
  <script type="application/json" id="dc-challenge-data" set:html={toJsonScript({ posts, zones: zoneTexts, labels })} />

  <ChallengeShell ns="challengeDC" brand="DC" data-sort-game="">

    <!-- ── Main: the game ───────────────────────────────────────────────────── -->
    <div class="ch-card">

      <!-- Feedback: stays in view while scrolling, so the explanation is never left behind -->
      <div class="ch-feedback sort-game__feedback" data-feedback role="status" aria-live="polite" hidden>
        <p class="ch-feedback__title" data-feedback-title></p>
        <p class="ch-feedback__text" data-feedback-text></p>
      </div>

      <!-- Game board -->
      <div class="sort-game__board">

        <!-- Card tray (source) -->
        <div class="sort-game__tray" data-tray>
          <h3 class="sort-game__tray-label">{t('challengeDC.postsToSort')}</h3>
          <div class="sort-game__cards-container" data-cards-tray></div>
        </div>

        <!-- Drop zones -->
        <div class="sort-game__zones">
          {DC_ZONES.map((zone) => (
            <div
              class={`drop-zone drop-zone--${zone}`}
              data-zone={zone}
              role="region"
              aria-label={t('challengeDC.zoneAriaTemplate').replace('{zone}', zoneTexts[zone]?.title ?? zone)}
            >
              <div class="drop-zone__header">
                <div>
                  <h3 class="drop-zone__title">{zoneTexts[zone]?.title}</h3>
                  <p class="drop-zone__hint">{zoneTexts[zone]?.hint}</p>
                </div>
                <span class="drop-zone__icon" aria-hidden="true">{zoneTexts[zone]?.icon}</span>
              </div>
              <div class="drop-zone__content" data-zone-content>
                <p class="drop-zone__empty">{t('challengeDC.dragHere')}</p>
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Templates cloned by the script. Cloning keeps the scoped-style attributes, so the cards look the same as server-rendered ones -->
      <template data-card-template>
        <div class="post-card-wrapper">
          <div class="post-card" draggable="true" tabindex="0" role="button" aria-pressed="false">
            <div class="post-card__emoji" aria-hidden="true"></div>
            <div class="post-card__text"></div>
            <div class="post-card__check" aria-hidden="true">✓</div>
          </div>
          <div class="post-card__choices" role="group" aria-label={t('challengeDC.chooseZoneLabel')} hidden>
            {DC_ZONES.map((zone) => (
              <button type="button" class={`zone-choice zone-choice--${zone}`} data-choose={zone}>
                {zoneTexts[zone]?.icon} {zoneTexts[zone]?.title}
              </button>
            ))}
          </div>
        </div>
      </template>
      <template data-empty-template>
        <p class="drop-zone__empty">{t('challengeDC.dragHere')}</p>
      </template>
      <template data-review-template>
        <li class="sort-game__review-item">
          <span data-review-text></span>
          <span class="sort-game__review-zone" data-review-zone></span>
        </li>
      </template>
    </div>

    <!-- Result: appears under the board, which stays in view so the child can look back at it -->
    <div class="ch-card ch-result sort-game__win" data-win hidden>
      <div class="ch-result__icon sort-game__win-icon" aria-hidden="true">🎉</div>
      <h2 class="ch-result__title" id="win-title" tabindex="-1">{t('challengeDC.winTitle')}</h2>
      <div class="ch-result__score">
        <p class="ch-result__highlight" data-win-summary></p>
      </div>
      <p class="ch-result__text" data-win-message></p>
      <div class="sort-game__review" data-review hidden>
        <h3 class="sort-game__review-title">{t('challengeDC.reviewTitle')}</h3>
        <ul class="sort-game__review-list" data-review-list></ul>
      </div>
      <button class="ch-btn ch-btn--primary" type="button" data-restart>{t('challengeDC.playAgain')}</button>
    </div>

    <!-- ── Side column (above the game on phones) ───────────────────────────── -->
    <Fragment slot="side">
      <div class="ch-card">
        <p class="sort-game__score" data-score aria-live="polite"></p>
        <div class="ch-meter mt-3" aria-hidden="true">
          <span class="ch-meter__fill" data-score-fill></span>
        </div>
        <button class="ch-btn ch-btn--secondary ch-btn--block mt-4" type="button" data-restart>{t('challengeDC.tryAgain')}</button>
      </div>

      <!-- Three questions to ask before every post (collapsed on phones) -->
      <HintPanel title={t('challengeDC.stopTitle')} subtitle={t('challengeDC.stopSubtitle')}>
        {stopQuestions.map((question) => (
          <div class="flex gap-2 text-sm">
            <span class="shrink-0" aria-hidden="true">{question.icon}</span>
            <div>{question.text}</div>
          </div>
        ))}
        <div class="ch-note ch-note--brand mt-4">{t('challengeDC.stopNote')}</div>
      </HintPanel>
    </Fragment>
  </ChallengeShell>

<script>
  import { DC_POSTS, DC_ZONES, dealPosts, rankFor } from '../../../data/challengeDC'
  import { recordResult } from '../../../utils/challengeProgress'
  import type { DcPostRule, DcZone } from '../../../data/challengeDC'

  const initializeSortGame = () => {
    document.querySelectorAll('[data-sort-game]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return
      if (root.dataset.bound === 'true') return
      root.dataset.bound = 'true'

      const dataEl = document.getElementById('dc-challenge-data')
      if (!dataEl) return
      const { posts, zones: zoneTexts, labels } = JSON.parse(dataEl.textContent ?? '{}') as {
        posts: { id: number; text: string; emoji: string; explanation: string }[]
        zones: Record<string, { icon: string; title: string; hint: string }>
        labels: Record<string, string>
      }
      const postById = new Map(posts.map((post) => [post.id, post]))
      const ruleById = new Map<number, DcPostRule>(DC_POSTS.map((rule) => [rule.id, rule]))
      const fmt = (template: string, vars: Record<string, string | number>) =>
        String(template ?? '').replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''))
      const zoneLabel = (zone: string) => `${zoneTexts[zone]?.icon ?? ''} ${zoneTexts[zone]?.title ?? zone}`.trim()

      const scoreEl = root.querySelector('[data-score]')
      const scoreFill = root.querySelector<HTMLElement>('[data-score-fill]')
      const feedbackEl = root.querySelector<HTMLElement>('[data-feedback]')
      const feedbackTitle = root.querySelector<HTMLElement>('[data-feedback-title]')
      const feedbackText = root.querySelector<HTMLElement>('[data-feedback-text]')
      const winPanel = root.querySelector<HTMLElement>('[data-win]')
      const winSummary = root.querySelector<HTMLElement>('[data-win-summary]')
      const winMessage = root.querySelector<HTMLElement>('[data-win-message]')
      const reviewBox = root.querySelector<HTMLElement>('[data-review]')
      const reviewList = root.querySelector<HTMLElement>('[data-review-list]')
      const cardsTray = root.querySelector<HTMLElement>('[data-cards-tray]')
      const zones = root.querySelectorAll<HTMLElement>('[data-zone]')
      const restartBtns = root.querySelectorAll('[data-restart]')
      const cardTemplate = root.querySelector<HTMLTemplateElement>('template[data-card-template]')
      const emptyTemplate = root.querySelector<HTMLTemplateElement>('template[data-empty-template]')
      const reviewTemplate = root.querySelector<HTMLTemplateElement>('template[data-review-template]')

      if (!scoreEl || !feedbackEl || !feedbackTitle || !feedbackText || !winPanel || !winSummary || !winMessage ||
          !reviewBox || !reviewList || !cardsTray || !cardTemplate || !emptyTemplate || !reviewTemplate || zones.length === 0) return

      let deck: DcPostRule[] = []
      let placedCount = 0
      let firstTry = 0
      let missed = new Set<number>()
      let selectedCard: HTMLElement | null = null
      let draggedCard: HTMLElement | null = null
      let busy = false

      const zoneMap = new Map<string, HTMLElement>()
      zones.forEach((zone) => zoneMap.set(zone.dataset.zone || '', zone))

      const getCards = () => Array.from(root.querySelectorAll<HTMLElement>('[data-post-id]'))
      const getWrapper = (card: HTMLElement) => card.closest('.post-card-wrapper') as HTMLElement | null
      const getChoices = (card: HTMLElement) => getWrapper(card)?.querySelector<HTMLElement>('.post-card__choices') ?? null

      const updateScore = () => {
        scoreEl.textContent = `${placedCount} / ${deck.length} ${labels.scoreLabel}`.trim()
        if (scoreFill) scoreFill.style.width = deck.length ? `${(placedCount / deck.length) * 100}%` : '0%'
      }

      // ── Feedback: explanation of the last card, always in view ────────────
      const showFeedback = (type: 'correct' | 'wrong' | 'info', title: string, text: string) => {
        feedbackTitle.textContent = title
        feedbackText.textContent = text
        const tone = type === 'correct' ? 'ok' : type === 'wrong' ? 'bad' : 'info'
        feedbackEl.className = `ch-feedback sort-game__feedback ch-feedback--${tone}`
        feedbackEl.hidden = false
      }
      const hideFeedback = () => {
        feedbackEl.hidden = true
        feedbackTitle.textContent = ''
        feedbackText.textContent = ''
      }

      // ── Build one card (with its "where does it go?" buttons) from the template ──
      const buildCard = (rule: DcPostRule): HTMLElement => {
        const post = postById.get(rule.id)
        const wrapper = cardTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement
        const card = wrapper.querySelector<HTMLElement>('.post-card')!
        card.dataset.postId = String(rule.id)
        wrapper.querySelector('.post-card__emoji')!.textContent = post?.emoji ?? ''
        wrapper.querySelector('.post-card__text')!.textContent = post?.text ?? ''
        return wrapper
      }

      // ── Selection (tap, click or keyboard) ────────────────────────────────
      const deselectCard = () => {
        if (selectedCard) {
          selectedCard.classList.remove('post-card--selected')
          selectedCard.setAttribute('aria-pressed', 'false')
          const choices = getChoices(selectedCard)
          if (choices) choices.hidden = true
        }
        selectedCard = null
      }

      const handleCardClick = (card: HTMLElement) => {
        if (busy) return
        if (card.dataset.placed === 'true') {
          // A placed card can be tapped to read its explanation again
          const post = postById.get(Number(card.dataset.postId))
          const rule = ruleById.get(Number(card.dataset.postId))
          if (post && rule) showFeedback('info', zoneLabel(rule.zone), post.explanation)
          return
        }
        if (selectedCard === card) {
          deselectCard()
          return
        }
        deselectCard()
        selectedCard = card
        card.classList.add('post-card--selected')
        card.setAttribute('aria-pressed', 'true')
        const choices = getChoices(card)
        if (choices) choices.hidden = false
      }

      // ── Move card + wrapper into a drop zone ─────────────────────────────
      const moveCardToZone = (card: HTMLElement, zone: HTMLElement) => {
        const wrapper = getWrapper(card)
        const content = zone.querySelector('[data-zone-content]')
        if (!content || !wrapper) return
        content.querySelector('.drop-zone__empty')?.remove()
        content.appendChild(wrapper)
      }

      const focusNextCard = () => {
        getCards().find((card) => card.dataset.placed !== 'true')?.focus()
      }

      // ── Perform drop logic ────────────────────────────────────────────────
      const performDrop = (card: HTMLElement, zone: HTMLElement, options: { focusNext?: boolean } = {}) => {
        if (card.dataset.placed === 'true' || busy) return
        const id = Number(card.dataset.postId)
        const rule = ruleById.get(id)
        const post = postById.get(id)
        if (!rule || !post) return

        busy = true
        const chosen = zone.dataset.zone as DcZone

        if (rule.zone === chosen) {
          card.dataset.placed = 'true'
          card.classList.add('post-card--placed')
          card.draggable = false
          card.tabIndex = -1
          card.setAttribute('aria-pressed', 'false')
          deselectCard()
          moveCardToZone(card, zone)

          placedCount++
          if (!missed.has(id)) firstTry++
          updateScore()
          showFeedback('correct', fmt(labels.correctInTemplate, { zone: zoneLabel(chosen) }), post.explanation)
          if (options.focusNext) focusNextCard()

          setTimeout(() => {
            busy = false
            checkWin()
          }, 600)
        } else {
          // Wrong zone: counts against the first-try score, and the explanation says why
          missed.add(id)
          card.classList.add('post-card--wrong')
          showFeedback('wrong', labels.tryOtherZone, post.explanation)

          setTimeout(() => {
            card.classList.remove('post-card--wrong')
            busy = false
          }, 700)
        }
      }

      // ── Mouse: a card is selected, then a zone is clicked ─────────────────
      const handleZoneClick = (zone: HTMLElement) => {
        if (!selectedCard || busy || selectedCard.dataset.placed === 'true') return
        performDrop(selectedCard, zone)
      }

      // ── Win ───────────────────────────────────────────────────────────────
      const checkWin = () => {
        if (getCards().length === 0 || !getCards().every((card) => card.dataset.placed === 'true')) return

        recordResult('dc', firstTry, deck.length)
        winSummary.textContent = fmt(labels.winSummaryTemplate, { n: firstTry, total: deck.length })
        const rank = rankFor(firstTry, deck.length)
        winMessage.textContent = rank === 'great' ? labels.winGreat : rank === 'good' ? labels.winGood : labels.winPractise

        reviewList.replaceChildren()
        const missedRules = deck.filter((rule) => missed.has(rule.id))
        missedRules.forEach((rule) => {
          const post = postById.get(rule.id)
          const item = reviewTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement
          item.querySelector('[data-review-text]')!.textContent = `${post?.emoji ?? ''} ${post?.text ?? ''}`.trim()
          item.querySelector('[data-review-zone]')!.textContent = `→ ${zoneLabel(rule.zone)}`
          reviewList.append(item)
        })
        reviewBox.hidden = missedRules.length === 0

        setTimeout(() => {
          winPanel.hidden = false
          winPanel.scrollIntoView({ behavior: 'smooth', block: 'center' })
          winPanel.querySelector<HTMLElement>('#win-title')?.focus({ preventScroll: true })
        }, 400)
      }

      // ── Drag event handlers ───────────────────────────────────────────────
      const handleDragStart = (e: DragEvent) => {
        if (!(e.target instanceof HTMLElement)) return
        const card = e.target.closest('[data-post-id]') as HTMLElement | null
        if (!card || card.dataset.placed === 'true') {
          e.preventDefault()
          return
        }
        draggedCard = card
        card.classList.add('post-card--dragging')
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move'
          e.dataTransfer.setData('text/plain', card.dataset.postId || '')
        }
      }

      const handleDragEnd = (e: DragEvent) => {
        if (!(e.target instanceof HTMLElement)) return
        e.target.closest('[data-post-id]')?.classList.remove('post-card--dragging')
        zones.forEach((zone) => zone.classList.remove('drop-zone--active'))
      }

      const handleDragOver = (e: DragEvent) => {
        e.preventDefault()
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move'
        const zone = (e.target as HTMLElement).closest('[data-zone]') as HTMLElement | null
        zone?.classList.add('drop-zone--active')
      }

      const handleDragLeave = (e: DragEvent) => {
        const zone = (e.target as HTMLElement).closest('[data-zone]') as HTMLElement | null
        if (zone && e.target === zone) zone.classList.remove('drop-zone--active')
      }

      const handleDrop = (e: DragEvent) => {
        e.preventDefault()
        if (!draggedCard) return
        const zone = (e.target as HTMLElement).closest('[data-zone]') as HTMLElement | null
        if (!zone) return
        zone.classList.remove('drop-zone--active')
        performDrop(draggedCard, zone)
        draggedCard = null
      }

      // ── Deal a fresh game ─────────────────────────────────────────────────
      const emptyZones = () => {
        zones.forEach((zone) => {
          const content = zone.querySelector<HTMLElement>('[data-zone-content]')
          if (!content) return
          content.replaceChildren(emptyTemplate.content.firstElementChild!.cloneNode(true))
        })
      }

      const deal = () => {
        deck = dealPosts()
        placedCount = 0
        firstTry = 0
        missed = new Set<number>()
        selectedCard = null
        draggedCard = null
        busy = false
        cardsTray.replaceChildren(...deck.map(buildCard))
        updateScore()
      }

      const restart = () => {
        winPanel.hidden = true
        hideFeedback()
        emptyZones()
        deal()
        getCards()[0]?.focus({ preventScroll: true })
      }

      // ── Attach listeners ──────────────────────────────────────────────────
      root.addEventListener('dragstart', handleDragStart, true)
      root.addEventListener('dragend', handleDragEnd, true)

      zones.forEach((zone) => {
        zone.addEventListener('dragover', handleDragOver)
        zone.addEventListener('dragleave', handleDragLeave)
        zone.addEventListener('drop', handleDrop)
        zone.addEventListener('click', (e) => {
          // A click on a card or its buttons inside the zone is not a click on the zone itself
          if (e.target instanceof HTMLElement && e.target.closest('[data-post-id], .post-card__choices')) return
          handleZoneClick(zone)
        })
      })

      // Cards are created again for every game, so one set of delegated listeners handles them all
      const handleBoardClick = (e: Event) => {
        const target = e.target
        if (!(target instanceof HTMLElement)) return

        // "Where does it go?" buttons under the selected card
        const choice = target.closest<HTMLElement>('[data-choose]')
        if (choice) {
          const card = getWrapper(choice)?.querySelector<HTMLElement>('[data-post-id]')
          const zone = zoneMap.get(choice.dataset.choose ?? '')
          if (card && zone) performDrop(card, zone, { focusNext: true })
          return
        }

        const card = target.closest<HTMLElement>('[data-post-id]')
        if (card) handleCardClick(card)
      }
      root.addEventListener('click', handleBoardClick)

      root.addEventListener('keydown', (e) => {
        const target = e.target
        if (!(target instanceof HTMLElement)) return

        const card = target.closest<HTMLElement>('[data-post-id]')
        if (card && target === card) {
          if (e.key === 'Escape' && selectedCard === card) {
            deselectCard()
            return
          }
          if ((e.key !== 'Enter' && e.key !== ' ') || e.repeat || card.dataset.placed === 'true') return
          e.preventDefault()
          const wasSelected = selectedCard === card
          handleCardClick(card)
          // Newly selected → continue with the choice buttons right below the card
          if (!wasSelected && selectedCard === card) getChoices(card)?.querySelector<HTMLElement>('button')?.focus()
          return
        }

        // Escape inside the choice buttons: back to the card
        if (e.key === 'Escape' && target.closest('.post-card__choices') && selectedCard) {
          const back = selectedCard
          deselectCard()
          back.focus()
        }
      })

      restartBtns.forEach((btn) => btn.addEventListener('click', restart))

      // Initial setup
      deal()
    })
  }

  document.addEventListener('astro:page-load', initializeSortGame)
  initializeSortGame()
</script>

<style>

  /* The cards, buttons, feedback bar, progress bar, result card and side column come from the shared
     challenge styles (src/assets/scss/base/_challenge.scss); below is only what is specific to this game. */

  /* ── Score (side column) ─────────────────────────────────────────────────── */
  .sort-game__score {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--ch-accent);
  }

  /* ── Feedback message (sticks to the top while the board is scrolled) ─────── */
  .sort-game__feedback {
    position: sticky;
    top: 0.75rem;
    z-index: 20;
    margin-bottom: var(--space-s);
    box-shadow: var(--elevation-2);
  }

  /* ── Game board layout ───────────────────────────────────────────────────── */
  /* One column: the game column is narrower than the old full-width page, so the tray sits above the four zones */
  .sort-game__board {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
  }

  /* ── Tray (source area) ──────────────────────────────────────────────────── */
  .sort-game__tray {
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background-color: var(--ch-surface-2);
    border: 2px dashed var(--ch-border);
  }

  .sort-game__tray-label {
    font-size: var(--font-size-1);
    font-weight: 700;
    margin-bottom: var(--space-m);
    color: var(--ch-text);
  }

  .sort-game__cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    align-items: start;
    gap: var(--space-2xs);
  }

  /* ── Post card wrapper ─────────────────────────────────────────────────── */
  .post-card-wrapper {
    display: flex;
    flex-direction: column;
  }

  /* ── Post card ───────────────────────────────────────────────────────────── */
  .post-card {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background-color: white;
    border: 2px solid #e5e7eb;
    cursor: grab;
    user-select: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      border-color 0.2s,
      background-color 0.2s;
    box-shadow: var(--elevation-1);
  }

  .post-card:where(:hover, :focus-visible) {
    border-color: var(--ch-brand);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--ch-brand), transparent 80%);
    transform: translateY(-2px);
  }

  .post-card:focus-visible {
    outline: none;
  }

  .post-card--selected {
    border-color: #3b82f6;
    background-color: #eff6ff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
  }

  .post-card--dragging {
    opacity: 0.6;
    cursor: grabbing;
  }

  .post-card--placed {
    cursor: pointer;
    opacity: 0.85;
    border-color: #d1d5db;
  }

  .post-card--placed .post-card__text {
    color: #6b7280;
  }

  .post-card--wrong {
    animation: shake 0.4s ease;
    background-color: #fef2f2;
    border-color: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  .post-card__emoji {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .post-card__text {
    flex: 1;
