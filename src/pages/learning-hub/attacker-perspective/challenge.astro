---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ChallengeIntro from '@components/ChallengeIntro.astro'
import ChallengeProgress from '@components/ChallengeProgress.astro'
import HintPanel from '@components/HintPanel.astro'
import { useTranslations } from 'src/i18n/index'
import { toJsonScript } from '../../../utils/jsonScript'
import { AP_GOALS } from '../../../data/apPlan'

const { t, v } = useTranslations(Astro.currentLocale)
const { v: vEn } = useTranslations('en')

type Hotspot = {
  id: string
  label: string
  explain: string
}

const rawHotspots = v<ReadonlyArray<Record<string, unknown>>>('challengeAP.hotspots') ?? []
const enHotspots = vEn<ReadonlyArray<Record<string, unknown>>>('challengeAP.hotspots') ?? []

const hotspotById = new Map<string, Hotspot>()
enHotspots.forEach((item) => {
  const id = String(item.id ?? '')
  hotspotById.set(id, { id, label: String(item.label ?? id), explain: String(item.explain ?? '') })
})
rawHotspots.forEach((item) => {
  const id = String(item.id ?? '')
  const prev = hotspotById.get(id)
  hotspotById.set(id, {
    id,
    label: String(item.label ?? prev?.label ?? id),
    explain: String(item.explain ?? prev?.explain ?? ''),
  })
})

const hs = (id: string) => hotspotById.get(id) ?? { id, label: id, explain: '' }
const attackerTargets = v<ReadonlyArray<string>>('challengeAP.attackerTargets') ?? []
// The address bar follows the profile handle of the current language (e.g. @martin123 in Czech)
const profileSlug = t('challengeAP.profile.handle').replace(/^@/, '')

// ── Parts 2 and 3 (plan the attack · why and how to stop it): texts by id, English filling any gap ──
type GoalText = { icon: string; title: string; hint: string }
type ClueText = { id: string; icon: string; text: string; explanation: string }
type MotivationText = { name: string; desc: string }
type MotiveCaseText = { id: number; text: string; explanation: string }
type DefendCaseText = { id: number; text: string; options: string[]; explanation: string }

const merge = <T extends { id: string | number }>(en: ReadonlyArray<T>, local: ReadonlyArray<T>): T[] =>
  en.map((item) => ({ ...item, ...local.find((other) => other.id === item.id) }))

const goalsEn = vEn<Record<string, GoalText>>('challengeAP.goals') ?? {}
const goalsLocal = v<Record<string, GoalText>>('challengeAP.goals') ?? {}
const goalTexts = Object.fromEntries(AP_GOALS.map((goal) => [goal, { ...goalsEn[goal], ...goalsLocal[goal] }])) as Record<string, GoalText>
const clues = merge(vEn<ReadonlyArray<ClueText>>('challengeAP.clues') ?? [], v<ReadonlyArray<ClueText>>('challengeAP.clues') ?? [])
const motivationsEn = vEn<Record<string, MotivationText>>('challengeAP.motivations') ?? {}
const motivationsLocal = v<Record<string, MotivationText>>('challengeAP.motivations') ?? {}
const motivations = Object.fromEntries(
  Object.keys(motivationsEn).map((id) => [id, { ...motivationsEn[id], ...motivationsLocal[id] }]),
) as Record<string, MotivationText>
const motiveCases = merge(vEn<ReadonlyArray<MotiveCaseText>>('challengeAP.motiveCases') ?? [], v<ReadonlyArray<MotiveCaseText>>('challengeAP.motiveCases') ?? [])
const defendCases = merge(vEn<ReadonlyArray<DefendCaseText>>('challengeAP.defendCases') ?? [], v<ReadonlyArray<DefendCaseText>>('challengeAP.defendCases') ?? [])

const planLabels = {
  part1Label: t('challengeAP.part1Label'),
  part2Label: t('challengeAP.part2Label'),
  part3Label: t('challengeAP.part3Label'),
  continueButton: t('challengeAP.continueButton'),
  planIntro: t('challengeAP.planIntro'),
  planChooseLabel: t('challengeAP.planChooseLabel'),
  planVoiceCorrect: t('challengeAP.planVoiceCorrect'),
  planVoiceWrong: t('challengeAP.planVoiceWrong'),
  planScoreTemplate: t('challengeAP.planScoreTemplate'),
  quizTitle: t('challengeAP.quizTitle'),
  quizProgressTemplate: t('challengeAP.quizProgressTemplate'),
  motiveLabel: t('challengeAP.motiveLabel'),
  defendLabel: t('challengeAP.defendLabel'),
  quizVoiceCorrect: t('challengeAP.quizVoiceCorrect'),
  quizVoiceWrong: t('challengeAP.quizVoiceWrong'),
  nextButton: t('challengeAP.nextButton'),
  resultsButton: t('challengeAP.resultsButton'),
  finalPart1Template: t('challengeAP.finalPart1Template'),
  finalPart2Template: t('challengeAP.finalPart2Template'),
  finalPart3Template: t('challengeAP.finalPart3Template'),
  finalScoreTemplate: t('challengeAP.finalScoreTemplate'),
  rankGreat: t('challengeAP.rankGreat'),
  rankGood: t('challengeAP.rankGood'),
  rankPractise: t('challengeAP.rankPractise'),
}
---

<DefaultLayout title={t('challengeAP.title')}>
  <PageHeader
    title={t('challengeAP.title')}
    subtitle={t('challengeAP.subtitle')}
    bgType="module"
    underlineColor="var(--brand-AP)"
  />

  <ChallengeProgress />

  <script
    type="application/json"
    id="ap-challenge-data"
    set:html={toJsonScript({ clues, goals: goalTexts, motivations, motiveCases, defendCases, labels: planLabels })}
  />

  <section
    class="my-12"
    data-vulnerability-game
    data-vuln-empty={t('challengeAP.vulnerabilitiesEmpty')}
    data-win-title={t('challengeAP.winTitle')}
    data-win-msg={t('challengeAP.winMsg')}
    data-lose-title={t('challengeAP.loseTitle')}
    data-lose-msg-template={t('challengeAP.loseMsgTemplate')}
    data-voice-initial={t('challengeAP.attackerVoiceInitial')}
    data-voice-win-template={t('challengeAP.attackerVoiceWin')}
    data-voice-lose={t('challengeAP.attackerVoiceLose')}
    data-voice-already-tagged-template={t('challengeAP.attackerVoiceAlreadyTagged')}
    data-voice-correct-template={t('challengeAP.attackerVoiceCorrect')}
    data-voice-wrong-template={t('challengeAP.attackerVoiceWrong')}
  >
    <div class="container">

      <ChallengeIntro ns="challengeAP" brand="AP" />

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_300px]">

        <!-- Main: the three parts of the challenge -->
        <div>

          <p class="ap-part" data-part-label></p>

          <!-- Attacker voice: shows the explanation after every click -->
          <div class="attacker-bar mb-4" id="attacker-bar" role="status" aria-live="polite">
            <span class="attacker-icon" aria-hidden="true">🕵️</span>
            <p class="attacker-text" id="attacker-voice"></p>
          </div>

          <!-- Part 1: mock browser window -->
          <div data-part-area="1">
          <div class="browser-window">

            <!-- Browser chrome (dark) -->
            <div class="browser-chrome">
              <div class="browser-dots">
                <span class="bdot bdot-red"></span>
                <span class="bdot bdot-yellow"></span>
                <span class="bdot bdot-green"></span>
              </div>
              <!-- Address bar — HOTSPOT: HTTP (correct) -->
	              <button
	                class="address-bar hotspot-btn"
	                data-id="http"
	                data-correct="true"
	                data-label={hs('http').label}
	                data-explain={hs('http').explain}
	              >
	                <span class="addr-lock">🔓</span>
	                <span class="addr-url">http://socialmedia-insecure.com/profile/{profileSlug}</span>
	              </button>
            </div>

            <!-- Profile page (white background) -->
            <div class="profile-page">

              <!-- Profile header -->
              <div class="profile-head">

                <!-- Avatar — HOTSPOT: avatar (wrong) -->
	                <button
	                  class="avatar-wrap hotspot-btn"
	                  data-id="avatar"
	                  data-correct="false"
	                  data-label={hs('avatar').label}
	                  data-explain={hs('avatar').explain}
	                >
	                  <div class="p-avatar">👤</div>
	                </button>

                <div class="head-info">

                  <!-- Name & handle — HOTSPOT: username (wrong) -->
	                  <button
	                    class="name-btn hotspot-btn"
	                    data-id="username"
	                    data-correct="false"
	                    data-label={hs('username').label}
	                    data-explain={hs('username').explain}
	                  >
	                    <span class="display-name">{t('challengeAP.profile.displayName')}</span>
	                    <span class="handle">{t('challengeAP.profile.handle')}</span>
	                  </button>

                  <!-- Online status — HOTSPOT: online (wrong) -->
	                  <button
	                    class="status-btn hotspot-btn"
	                    data-id="online"
	                    data-correct="false"
	                    data-label={hs('online').label}
	                    data-explain={hs('online').explain}
	                  >
	                    <span class="online-dot"></span>
	                    <span class="status-label">{t('challengeAP.profile.statusActiveNow')}</span>
	                  </button>

                  <!-- Bio — HOTSPOT: bio (wrong) -->
	                  <button
	                    class="bio-btn hotspot-btn"
	                    data-id="bio"
	                    data-correct="false"
	                    data-label={hs('bio').label}
	                    data-explain={hs('bio').explain}
	                  >
	                    <span class="bio-text">{t('challengeAP.profile.bioText')}</span>
	                  </button>

                  <!-- Follower stats — HOTSPOT: followers (wrong) -->
	                  <button
	                    class="stats-btn hotspot-btn"
	                    data-id="followers"
	                    data-correct="false"
	                    data-label={hs('followers').label}
	                    data-explain={hs('followers').explain}
	                  >
	                    <span class="stat-item"><strong>847</strong> {t('challengeAP.profile.statsFriendsLabel')}</span>
	                    <span class="stat-sep">·</span>
	                    <span class="stat-item"><strong>312</strong> {t('challengeAP.profile.statsFollowingLabel')}</span>
	                  </button>

                </div>
              </div>

              <!-- Profile body: two-column layout -->
              <div class="profile-body">

                <!-- Left: About + Account -->
                <div class="profile-left">

                  <!-- About card -->
	                  <div class="info-card">
	                    <h3 class="info-card-title">{t('challengeAP.profile.aboutTitle')}</h3>

                    <!-- Birthday — HOTSPOT: birthday (correct) -->
	                    <button
	                      class="info-row hotspot-btn"
	                      data-id="birthday"
	                      data-correct="true"
	                      data-label={hs('birthday').label}
	                      data-explain={hs('birthday').explain}
	                    >
	                      <span class="row-icon">🎂</span>
	                      <span class="row-text">{t('challengeAP.profile.bornText')}</span>
	                    </button>

                    <!-- Email — HOTSPOT: email (wrong) -->
	                    <button
	                      class="info-row hotspot-btn"
	                      data-id="email"
	                      data-correct="false"
	                      data-label={hs('email').label}
	                      data-explain={hs('email').explain}
	                    >
	                      <span class="row-icon">✉️</span>
	                      <span class="row-text">{t('challengeAP.profile.emailText')}</span>
	                    </button>

                    <!-- Pet Name — HOTSPOT: petname (correct) -->
	                    <button
	                      class="info-row hotspot-btn"
	                      data-id="petname"
	                      data-correct="true"
	                      data-label={hs('petname').label}
	                      data-explain={hs('petname').explain}
	                    >
	                      <span class="row-icon">🐱</span>
	                      <span class="row-text">{t('challengeAP.profile.petNameText')}</span>
	                    </button>
                  </div>

                </div>

                <!-- Right: Posts feed -->
                <div class="profile-right">

                  <!-- Post 1: real-time location — HOTSPOT: location (correct) -->
	                  <button
	                    class="post-card hotspot-btn"
	                    data-id="location"
	                    data-correct="true"
	                    data-label={hs('location').label}
	                    data-explain={hs('location').explain}
	                  >
	                    <div class="post-header-row">
	                      <span class="post-av">👤</span>
	                      <div class="post-meta">
	                        <p class="post-uname">{t('challengeAP.profile.displayName')}</p>
	                        <p class="post-time">{t('challengeAP.profile.post1Time')}</p>
	                      </div>
	                    </div>
	                    <p class="post-body">{t('challengeAP.profile.post1Body')}</p>
	                    <div class="post-place-badge">{t('challengeAP.profile.post1Badge')}</div>
	                  </button>
                  <div class="post-actions-bar">
                    <!-- Like button post 1 — HOTSPOT: like1 (wrong) -->
	                    <button
	                      class="action-btn hotspot-btn"
	                      data-id="like1"
	                      data-correct="false"
	                      data-label={hs('like1').label}
	                      data-explain={hs('like1').explain}
	                    >
	                      👍 {t('challengeAP.profile.actionLike')} <span class="act-count">24</span>
	                    </button>
                    <!-- Comment button post 1 — HOTSPOT: comment1 (wrong) -->
	                    <button
	                      class="action-btn hotspot-btn"
	                      data-id="comment1"
	                      data-correct="false"
	                      data-label={hs('comment1').label}
	                      data-explain={hs('comment1').explain}
	                    >
	                      💬 {t('challengeAP.profile.actionComment')} <span class="act-count">8</span>
	                    </button>
                    <!-- Share button post 1 — HOTSPOT: share1 (wrong) -->
	                    <button
	                      class="action-btn hotspot-btn"
	                      data-id="share1"
	                      data-correct="false"
	                      data-label={hs('share1').label}
	                      data-explain={hs('share1').explain}
	                    >
	                      ↗️ {t('challengeAP.profile.actionShare')}
	                    </button>
                  </div>

                  <!-- Post 2: generic — HOTSPOT: post2 (wrong) -->
	                  <button
	                    class="post-card hotspot-btn"
	                    data-id="post2"
	                    data-correct="false"
	                    data-label={hs('post2').label}
	                    data-explain={hs('post2').explain}
	                  >
	                    <div class="post-header-row">
	                      <span class="post-av">👤</span>
	                      <div class="post-meta">
	                        <p class="post-uname">{t('challengeAP.profile.displayName')}</p>
	                        <p class="post-time">{t('challengeAP.profile.post2Time')}</p>
	                      </div>
	                    </div>
	                    <p class="post-body">{t('challengeAP.profile.post2Body')}</p>
	                  </button>
                  <div class="post-actions-bar">
                    <!-- Like button post 2 — HOTSPOT: like2 (wrong) -->
	                    <button
	                      class="action-btn hotspot-btn"
	                      data-id="like2"
	                      data-correct="false"
	                      data-label={hs('like2').label}
	                      data-explain={hs('like2').explain}
	                    >
	                      👍 {t('challengeAP.profile.actionLike')} <span class="act-count">41</span>
	                    </button>
                    <!-- Comment button post 2 — HOTSPOT: comment2 (wrong) -->
	                    <button
	                      class="action-btn hotspot-btn"
	                      data-id="comment2"
	                      data-correct="false"
	                      data-label={hs('comment2').label}
	                      data-explain={hs('comment2').explain}
	                    >
	                      💬 {t('challengeAP.profile.actionComment')} <span class="act-count">15</span>
	                    </button>
                  </div>

                </div>
              </div>
            </div>
          </div>
          </div><!-- /part 1 -->

          <!-- Part 2: plan the attack -->
          <div data-part-area="2" hidden>
            <div class="ap-card">
              <h2 class="ap-card__title" id="plan-title" tabindex="-1">{t('challengeAP.planTitle')}</h2>
              <p class="ap-card__intro">{t('challengeAP.planIntro')}</p>

              <div class="plan-board">
                <div class="plan-tray">
                  <h3 class="plan-tray__title">{t('challengeAP.planTrayTitle')}</h3>
                  <div class="plan-tray__list" data-plan-tray></div>
                </div>

                <div class="plan-zones">
                  {AP_GOALS.map((goal) => (
                    <div class={`plan-zone plan-zone--${goal}`}>
                      <button type="button" class="plan-zone__btn" data-goal={goal}>
                        <span class="plan-zone__icon" aria-hidden="true">{goalTexts[goal]?.icon}</span>
                        <span class="plan-zone__text">
                          <strong class="plan-zone__title">{goalTexts[goal]?.title}</strong>
                          <span class="plan-zone__hint">{goalTexts[goal]?.hint}</span>
                        </span>
                      </button>
                      <ul class="plan-zone__list" data-goal-list={goal}></ul>
                    </div>
                  ))}
                </div>
              </div>

              <div class="plan-summary" data-plan-summary hidden>
                <h3 class="plan-summary__title">{t('challengeAP.planSummaryTitle')}</h3>
                <p>{t('challengeAP.planSummaryText')}</p>
                <p class="plan-summary__score" data-plan-score></p>
                <button type="button" class="btn btn-primary" data-to-quiz>{t('challengeAP.toQuizButton')}</button>
              </div>
            </div>
          </div>

          <!-- Part 3: why, and how to stop it -->
          <div data-part-area="3" hidden>
            <div class="ap-card">
              <h2 class="ap-card__title" id="quiz-title" tabindex="-1">{t('challengeAP.quizTitle')}</h2>
              <p class="quiz-progress" data-quiz-progress></p>
              <p class="quiz-kind" data-quiz-kind></p>
              <p class="quiz-text" id="quiz-text" data-quiz-text></p>
              <div class="quiz-options" data-quiz-options role="group" aria-labelledby="quiz-text"></div>
              <button type="button" class="btn btn-primary quiz-next" data-quiz-next hidden></button>
            </div>
          </div>

          <!-- Results -->
          <div data-part-area="4" hidden>
            <div class="ap-card ap-final">
              <div class="ap-final__icon" aria-hidden="true">🕵️</div>
              <h2 class="ap-card__title" id="final-title" tabindex="-1">{t('challengeAP.finalTitle')}</h2>
              <p class="ap-final__score" data-final-score></p>
              <ul class="ap-final__list">
                <li data-final-part="1"></li>
                <li data-final-part="2"></li>
                <li data-final-part="3"></li>
              </ul>
              <p class="ap-final__message" data-final-message></p>
              <button type="button" class="btn btn-primary" data-play-again>{t('challengeAP.tryAgain')}</button>
            </div>
          </div>

          <!-- Templates cloned by the script (cloning keeps the scoped-style attributes) -->
          <template data-plan-chip-template>
            <button type="button" class="plan-chip" aria-pressed="false">
              <span class="plan-chip__icon" aria-hidden="true"></span>
              <span class="plan-chip__text"></span>
            </button>
          </template>
          <template data-plan-item-template>
            <li class="plan-zone__item">
              <span aria-hidden="true"></span>
              <span></span>
            </li>
          </template>
          <template data-quiz-option-template>
            <button type="button" class="quiz-option"></button>
          </template>
        </div>

        <!-- Sidebar: on phones it sits above the game so lives and progress stay in view -->
        <div class="order-first h-fit rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:sticky lg:top-6 lg:order-none lg:p-6">

          <div class="grid grid-cols-2 gap-4 lg:block" data-part-only="1">
            <!-- Lives -->
            <div class="lg:mb-6">
              <h3 class="text-base font-bold text-slate-900">{t('challengeAP.livesTitle')}</h3>
              <p class="mt-1 text-xs text-slate-600">{t('challengeAP.livesDesc')}</p>
              <div class="lives-row mt-3 border-t border-slate-200 pt-3 lg:mt-4 lg:pt-4">
                <span class="life-icon" id="life-1">❤️</span>
                <span class="life-icon" id="life-2">❤️</span>
                <span class="life-icon" id="life-3">❤️</span>
              </div>
            </div>

            <!-- Found counter -->
            <div class="lg:mb-6 lg:border-t lg:border-slate-200 lg:pt-4">
              <h3 class="mb-3 text-sm font-bold text-slate-900">{t('challengeAP.vulnerabilitiesFoundTitle')}</h3>
              <div class="vuln-counter">
                <span class="vuln-count" id="found-count">0</span>
                <span class="vuln-denom">{t('challengeAP.vulnerabilitiesCount')}</span>
              </div>
              <ul class="vuln-list mt-3" id="found-list">
                <li class="vuln-empty">{t('challengeAP.vulnerabilitiesEmpty')}</li>
              </ul>
            </div>
          </div>

          <!-- What attackers target (parts 1–2): collapsed on phones -->
          <div data-help-for="1 2">
            <HintPanel flat class="mt-4" title={t('challengeAP.attackerTargetsTitle')}>
              {attackerTargets.map((item) => (
                <div class="rounded-lg bg-red-50 p-3">
                  <p class="text-xs font-semibold text-red-900">{item}</p>
                </div>
              ))}
            </HintPanel>
          </div>

          <!-- Why attackers attack (part 3) -->
          <div data-help-for="3" hidden>
            <HintPanel flat title={t('challengeAP.motivationsTitle')} subtitle={t('challengeAP.motivationsSubtitle')}>
              {Object.values(motivations).map((motivation) => (
                <div class="text-sm">
                  <strong>{motivation.name}</strong> — {motivation.desc}
                </div>
              ))}
            </HintPanel>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Game-end overlay -->
  <div class="game-overlay hidden" id="game-overlay" role="dialog" aria-modal="true" aria-labelledby="overlay-title" aria-describedby="overlay-msg">
    <div class="overlay-card">
      <div class="overlay-icon" id="overlay-icon">🎉</div>
      <h2 class="overlay-title" id="overlay-title">…</h2>
      <p class="overlay-msg" id="overlay-msg">…</p>
	      <div class="overlay-score">
	        <span id="overlay-found">0</span> {t('challengeAP.vulnFoundSuffix')}
	      </div>
	      <div class="overlay-actions">
	        <button class="btn btn-primary" id="continue-btn">{t('challengeAP.continueButton')}</button>
	        <button class="btn btn-secondary" id="reset-btn">{t('challengeAP.tryAgain')}</button>
	      </div>
	    </div>
	  </div>

  <style>

    /* ── Attacker voice bar ────────────────────────────────────────────────── */
    .attacker-bar {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: #1e1b4b;
      border: 1px solid #4338ca;
      border-radius: 10px;
      padding: 12px 16px;
      min-height: 5.5rem;
      transition: background 0.4s ease, border-color 0.4s ease;
    }

    .attacker-bar.bar-correct {
      background: #14532d;
      border-color: #22c55e;
    }

    .attacker-bar.bar-wrong {
      background: #7f1d1d;
      border-color: #ef4444;
    }

    .attacker-icon { font-size: 1.4rem; flex-shrink: 0; margin-top: 1px; }

    .attacker-text {
      font-size: 0.875rem;
      font-weight: 500;
      color: #c7d2fe;
      font-family: 'Courier New', monospace;
      margin: 0;
      line-height: 1.5;
      transition: color 0.4s ease;
    }

    .attacker-bar.bar-correct .attacker-text { color: #86efac; }
    .attacker-bar.bar-wrong  .attacker-text { color: #fca5a5; }

    /* ── Browser window ────────────────────────────────────────────────────── */
    .browser-window {
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
      border: 1px solid #d1d5db;
    }

    .browser-chrome {
      background: #2d2d2d;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .browser-dots { display: flex; gap: 6px; }
    .bdot { width: 12px; height: 12px; border-radius: 50%; }
    .bdot-red    { background: #ff5f57; }
    .bdot-yellow { background: #febc2e; }
    .bdot-green  { background: #28c840; }

    /* Address bar (dark context — special hotspot styling) */
    .address-bar {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 8px;
      background: #1a1a1a;
      border: 1.5px solid #555;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 0.78rem;
      color: #e5e5e5;
