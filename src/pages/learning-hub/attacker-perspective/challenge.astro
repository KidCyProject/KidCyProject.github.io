---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import ChallengeShell from '@components/ChallengeShell.astro'
import HintPanel from '@components/HintPanel.astro'
import { useTranslations } from 'src/i18n/index'
import { toJsonScript } from '../../../utils/jsonScript'
import { AP_GOALS } from '../../../data/challengeAP'

const { t, v } = useTranslations(Astro.currentLocale)
const { v: vEn } = useTranslations('en')

type Hotspot = {
  id: string
  label: string
  explain: string
}

const rawHotspots = v<ReadonlyArray<Record<string, unknown>>>('challengeAP.hotspots') ?? []
const enHotspots = vEn<ReadonlyArray<Record<string, unknown>>>('challengeAP.hotspots') ?? []

const hotspotById = new Map<string, Hotspot>()
enHotspots.forEach((item) => {
  const id = String(item.id ?? '')
  hotspotById.set(id, { id, label: String(item.label ?? id), explain: String(item.explain ?? '') })
})
rawHotspots.forEach((item) => {
  const id = String(item.id ?? '')
  const prev = hotspotById.get(id)
  hotspotById.set(id, {
    id,
    label: String(item.label ?? prev?.label ?? id),
    explain: String(item.explain ?? prev?.explain ?? ''),
  })
})

const hs = (id: string) => hotspotById.get(id) ?? { id, label: id, explain: '' }
const attackerTargets = v<ReadonlyArray<string>>('challengeAP.attackerTargets') ?? []
// The address bar follows the profile handle of the current language (e.g. @martin123 in Czech)
const profileSlug = t('challengeAP.profile.handle').replace(/^@/, '')

// ── Parts 2 and 3 (plan the attack · why and how to stop it): texts by id, English filling any gap ──
type GoalText = { icon: string; title: string; hint: string }
type ClueText = { id: string; icon: string; text: string; explanation: string }
type MotivationText = { name: string; desc: string }
type MotiveCaseText = { id: number; text: string; explanation: string }
type DefendCaseText = { id: number; text: string; options: string[]; explanation: string }

const merge = <T extends { id: string | number }>(en: ReadonlyArray<T>, local: ReadonlyArray<T>): T[] =>
  en.map((item) => ({ ...item, ...local.find((other) => other.id === item.id) }))

const goalsEn = vEn<Record<string, GoalText>>('challengeAP.goals') ?? {}
const goalsLocal = v<Record<string, GoalText>>('challengeAP.goals') ?? {}
const goalTexts = Object.fromEntries(AP_GOALS.map((goal) => [goal, { ...goalsEn[goal], ...goalsLocal[goal] }])) as Record<string, GoalText>
const clues = merge(vEn<ReadonlyArray<ClueText>>('challengeAP.clues') ?? [], v<ReadonlyArray<ClueText>>('challengeAP.clues') ?? [])
const motivationsEn = vEn<Record<string, MotivationText>>('challengeAP.motivations') ?? {}
const motivationsLocal = v<Record<string, MotivationText>>('challengeAP.motivations') ?? {}
const motivations = Object.fromEntries(
  Object.keys(motivationsEn).map((id) => [id, { ...motivationsEn[id], ...motivationsLocal[id] }]),
) as Record<string, MotivationText>
const motiveCases = merge(vEn<ReadonlyArray<MotiveCaseText>>('challengeAP.motiveCases') ?? [], v<ReadonlyArray<MotiveCaseText>>('challengeAP.motiveCases') ?? [])
const defendCases = merge(vEn<ReadonlyArray<DefendCaseText>>('challengeAP.defendCases') ?? [], v<ReadonlyArray<DefendCaseText>>('challengeAP.defendCases') ?? [])

const planLabels = {
  part1Label: t('challengeAP.part1Label'),
  part2Label: t('challengeAP.part2Label'),
  part3Label: t('challengeAP.part3Label'),
  continueButton: t('challengeAP.continueButton'),
  planIntro: t('challengeAP.planIntro'),
  planChooseLabel: t('challengeAP.planChooseLabel'),
  planVoiceCorrect: t('challengeAP.planVoiceCorrect'),
  planVoiceWrong: t('challengeAP.planVoiceWrong'),
  planScoreTemplate: t('challengeAP.planScoreTemplate'),
  quizTitle: t('challengeAP.quizTitle'),
  quizProgressTemplate: t('challengeAP.quizProgressTemplate'),
  motiveLabel: t('challengeAP.motiveLabel'),
  defendLabel: t('challengeAP.defendLabel'),
  quizVoiceCorrect: t('challengeAP.quizVoiceCorrect'),
  quizVoiceWrong: t('challengeAP.quizVoiceWrong'),
  nextButton: t('challengeAP.nextButton'),
  resultsButton: t('challengeAP.resultsButton'),
  finalPart1Template: t('challengeAP.finalPart1Template'),
  finalPart2Template: t('challengeAP.finalPart2Template'),
  finalPart3Template: t('challengeAP.finalPart3Template'),
  finalScoreTemplate: t('challengeAP.finalScoreTemplate'),
  rankGreat: t('challengeAP.rankGreat'),
  rankGood: t('challengeAP.rankGood'),
  rankPractise: t('challengeAP.rankPractise'),
}
---

<DefaultLayout title={t('challengeAP.title')}>
  <script
    type="application/json"
    id="ap-challenge-data"
    set:html={toJsonScript({ clues, goals: goalTexts, motivations, motiveCases, defendCases, labels: planLabels })}
  />

  <ChallengeShell
    ns="challengeAP"
    brand="AP"
    layoutId="ap-layout"
    data-vulnerability-game=""
    data-vuln-empty={t('challengeAP.vulnerabilitiesEmpty')}
    data-win-title={t('challengeAP.winTitle')}
    data-win-msg={t('challengeAP.winMsg')}
    data-lose-title={t('challengeAP.loseTitle')}
    data-lose-msg-template={t('challengeAP.loseMsgTemplate')}
    data-voice-initial={t('challengeAP.attackerVoiceInitial')}
    data-voice-win-template={t('challengeAP.attackerVoiceWin')}
    data-voice-lose={t('challengeAP.attackerVoiceLose')}
    data-voice-already-tagged-template={t('challengeAP.attackerVoiceAlreadyTagged')}
    data-voice-correct-template={t('challengeAP.attackerVoiceCorrect')}
    data-voice-wrong-template={t('challengeAP.attackerVoiceWrong')}
  >

    <!-- ── Main: the three parts of the challenge ───────────────────────────── -->
    <p class="ap-part ch-badge ch-badge--plain" data-part-label></p>

    <!-- Attacker voice: shows the explanation after every click -->
    <div class="attacker-bar mb-4" id="attacker-bar" role="status" aria-live="polite">
      <span class="attacker-icon" aria-hidden="true">🕵️</span>
      <p class="attacker-text" id="attacker-voice"></p>
    </div>

    <!-- Part 1: mock browser window -->
    <div data-part-area="1">
    <div class="browser-window">

      <!-- Browser chrome (dark) -->
      <div class="browser-chrome">
        <div class="browser-dots">
          <span class="bdot bdot-red"></span>
          <span class="bdot bdot-yellow"></span>
          <span class="bdot bdot-green"></span>
        </div>
        <!-- Address bar — HOTSPOT: HTTP (correct) -->
        <button
          class="address-bar hotspot-btn"
          data-id="http"
          data-correct="true"
          data-label={hs('http').label}
          data-explain={hs('http').explain}
        >
          <span class="addr-lock">🔓</span>
          <span class="addr-url">http://socialmedia-insecure.com/profile/{profileSlug}</span>
        </button>
      </div>

      <!-- Profile page (white background) -->
      <div class="profile-page">

        <!-- Site menu bar — HOTSPOT: navbar (wrong) -->
        <button
          class="site-nav hotspot-btn"
          data-id="navbar"
          data-correct="false"
          data-label={hs('navbar').label}
          data-explain={hs('navbar').explain}
        >
          <span class="nav-logo"><span class="nav-logo-mark" aria-hidden="true">🐝</span>BuzzNest</span>
          <span class="nav-search"><span aria-hidden="true">🔍</span>{t('challengeAP.profile.navSearch')}</span>
          <span class="nav-icons" aria-hidden="true"><span>🏠</span><span>👥</span><span>💬</span><span class="nav-bell">🔔</span></span>
        </button>

        <!-- Profile header -->
        <div class="profile-head">

          <!-- Cover photo — HOTSPOT: cover (wrong) -->
          <button
            class="cover-btn hotspot-btn"
            data-id="cover"
            data-correct="false"
            data-label={hs('cover').label}
            data-explain={hs('cover').explain}
            aria-label={hs('cover').label}
          >
            <span class="cover-art" aria-hidden="true">
              <span class="cover-shape cover-shape--a"></span>
              <span class="cover-shape cover-shape--b"></span>
              <span class="cover-shape cover-shape--c"></span>
              <span class="cover-emoji">🎮 ⚽ 🍕</span>
            </span>
          </button>

          <div class="head-row">

            <!-- Avatar — HOTSPOT: avatar (wrong) -->
            <button
              class="avatar-wrap hotspot-btn"
              data-id="avatar"
              data-correct="false"
              data-label={hs('avatar').label}
              data-explain={hs('avatar').explain}
            >
              <span class="p-avatar">👤</span>
            </button>

            <div class="head-info">

              <!-- Name & handle — HOTSPOT: username (wrong) -->
              <button
                class="name-btn hotspot-btn"
                data-id="username"
                data-correct="false"
                data-label={hs('username').label}
                data-explain={hs('username').explain}
              >
                <span class="display-name">{t('challengeAP.profile.displayName')}</span>
                <span class="handle">{t('challengeAP.profile.handle')}</span>
              </button>

              <!-- Online status — HOTSPOT: online (wrong) -->
              <button
                class="status-btn hotspot-btn"
                data-id="online"
                data-correct="false"
                data-label={hs('online').label}
                data-explain={hs('online').explain}
              >
                <span class="online-dot"></span>
                <span class="status-label">{t('challengeAP.profile.statusActiveNow')}</span>
              </button>

              <!-- Bio — HOTSPOT: bio (wrong) -->
              <button
                class="bio-btn hotspot-btn"
                data-id="bio"
                data-correct="false"
                data-label={hs('bio').label}
                data-explain={hs('bio').explain}
              >
                <span class="bio-text">{t('challengeAP.profile.bioText')}</span>
              </button>

              <!-- Game badges — HOTSPOT: badges (wrong) -->
              <button
                class="badges-btn hotspot-btn"
                data-id="badges"
                data-correct="false"
                data-label={hs('badges').label}
                data-explain={hs('badges').explain}
              >
                <span class="badge-pill badge-pill--lvl">{t('challengeAP.profile.badge1')}</span>
                <span class="badge-pill badge-pill--top">{t('challengeAP.profile.badge2')}</span>
                <span class="badge-pill badge-pill--streak">{t('challengeAP.profile.badge3')}</span>
              </button>

              <!-- Follower stats — HOTSPOT: followers (wrong) -->
              <button
                class="stats-btn hotspot-btn"
                data-id="followers"
                data-correct="false"
                data-label={hs('followers').label}
                data-explain={hs('followers').explain}
              >
                <span class="stat-item"><strong>126</strong> {t('challengeAP.profile.statsPostsLabel')}</span>
                <span class="stat-sep">·</span>
                <span class="stat-item"><strong>847</strong> {t('challengeAP.profile.statsFriendsLabel')}</span>
                <span class="stat-sep">·</span>
                <span class="stat-item"><strong>312</strong> {t('challengeAP.profile.statsFollowingLabel')}</span>
              </button>

            </div>

            <!-- Follow / message buttons — HOTSPOT: followbtn (wrong) -->
            <button
              class="follow-btn hotspot-btn"
              data-id="followbtn"
              data-correct="false"
              data-label={hs('followbtn').label}
              data-explain={hs('followbtn').explain}
            >
              <span class="fbtn fbtn--primary">＋ {t('challengeAP.profile.actionFollow')}</span>
              <span class="fbtn">✉️ {t('challengeAP.profile.actionMessage')}</span>
            </button>
          </div>

          <!-- Profile tabs — HOTSPOT: tabs (wrong) -->
          <button
            class="tabs-btn hotspot-btn"
            data-id="tabs"
            data-correct="false"
            data-label={hs('tabs').label}
            data-explain={hs('tabs').explain}
          >
            <span class="tab tab--active">{t('challengeAP.profile.tabPosts')}</span>
            <span class="tab">{t('challengeAP.profile.aboutTitle')}</span>
            <span class="tab">{t('challengeAP.profile.tabPhotos')}</span>
            <span class="tab">{t('challengeAP.profile.tabFriends')}</span>
          </button>
        </div>

        <!-- Profile body: two-column layout -->
        <div class="profile-body">

          <!-- Left: About, interests, friends -->
          <div class="profile-left">

            <!-- About card -->
            <div class="info-card">
              <h3 class="info-card-title">{t('challengeAP.profile.aboutTitle')}</h3>

              <!-- Birthday — HOTSPOT: birthday (correct) -->
              <button
                class="info-row hotspot-btn"
                data-id="birthday"
                data-correct="true"
                data-label={hs('birthday').label}
                data-explain={hs('birthday').explain}
              >
                <span class="row-icon">🎂</span>
                <span class="row-text">{t('challengeAP.profile.bornText')}</span>
              </button>

              <!-- Email — HOTSPOT: email (wrong) -->
              <button
                class="info-row hotspot-btn"
                data-id="email"
                data-correct="false"
                data-label={hs('email').label}
                data-explain={hs('email').explain}
              >
                <span class="row-icon">✉️</span>
                <span class="row-text">{t('challengeAP.profile.emailText')}</span>
              </button>

              <!-- Join date — HOTSPOT: joined (wrong) -->
              <button
                class="info-row hotspot-btn"
                data-id="joined"
                data-correct="false"
                data-label={hs('joined').label}
                data-explain={hs('joined').explain}
              >
                <span class="row-icon">📅</span>
                <span class="row-text">{t('challengeAP.profile.joinedText')}</span>
              </button>

              <!-- Pet Name — HOTSPOT: petname (correct) -->
              <button
                class="info-row hotspot-btn"
                data-id="petname"
                data-correct="true"
                data-label={hs('petname').label}
                data-explain={hs('petname').explain}
              >
                <span class="row-icon">🐱</span>
                <span class="row-text">{t('challengeAP.profile.petNameText')}</span>
              </button>
            </div>

            <!-- Interests card -->
            <div class="info-card">
              <h3 class="info-card-title">{t('challengeAP.profile.interestsTitle')}</h3>

              <!-- Interest tags — HOTSPOT: interests (wrong) -->
              <button
                class="chips-btn hotspot-btn"
                data-id="interests"
                data-correct="false"
                data-label={hs('interests').label}
                data-explain={hs('interests').explain}
              >
                <span class="chip chip--1">⛏️ {t('challengeAP.profile.interest1')}</span>
                <span class="chip chip--2">📚 {t('challengeAP.profile.interest2')}</span>
                <span class="chip chip--3">⚽ {t('challengeAP.profile.interest3')}</span>
                <span class="chip chip--4">🍕 {t('challengeAP.profile.interest4')}</span>
              </button>
            </div>

            <!-- Friends card -->
            <div class="info-card">
              <h3 class="info-card-title">{t('challengeAP.profile.statsFriendsLabel')} <span class="title-count">847</span></h3>

              <!-- Friends preview — HOTSPOT: friendsPreview (wrong) -->
              <button
                class="friends-btn hotspot-btn"
                data-id="friendsPreview"
                data-correct="false"
                data-label={hs('friendsPreview').label}
                data-explain={hs('friendsPreview').explain}
                aria-label={hs('friendsPreview').label}
              >
                <span class="friend-grid" aria-hidden="true">
                  <span class="friend friend--1">🧑‍🎤</span>
                  <span class="friend friend--2">👩‍🎓</span>
                  <span class="friend friend--3">🧑‍💻</span>
                  <span class="friend friend--4">🧒</span>
                  <span class="friend friend--5">👧</span>
                  <span class="friend friend--6">🧑‍🚀</span>
                </span>
              </button>
            </div>

          </div>

          <!-- Right: Posts feed -->
          <div class="profile-right">

            <!-- Post 1: real-time location — HOTSPOT: location (correct) -->
            <button
              class="post-card hotspot-btn"
              data-id="location"
              data-correct="true"
              data-label={hs('location').label}
              data-explain={hs('location').explain}
            >
              <div class="post-header-row">
                <span class="post-av">👤</span>
                <div class="post-meta">
                  <p class="post-uname">{t('challengeAP.profile.displayName')}</p>
                  <p class="post-time">{t('challengeAP.profile.post1Time')}</p>
                </div>
                <span class="post-more" aria-hidden="true">•••</span>
              </div>
              <p class="post-body">{t('challengeAP.profile.post1Body')}</p>
              <span class="post-map">
                <span class="map-pulse" aria-hidden="true"></span>
                <span class="map-pin" aria-hidden="true">📍</span>
                <span class="map-badge">{t('challengeAP.profile.post1Badge')}</span>
              </span>
            </button>
            <div class="post-actions-bar">
              <!-- Like button post 1 — HOTSPOT: like1 (wrong) -->
              <button
                class="action-btn hotspot-btn"
                data-id="like1"
                data-correct="false"
                data-label={hs('like1').label}
                data-explain={hs('like1').explain}
              >
                👍 {t('challengeAP.profile.actionLike')} <span class="act-count">24</span>
              </button>
              <!-- Comment button post 1 — HOTSPOT: comment1 (wrong) -->
              <button
                class="action-btn hotspot-btn"
                data-id="comment1"
                data-correct="false"
                data-label={hs('comment1').label}
                data-explain={hs('comment1').explain}
              >
                💬 {t('challengeAP.profile.actionComment')} <span class="act-count">8</span>
              </button>
              <!-- Share button post 1 — HOTSPOT: share1 (wrong) -->
              <button
                class="action-btn hotspot-btn"
                data-id="share1"
                data-correct="false"
                data-label={hs('share1').label}
                data-explain={hs('share1').explain}
              >
                ↗️ {t('challengeAP.profile.actionShare')}
              </button>
            </div>

            <!-- Post 2: generic — HOTSPOT: post2 (wrong) -->
            <button
              class="post-card hotspot-btn"
              data-id="post2"
              data-correct="false"
              data-label={hs('post2').label}
              data-explain={hs('post2').explain}
            >
              <div class="post-header-row">
                <span class="post-av">👤</span>
                <div class="post-meta">
                  <p class="post-uname">{t('challengeAP.profile.displayName')}</p>
                  <p class="post-time">{t('challengeAP.profile.post2Time')}</p>
                </div>
                <span class="post-more" aria-hidden="true">•••</span>
              </div>
              <p class="post-body">{t('challengeAP.profile.post2Body')}</p>
            </button>
            <div class="post-actions-bar">
              <!-- Like button post 2 — HOTSPOT: like2 (wrong) -->
              <button
                class="action-btn hotspot-btn"
                data-id="like2"
                data-correct="false"
                data-label={hs('like2').label}
                data-explain={hs('like2').explain}
              >
                👍 {t('challengeAP.profile.actionLike')} <span class="act-count">41</span>
              </button>
              <!-- Comment button post 2 — HOTSPOT: comment2 (wrong) -->
              <button
                class="action-btn hotspot-btn"
                data-id="comment2"
                data-correct="false"
                data-label={hs('comment2').label}
                data-explain={hs('comment2').explain}
              >
                💬 {t('challengeAP.profile.actionComment')} <span class="act-count">15</span>
              </button>
            </div>

            <!-- Post 3: gaming photo — HOTSPOT: post3 (wrong) -->
            <button
              class="post-card hotspot-btn"
              data-id="post3"
              data-correct="false"
              data-label={hs('post3').label}
              data-explain={hs('post3').explain}
            >
              <div class="post-header-row">
                <span class="post-av">👤</span>
                <div class="post-meta">
                  <p class="post-uname">{t('challengeAP.profile.displayName')}</p>
                  <p class="post-time">{t('challengeAP.profile.post3Time')}</p>
                </div>
                <span class="post-more" aria-hidden="true">•••</span>
              </div>
              <p class="post-body">{t('challengeAP.profile.post3Body')}</p>
              <span class="post-photo" aria-hidden="true">
                <span class="post-photo-emoji">🕹️</span>
                <span class="score-badge">🏆 {t('challengeAP.profile.post3Score')}</span>
              </span>
            </button>
            <div class="post-actions-bar">
              <!-- Like button post 3 — HOTSPOT: like3 (wrong; same text as the other like buttons) -->
              <button
                class="action-btn hotspot-btn"
                data-id="like3"
                data-correct="false"
                data-label={hs('like1').label}
                data-explain={hs('like1').explain}
              >
                👍 {t('challengeAP.profile.actionLike')} <span class="act-count">57</span>
              </button>
              <!-- Comment button post 3 — HOTSPOT: comment3 (wrong) -->
              <button
                class="action-btn hotspot-btn"
                data-id="comment3"
                data-correct="false"
                data-label={hs('comment1').label}
                data-explain={hs('comment1').explain}
              >
                💬 {t('challengeAP.profile.actionComment')} <span class="act-count">21</span>
              </button>
              <!-- Share button post 3 — HOTSPOT: share3 (wrong) -->
              <button
                class="action-btn hotspot-btn"
                data-id="share3"
                data-correct="false"
                data-label={hs('share1').label}
                data-explain={hs('share1').explain}
              >
                ↗️ {t('challengeAP.profile.actionShare')}
              </button>
            </div>

          </div>
        </div>
      </div>
    </div>
    </div><!-- /part 1 -->

    <!-- Part 2: plan the attack -->
    <div data-part-area="2" hidden>
      <div class="ch-card">
        <h2 class="ch-title" id="plan-title" tabindex="-1">{t('challengeAP.planTitle')}</h2>
        <p class="ap-card__intro">{t('challengeAP.planIntro')}</p>

        <div class="plan-board">
          <div class="plan-tray">
            <h3 class="plan-tray__title">{t('challengeAP.planTrayTitle')}</h3>
            <div class="plan-tray__list" data-plan-tray></div>
          </div>

          <div class="plan-zones">
            {AP_GOALS.map((goal) => (
              <div class={`plan-zone plan-zone--${goal}`}>
                <button type="button" class="plan-zone__btn" data-goal={goal}>
                  <span class="plan-zone__icon" aria-hidden="true">{goalTexts[goal]?.icon}</span>
                  <span class="plan-zone__text">
                    <strong class="plan-zone__title">{goalTexts[goal]?.title}</strong>
                    <span class="plan-zone__hint">{goalTexts[goal]?.hint}</span>
                  </span>
                </button>
                <ul class="plan-zone__list" data-goal-list={goal}></ul>
              </div>
            ))}
          </div>
        </div>

        <div class="ch-feedback ch-feedback--ok plan-summary" data-plan-summary hidden>
          <h3 class="plan-summary__title">{t('challengeAP.planSummaryTitle')}</h3>
          <p>{t('challengeAP.planSummaryText')}</p>
          <p class="plan-summary__score" data-plan-score></p>
          <button type="button" class="ch-btn ch-btn--primary" data-to-quiz>{t('challengeAP.toQuizButton')}</button>
        </div>
      </div>
    </div>

    <!-- Part 3: why, and how to stop it -->
    <div data-part-area="3" hidden>
      <div class="ch-card">
        <h2 class="ch-title" id="quiz-title" tabindex="-1">{t('challengeAP.quizTitle')}</h2>
        <p class="quiz-progress" data-quiz-progress></p>
        <p class="quiz-kind" data-quiz-kind></p>
        <p class="quiz-text" id="quiz-text" data-quiz-text></p>
        <div class="quiz-options" data-quiz-options role="group" aria-labelledby="quiz-text"></div>
        <button type="button" class="ch-btn ch-btn--primary quiz-next" data-quiz-next hidden></button>
      </div>
    </div>

    <!-- Results -->
    <div data-part-area="4" hidden>
      <div class="ch-card ch-result">
        <div class="ch-result__icon" aria-hidden="true">🕵️</div>
        <h2 class="ch-result__title" id="final-title" tabindex="-1">{t('challengeAP.finalTitle')}</h2>
        <div class="ch-result__score">
          <p class="ch-result__highlight" data-final-score></p>
        </div>
        <ul class="ap-final__list">
          <li data-final-part="1"></li>
          <li data-final-part="2"></li>
          <li data-final-part="3"></li>
        </ul>
        <p class="ap-final__message" data-final-message></p>
        <button type="button" class="ch-btn ch-btn--primary" data-play-again>{t('challengeAP.tryAgain')}</button>
      </div>
    </div>

    <!-- Templates cloned by the script (cloning keeps the scoped-style attributes) -->
    <template data-plan-chip-template>
      <button type="button" class="plan-chip" aria-pressed="false">
        <span class="plan-chip__icon" aria-hidden="true"></span>
        <span class="plan-chip__text"></span>
      </button>
    </template>
    <template data-plan-item-template>
      <li class="plan-zone__item">
        <span aria-hidden="true"></span>
        <span></span>
      </li>
    </template>
    <template data-quiz-option-template>
      <button type="button" class="quiz-option"></button>
    </template>

    <!-- ── Side column (above the game on phones) ───────────────────────────── -->
    <Fragment slot="side">

      <!-- Lives and found counter (part 1 only) -->
      <div class="ch-card ap-status" data-part-only="1">
        <div class="ch-block">
          <h3 class="ch-card__title">{t('challengeAP.livesTitle')}</h3>
          <p class="ch-card__sub">{t('challengeAP.livesDesc')}</p>
          <div class="lives-row mt-3">
            <span class="life-icon" id="life-1">❤️</span>
            <span class="life-icon" id="life-2">❤️</span>
            <span class="life-icon" id="life-3">❤️</span>
          </div>
        </div>

        <div class="ch-block">
          <h3 class="ch-block__title">{t('challengeAP.vulnerabilitiesFoundTitle')}</h3>
          <div class="ch-stat">
            <span class="ch-stat__value" id="found-count">0</span>
            <span class="ch-stat__of">{t('challengeAP.vulnerabilitiesCount')}</span>
          </div>
          <ul class="vuln-list mt-3" id="found-list">
            <li class="vuln-empty">{t('challengeAP.vulnerabilitiesEmpty')}</li>
          </ul>
        </div>
      </div>

      <!-- What attackers target (parts 1, 2 and the results): collapsed on phones -->
      <div data-help-for="1 2 4">
        <HintPanel title={t('challengeAP.attackerTargetsTitle')}>
          {attackerTargets.map((item) => (
            <div class="ch-note ch-note--bad">{item}</div>
          ))}
        </HintPanel>
      </div>

      <!-- Why attackers attack (part 3) -->
      <div data-help-for="3" hidden>
        <HintPanel title={t('challengeAP.motivationsTitle')} subtitle={t('challengeAP.motivationsSubtitle')}>
          {Object.values(motivations).map((motivation) => (
            <div class="text-sm">
              <strong>{motivation.name}</strong> — {motivation.desc}
            </div>
          ))}
        </HintPanel>
      </div>
    </Fragment>

    <!-- Game-end overlay -->
    <Fragment slot="after">
      <div class="ch-overlay hidden" id="game-overlay" role="dialog" aria-modal="true" aria-labelledby="overlay-title" aria-describedby="overlay-msg">
        <div class="ch-overlay__card ch-result">
          <div class="ch-result__icon" id="overlay-icon">🎉</div>
          <h2 class="ch-result__title" id="overlay-title">…</h2>
          <p class="ch-result__text" id="overlay-msg">…</p>
          <div class="ch-result__score ch-result__score--auto">
            <div class="ch-stat justify-center">
              <span class="ch-result__number ch-result__number--sm" id="overlay-found">0</span>
              <span class="ch-stat__of">{t('challengeAP.vulnFoundSuffix')}</span>
            </div>
          </div>
          <div class="ch-result__actions">
            <button type="button" class="ch-btn ch-btn--primary" id="continue-btn">{t('challengeAP.continueButton')}</button>
            <button type="button" class="ch-btn ch-btn--secondary" id="reset-btn">{t('challengeAP.tryAgain')}</button>
          </div>
        </div>
      </div>
    </Fragment>
  </ChallengeShell>

  <style>

    /* ── Attacker voice bar ────────────────────────────────────────────────── */
    .attacker-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #1e1b4b;
      border: 1px solid #4338ca;
      border-radius: 10px;
      padding: 12px 16px;
      min-height: 5.5rem;
      transition: background 0.4s ease, border-color 0.4s ease;
    }

    .attacker-bar.bar-correct {
      background: #14532d;
      border-color: #22c55e;
    }

    .attacker-bar.bar-wrong {
      background: #7f1d1d;
      border-color: #ef4444;
    }

    .attacker-icon { font-size: 1.4rem; flex-shrink: 0; }

    .attacker-text {
      font-size: 0.875rem;
      font-weight: 500;
      color: #c7d2fe;
      font-family: 'Courier New', monospace;
      margin: 0;
      line-height: 1.5;
      transition: color 0.4s ease;
    }

    .attacker-bar.bar-correct .attacker-text { color: #86efac; }
    .attacker-bar.bar-wrong  .attacker-text { color: #fca5a5; }

    /* ── Browser window ────────────────────────────────────────────────────── */
    .browser-window {
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
      border: 1px solid #d1d5db;
    }

    .browser-chrome {
      background: #2d2d2d;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .browser-dots { display: flex; gap: 6px; }
    .bdot { width: 12px; height: 12px; border-radius: 50%; }
    .bdot-red    { background: #ff5f57; }
    .bdot-yellow { background: #febc2e; }
    .bdot-green  { background: #28c840; }

    /* Address bar (dark context — special hotspot styling) */
    .address-bar {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 8px;
      background: #1a1a1a;
      border: 1.5px solid #555;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 0.78rem;
      color: #e5e5e5;
      font-family: 'Courier New', monospace;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
      min-width: 0;
    }

    .address-bar:hover:not([data-found]) {
      background: #222;
      border-color: #888;
    }

    .address-bar[data-found="true"] {
      background: rgba(34, 197, 94, 0.18) !important;
      border-color: #22c55e !important;
    }

    .addr-lock { font-size: 0.85rem; flex-shrink: 0; }
    .addr-url  { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ── Profile page ──────────────────────────────────────────────────────── */
    .profile-page {
      background: #eef0f6;
    }

    /* Site menu bar */
    .site-nav {
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
      padding: 8px 16px;
      background: white;
      border: 2px solid transparent;
      border-bottom: 1px solid #e5e7eb;
      cursor: pointer;
      font: inherit;
      color: inherit;
      text-align: left;
      transition: background 0.15s, border-color 0.15s;
    }

    .site-nav:hover:not([data-found]) { background: #faf8ff; }

    .nav-logo {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-weight: 800;
      font-size: 1rem;
      color: #6d28d9;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }

    .nav-logo-mark {
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: linear-gradient(135deg, #c4b5fd, #7c3aed);
      font-size: 0.85rem;
    }

    .nav-search {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 8px;
      max-width: 340px;
      min-width: 0;
      padding: 6px 12px;
      border-radius: 999px;
      background: #f1f3f9;
      color: #6b7280;
      font-size: 0.78rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .nav-icons { margin-left: auto; display: flex; gap: 6px; }

    .nav-icons > span {
      position: relative;
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #f1f3f9;
      font-size: 0.9rem;
    }

    .nav-bell::after {
      content: '';
      position: absolute;
      top: -1px;
      right: -1px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ef4444;
      border: 2px solid white;
    }

    @media (max-width: 520px) {
      .nav-icons > span:nth-child(-n+2) { display: none; }
    }

    /* Profile head */
    .profile-head {
      background: white;
      border-bottom: 1px solid #e5e7eb;
    }

    .cover-btn {
      display: block;
      position: relative;
      width: 100%;
      height: 120px;
      padding: 0;
      border: 2px solid transparent;
      border-radius: 0;
      background: none;
      overflow: hidden;
      cursor: pointer;
    }

    .cover-art {
      position: absolute;
      inset: 0;
      display: block;
      background: linear-gradient(120deg, #4c1d95 0%, #7c3aed 48%, #38bdf8 100%);
      transition: filter 0.2s;
    }

    .cover-btn:hover:not([data-found]) .cover-art { filter: brightness(1.08); }

    .cover-shape { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }
    .cover-shape--a { width: 190px; height: 190px; right: -40px; top: -80px; }
    .cover-shape--b { width: 110px; height: 110px; right: 150px; bottom: -64px; background: rgba(255, 255, 255, 0.1); }
    .cover-shape--c { width: 74px; height: 74px; left: 32%; top: -28px; background: rgba(0, 0, 0, 0.08); }

    .cover-emoji {
      position: absolute;
      right: 18px;
      bottom: 10px;
      font-size: 1.5rem;
      letter-spacing: 0.35rem;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
    }

    .head-row {
      display: flex;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 6px 16px;
      padding: 0 20px 12px;
    }

    .avatar-wrap {
      position: relative;
      margin-top: -46px;
      flex-shrink: 0;
      background: none;
      padding: 2px;
      border: 2px solid transparent;
      border-radius: 50%;
      cursor: pointer;
      transition: border-color 0.2s;
    }

    .avatar-wrap:hover:not([data-found]) { border-color: rgba(0,0,0,0.12); }
    .avatar-wrap[data-found="true"]      { border-color: #22c55e; }

    .p-avatar {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 92px;
      height: 92px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c4b5fd, #6d28d9);
      border: 4px solid white;
      font-size: 2.4rem;
      box-shadow: 0 4px 14px rgba(76, 29, 149, 0.3);
    }

    .p-avatar::after {
      content: '';
      position: absolute;
      right: 2px;
      bottom: 4px;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: #22c55e;
      border: 3px solid white;
    }

    .head-info {
      flex: 1;
      min-width: 220px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding-top: 8px;
    }

    /* Generic head button */
    .name-btn, .status-btn, .bio-btn, .stats-btn, .badges-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: none;
      border: 2px solid transparent;
      border-radius: 6px;
      cursor: pointer;
      padding: 2px 6px;
      text-align: left;
      font: inherit;
      color: inherit;
      transition: background 0.15s, border-color 0.15s;
      width: fit-content;
    }

    .name-btn:hover:not([data-found]),
    .status-btn:hover:not([data-found]),
    .bio-btn:hover:not([data-found]),
    .stats-btn:hover:not([data-found]),
    .badges-btn:hover:not([data-found]),
    .follow-btn:hover:not([data-found]),
    .tabs-btn:hover:not([data-found]),
    .chips-btn:hover:not([data-found]),
    .friends-btn:hover:not([data-found]) {
      background: rgba(0,0,0,0.04);
      border-color: rgba(0,0,0,0.08);
    }

    .display-name { font-weight: 800; font-size: 1.3rem; color: #111827; letter-spacing: -0.01em; }
    .handle       { color: #6b7280; font-size: 0.85rem; }

    .online-dot   { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; flex-shrink: 0; }
    .status-label { font-size: 0.8rem; color: #6b7280; }

    .bio-text  { font-size: 0.875rem; color: #374151; }
    .stat-item { font-size: 0.825rem; color: #6b7280; }
    .stat-item strong { color: #111827; }
    .stat-sep  { color: #d1d5db; font-size: 0.825rem; }

    .badges-btn { flex-wrap: wrap; gap: 6px; }

    .badge-pill {
      display: inline-flex;
      align-items: center;
      padding: 2px 9px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .badge-pill--lvl    { background: #ede9fe; color: #5b21b6; }
    .badge-pill--top    { background: #fef3c7; color: #92400e; }
    .badge-pill--streak { background: #ffe4e6; color: #9f1239; }

    /* Follow / message buttons */
    .follow-btn {
      display: inline-flex;
      align-items: center;
      align-self: flex-end;
      gap: 8px;
      margin-bottom: 4px;
      padding: 3px;
      background: none;
      border: 2px solid transparent;
      border-radius: 999px;
      cursor: pointer;
      font: inherit;
      transition: background 0.15s, border-color 0.15s;
    }

    .fbtn {
      padding: 7px 16px;
      border-radius: 999px;
      background: #f1f3f9;
      color: #374151;
      font-size: 0.8rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .fbtn--primary {
      background: linear-gradient(135deg, #7c3aed, #6d28d9);
      color: white;
      box-shadow: 0 2px 8px rgba(109, 40, 217, 0.3);
    }

    /* Profile tabs */
    .tabs-btn {
      display: flex;
      gap: 4px;
      width: 100%;
      padding: 0 14px;
      background: none;
      border: 2px solid transparent;
      border-top: 1px solid #eef0f4;
      border-radius: 0;
      cursor: pointer;
      font: inherit;
      text-align: left;
      overflow-x: auto;
      transition: background 0.15s, border-color 0.15s;
    }

    .tab {
      padding: 10px 14px;
      border-bottom: 3px solid transparent;
      color: #6b7280;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .tab--active { color: #6d28d9; border-bottom-color: #7c3aed; }

    /* ── Profile body grid ─────────────────────────────────────────────────── */
    .profile-body {
      display: grid;
      grid-template-columns: 230px 1fr;
      gap: 12px;
      padding: 12px;
    }

    @media (max-width: 680px) {
      .profile-body { grid-template-columns: 1fr; }
    }

    .profile-left { display: flex; flex-direction: column; }

    /* ── Info cards ────────────────────────────────────────────────────────── */
    .info-card {
      background: white;
      border-radius: 12px;
      padding: 14px 14px 10px;
      margin-bottom: 12px;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 2px 8px rgba(16, 24, 40, 0.04);
    }

    .info-card-title {
      font-weight: 700;
      font-size: 0.875rem;
      color: #374151;
      margin-bottom: 6px;
      padding-bottom: 6px;
      border-bottom: 1px solid #f3f4f6;
    }

    .title-count { margin-left: 4px; color: #9ca3af; font-weight: 600; }

    .info-row {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 4px;
      font-size: 0.85rem;
      color: #374151;
      background: none;
      border: 2px solid transparent;
      border-radius: 8px;
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: background 0.15s, border-color 0.15s;
      margin-bottom: 2px;
    }

    .info-row:hover:not([data-found]) {
      background: rgba(0,0,0,0.03);
      border-color: rgba(0,0,0,0.06);
    }

    .row-icon {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: #f5f3ff;
      font-size: 0.95rem;
    }

    .row-text { font-size: 0.85rem; }

    /* Interest tags */
    .chips-btn {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      width: 100%;
      margin-bottom: 4px;
      padding: 4px;
      background: none;
      border: 2px solid transparent;
      border-radius: 8px;
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: background 0.15s, border-color 0.15s;
    }

    .chip { padding: 3px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; }
    .chip--1 { background: #ede9fe; color: #5b21b6; }
    .chip--2 { background: #fce7f3; color: #9d174d; }
    .chip--3 { background: #dcfce7; color: #166534; }
    .chip--4 { background: #ffedd5; color: #9a3412; }

    /* Friends preview */
    .friends-btn {
      display: block;
      width: 100%;
      margin-bottom: 4px;
      padding: 4px;
      background: none;
      border: 2px solid transparent;
      border-radius: 8px;
      cursor: pointer;
      font: inherit;
      transition: background 0.15s, border-color 0.15s;
    }

    .friend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }

    .friend {
      display: grid;
      place-items: center;
      aspect-ratio: 1;
      border-radius: 10px;
      font-size: 1.3rem;
    }

    .friend--1 { background: linear-gradient(135deg, #fde68a, #f59e0b); }
    .friend--2 { background: linear-gradient(135deg, #fbcfe8, #ec4899); }
    .friend--3 { background: linear-gradient(135deg, #bae6fd, #0ea5e9); }
    .friend--4 { background: linear-gradient(135deg, #bbf7d0, #22c55e); }
    .friend--5 { background: linear-gradient(135deg, #ddd6fe, #8b5cf6); }
    .friend--6 { background: linear-gradient(135deg, #fed7aa, #f97316); }

    /* ── Posts ─────────────────────────────────────────────────────────────── */
    .profile-right { display: flex; flex-direction: column; }

    .post-card {
      background: white;
      border-radius: 12px 12px 0 0;
      padding: 14px;
      width: 100%;
      text-align: left;
      cursor: pointer;
      border: 2px solid transparent;
      border-bottom: none;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 2px 8px rgba(16, 24, 40, 0.04);
      transition: background 0.15s, border-color 0.15s;
      display: block;
      font: inherit;
      color: inherit;
    }

    .post-card:hover:not([data-found]) { background: #fafafa; }

    .post-header-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }

    .post-av {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c4b5fd, #6d28d9);
      font-size: 1.1rem;
    }

    .post-more  { margin-left: auto; color: #9ca3af; font-weight: 700; letter-spacing: 0.1em; }
    .post-uname { font-weight: 600; font-size: 0.875rem; color: #111827; line-height: 1.2; }
    .post-time  { font-size: 0.75rem; color: #6b7280; }
    .post-body  { font-size: 0.875rem; color: #374151; line-height: 1.5; margin-bottom: 10px; }

    /* Live location: a small map with a pulsing pin */
    .post-map {
      position: relative;
      display: block;
      height: 104px;
      border-radius: 10px;
      border: 1px solid #dbe4d6;
      overflow: hidden;
      background:
        linear-gradient(100deg, transparent 0 30%, #ffffff 30% 34%, transparent 34% 100%),
        linear-gradient(0deg, transparent 0 38%, #ffffff 38% 44%, transparent 44% 100%),
        linear-gradient(28deg, transparent 0 62%, #fbeab0 62% 66%, transparent 66% 100%),
        radial-gradient(circle at 82% 26%, #cfe8c8 0 22%, transparent 23%),
        radial-gradient(circle at 10% 82%, #bfdcf2 0 18%, transparent 19%),
        #e9efe4;
    }

    .map-pulse {
      position: absolute;
      left: 42%;
      top: 62%;
      width: 14px;
      height: 14px;
      margin: -7px 0 0 -7px;
      border-radius: 50%;
      background: rgba(239, 68, 68, 0.35);
      animation: mapPulse 1.8s ease-out infinite;
    }

    @keyframes mapPulse {
      0%   { transform: scale(0.6); opacity: 0.9; }
      100% { transform: scale(3.2); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .map-pulse { animation: none; }
    }

    .map-pin {
      position: absolute;
      left: 42%;
      top: 62%;
      z-index: 1;
      font-size: 1.5rem;
      line-height: 1;
      transform: translate(-50%, -92%);
      filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.3));
    }

    .map-badge {
      position: absolute;
      left: 10px;
      bottom: 8px;
      max-width: calc(100% - 20px);
      padding: 4px 10px;
      border-radius: 999px;
      background: white;
      color: #374151;
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
    }

    /* Gaming post: a "photo" with a score */
    .post-photo {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 120px;
      border-radius: 10px;
      overflow: hidden;
      background: linear-gradient(135deg, #1e1b4b, #4c1d95 55%, #be185d);
    }

    .post-photo-emoji { font-size: 2.6rem; filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4)); }

    .score-badge {
      position: absolute;
      right: 10px;
      bottom: 8px;
      padding: 3px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.18);
      color: white;
      font-family: 'Courier New', monospace;
      font-size: 0.78rem;
      font-weight: 800;
    }

    .post-actions-bar {
      background: white;
      border-radius: 0 0 12px 12px;
      padding: 4px 10px;
      display: flex;
      gap: 2px;
      border-top: 1px solid #f3f4f6;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 2px 8px rgba(16, 24, 40, 0.04);
      margin-bottom: 12px;
    }

    .action-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 6px 4px;
      font-size: 0.8rem;
      font-weight: 600;
      white-space: nowrap;
      color: #6b7280;
      background: none;
      border: 2px solid transparent;
      border-radius: 6px;
      cursor: pointer;
      font: inherit;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }

    .action-btn:hover:not([data-found]) {
      background: #f3f4f6;
      color: #374151;
    }

    .act-count { color: #6b7280; font-weight: 400; }

    /* ── Universal found / wrong states ───────────────────────────────────── */
    .hotspot-btn[data-found="true"] {
      background: rgba(34, 197, 94, 0.1) !important;
      border-color: #22c55e !important;
    }

    /* Missed (revealed after game-over) */
    .hotspot-btn[data-found="missed"] {
      background: rgba(239, 68, 68, 0.1) !important;
      border-color: #ef4444 !important;
    }

    @keyframes wrongFlash {
      0%   { outline: none; }
      25%  { outline: 3px solid #ef4444; outline-offset: 2px; }
      75%  { outline: 3px solid #ef4444; outline-offset: 2px; }
      100% { outline: none; }
    }

    .hotspot-btn.wrong-flash { animation: wrongFlash 0.55s ease; }

    /* Dark mode: the muted greys of the profile need lighter tones on the dark surface */
    :global(.darkmode) .handle,
    :global(.darkmode) .post-time,
    :global(.darkmode) .act-count,
    :global(.darkmode) .stat-item,
    :global(.darkmode) .status-label { color: #94a3b8; }
    :global(.darkmode) .action-btn { color: #cbd5e1; }
    :global(.darkmode) .stat-item strong { color: #f1f5f9; }

    /* Comfortable tap targets: 44px on touch screens and phones */
    .hotspot-btn { min-height: 36px; }
    @media (pointer: coarse), (max-width: 768px) {
      .hotspot-btn { min-height: 44px; }
    }

    /* Phones: the list of found items is long; the counter and the attacker bar already tell the story */
    @media (max-width: 1023px) {
      #found-list.vuln-list { display: none; }
    }

    /* The cards, buttons, side column and game-end window come from the shared challenge styles
       (src/assets/scss/base/_challenge.scss); below is only what is specific to this game. */

    /* ── Side column: lives, found counter, list of finds ──────────────────── */
    .lives-row { display: flex; gap: 8px; }

    .life-icon {
      font-size: 1.6rem;
      transition: filter 0.3s, opacity 0.3s;
    }

    .life-icon.lost {
      filter: grayscale(100%);
      opacity: 0.3;
    }

    /* On phones lives and counter sit side by side */
    @media (max-width: 1023px) {
      .ap-status.ch-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .ap-status.ch-card > .ch-block {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }
    }

    .vuln-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    /* The items are created by the script, so they do not carry Astro's scope attribute: :global */
    .vuln-list :global(.vuln-item) {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: #065f46;
      font-weight: 600;
    }

    .vuln-list :global(.vuln-empty) { font-size: 0.8rem; color: var(--ch-text-muted); }

    :global(.darkmode) .vuln-list :global(.vuln-item) { color: #6ee7b7; }

    /* ── Parts 2–4: plan the attack, why and how to stop it, results ──────── */
    .ap-part {
      margin: 0 0 var(--space-s);
    }

    .ap-part:empty,
    .ap-part[hidden] { display: none; }

    .ch-title + .ap-card__intro { margin-top: 0.5rem; }
    .ap-card__intro { margin: 0 0 var(--space-m); color: var(--ch-text-muted); line-height: 1.6; }

    .plan-board {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }

    .plan-tray {
      padding: var(--space-m);
      border: 2px dashed var(--ch-border);
      border-radius: 12px;
      background: var(--ch-surface-2);
    }

    .plan-tray__title { margin: 0 0 var(--space-s); font-size: var(--font-size-0); font-weight: 700; color: var(--ch-text); }
    .plan-tray__list { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }

    .plan-chip {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      width: auto;
      max-width: 100%;
      min-height: 44px;
      padding: var(--space-xs) var(--space-s);
      border: 2px solid var(--ch-border);
      border-radius: 10px;
      background: var(--ch-surface);
      color: var(--ch-text);
      font: inherit;
      font-size: 0.9rem;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
    }

    .plan-chip:hover { border-color: var(--ch-strong); }

    .plan-chip--selected {
      border-color: var(--ch-strong);
      background: var(--ch-soft);
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--ch-brand), transparent 70%);
    }

    .plan-chip--wrong {
      animation: planShake 0.4s ease;
      border-color: #dc2626;
      background: #fef2f2;
    }

    @keyframes planShake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }

    .plan-chip__icon { font-size: 1.25rem; flex-shrink: 0; }

    .plan-zones { display: flex; flex-direction: column; gap: var(--space-s); }

    .plan-zone {
      padding: var(--space-s);
      border: 2px solid;
      border-radius: 12px;
    }

    .plan-zone--account { border-color: var(--ch-line); background: var(--ch-soft); }
    .plan-zone--person { border-color: #d97706; background: #fffbeb; }
    .plan-zone--none { border-color: #9ca3af; background: var(--ch-surface-2); }

    .plan-zone__btn {
      display: flex;
      align-items: flex-start;
      gap: var(--space-s);
      width: 100%;
      min-height: 44px;
      padding: var(--space-2xs);
      border: none;
      border-radius: 8px;
      background: transparent;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .plan-zone__btn:hover { background: rgba(255, 255, 255, 0.6); }
    .plan-zone__icon { font-size: 1.4rem; line-height: 1.2; }
    .plan-zone__text { display: flex; flex-direction: column; }
    .plan-zone__title { font-size: var(--font-size-0); }
    .plan-zone--account .plan-zone__title { color: var(--ch-ink); }
    .plan-zone--person .plan-zone__title { color: #78350f; }
    .plan-zone--none .plan-zone__title { color: var(--ch-text); }
    .plan-zone__hint { font-size: 0.82rem; line-height: 1.35; color: var(--ch-text-muted); }

    .plan-zone__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      margin: var(--space-2xs) 0 0;
      padding: 0;
      list-style: none;
    }

    .plan-zone__item {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      padding: var(--space-2xs) var(--space-xs);
      border-radius: 8px;
      background: var(--ch-surface);
      color: var(--ch-text);
      font-size: 0.85rem;
    }

    .plan-summary { margin-top: var(--space-l); }
    .plan-summary p { margin: 0 0 var(--space-s); }
    .plan-summary__title { margin: 0 0 var(--space-xs); font-size: var(--font-size-1); font-weight: 700; color: inherit; }
    .plan-summary__score { font-weight: 700; }

    .quiz-progress { margin: var(--space-xs) 0 0; font-size: 0.85rem; font-weight: 700; color: var(--ch-text-muted); }
    .quiz-kind { margin: var(--space-xs) 0 0; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ch-ink); }
    .quiz-text { margin: var(--space-2xs) 0 var(--space-m); font-size: var(--font-size-1); line-height: 1.5; color: var(--ch-text); }
    .quiz-options { display: grid; gap: var(--space-xs); }

    .quiz-option {
      min-height: 48px;
      padding: var(--space-xs) var(--space-m);
      border: 2px solid var(--ch-line);
      border-radius: 10px;
      background: var(--ch-soft);
      color: var(--ch-ink);
      font: inherit;
      font-weight: 600;
      line-height: 1.4;
      text-align: left;
      cursor: pointer;
    }

    .quiz-option:hover:not(:disabled) { border-color: var(--ch-strong); background: var(--ch-soft-2); }
    .quiz-option:disabled { cursor: default; }
    .quiz-option--right { border-color: #15803d; background: #f0fdf4; color: #14532d; box-shadow: 0 0 0 3px var(--ch-surface), 0 0 0 6px #15803d; }
    .quiz-option--wrong { border-color: #b91c1c; background: #fef2f2; color: #7f1d1d; opacity: 0.8; }
    .quiz-next { margin-top: var(--space-m); }

    .ap-final__list { display: grid; gap: var(--space-2xs); margin: 0; padding: 0; list-style: none; color: var(--ch-text-muted); }
    .ap-final__message { max-width: 46ch; margin: 0; font-weight: 600; line-height: 1.6; color: var(--ch-text); }

    .plan-chip:focus-visible,
    .plan-zone__btn:focus-visible,
    .quiz-option:focus-visible {
      outline: 3px solid #3b82f6;
      outline-offset: 2px;
    }

    /* Dark mode: only the colours that carry meaning (the rest follows the shared tokens) */
    :global(.darkmode) .plan-chip--wrong { background: #450a0a; border-color: #f87171; }
    :global(.darkmode) .plan-zone--person { background: #2a1a05; border-color: #b45309; }
    :global(.darkmode) .plan-zone--none { border-color: #6b7280; }
    :global(.darkmode) .plan-zone--person .plan-zone__title { color: #fcd34d; }
    :global(.darkmode) .plan-zone__btn:hover { background: rgba(255, 255, 255, 0.06); }
    :global(.darkmode) .quiz-option--right { background: #052820; border-color: #059669; color: #a7f3d0; box-shadow: 0 0 0 3px var(--ch-surface), 0 0 0 6px #34d399; }
    :global(.darkmode) .quiz-option--wrong { background: #450a0a; border-color: #ef4444; color: #fecaca; }

    /* ── Reduced motion ────────────────────────────────────────────────────── */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>

  <script>
    import { AP_CLUES, AP_GOALS, dealQuestions, rankFor, shuffle } from '../../../data/challengeAP'
    import type { ApGoal, ApQuestion } from '../../../data/challengeAP'
    import { recordResult } from '../../../utils/challengeProgress'

    const initializeVulnerabilityChallenge = () => {
      document.querySelectorAll('[data-vulnerability-game]').forEach((root) => {
        if (!(root instanceof HTMLElement)) return
        if (root.dataset.bound === 'true') return
        root.dataset.bound = 'true'
        // The game-end window sits inside the section, so only the two columns are made inert behind it
        const gameLayout: HTMLElement = document.getElementById('ap-layout') ?? root

        const vulnEmpty = root.dataset.vulnEmpty ?? ''
        const winTitle = root.dataset.winTitle ?? ''
        const winMsg = root.dataset.winMsg ?? ''
        const loseTitle = root.dataset.loseTitle ?? ''
        const loseMsgTemplate = root.dataset.loseMsgTemplate ?? ''
        const voiceInitial = root.dataset.voiceInitial ?? ''
        const voiceWinTemplate = root.dataset.voiceWinTemplate ?? ''
        const voiceLose = root.dataset.voiceLose ?? ''
        const voiceAlreadyTaggedTemplate = root.dataset.voiceAlreadyTaggedTemplate ?? ''
        const voiceCorrectTemplate = root.dataset.voiceCorrectTemplate ?? ''
        const voiceWrongTemplate = root.dataset.voiceWrongTemplate ?? ''

        const MAX_WRONG = 3

        // ── Elements ─────────────────────────────────────────────────────────
        const attackerBar = root.querySelector('#attacker-bar')
        const attackerVoice = root.querySelector('#attacker-voice')
        const foundCountEl = root.querySelector('#found-count')
        const foundListEl = root.querySelector('#found-list')
        const gameOverlay = document.querySelector('#game-overlay')
        const overlayIcon = document.querySelector('#overlay-icon')
        const overlayTitle = document.querySelector('#overlay-title')
        const overlayMsg = document.querySelector('#overlay-msg')
        const overlayFound = document.querySelector('#overlay-found')
        const resetBtn = document.querySelector('#reset-btn')
        const continueBtn = document.querySelector('#continue-btn')
        let lastClicked: HTMLElement | null = null

        const hotspotBtns = Array.from(root.querySelectorAll('.hotspot-btn')).filter((el) => el instanceof HTMLElement)

        if (!(foundListEl instanceof HTMLElement)) return
        if (!(gameOverlay instanceof HTMLElement)) return
        if (!(resetBtn instanceof HTMLElement)) return
        if (!(continueBtn instanceof HTMLElement)) return
        if (hotspotBtns.length === 0) return

        // ── State ───────────────────────────────────────────────────────────
        const found = new Set()
        let wrongAttempts = 0
        let gameOver = false

        const getTotalCorrect = () => hotspotBtns.filter((btn) => btn.dataset.correct === 'true').length
        const TOTAL_CORRECT = getTotalCorrect()

        // ── Helpers ─────────────────────────────────────────────────────────
        const formatTemplate = (template: string | null | undefined, vars?: Record<string, string | number>) =>
          String(template ?? '').replace(/\{(\w+)\}/g, (_m, key) => String(vars?.[key] ?? ''))

        const setVoice = (msg: string, type: string = 'neutral') => {
          if (attackerVoice instanceof HTMLElement) attackerVoice.textContent = msg
          if (attackerBar instanceof HTMLElement) {
            attackerBar.classList.remove('bar-correct', 'bar-wrong')
            if (type !== 'neutral') attackerBar.classList.add(`bar-${type}`)
          }
        }

        const setFoundEmpty = () => {
          foundListEl.innerHTML = ''
          const li = document.createElement('li')
          li.className = 'vuln-empty'
          li.textContent = vulnEmpty
          foundListEl.appendChild(li)
        }

        const updateFoundUI = () => {
          if (foundCountEl instanceof HTMLElement) foundCountEl.textContent = String(found.size)
          if (found.size === 0) {
            setFoundEmpty()
            return
          }

          foundListEl.innerHTML = ''
          Array.from(found).forEach((id) => {
            const btn = hotspotBtns.find((b) => b.dataset.id === id)
            const label = btn?.dataset.label ?? id
            const li = document.createElement('li')
            li.className = 'vuln-item'
            li.textContent = `✓ ${label}`
            foundListEl.appendChild(li)
          })
        }

        const updateLives = () => {
          for (let i = 1; i <= MAX_WRONG; i++) {
            const el = root.querySelector(`#life-${i}`)
            if (el instanceof HTMLElement) el.classList.toggle('lost', i <= wrongAttempts)
          }
        }

        // ── Game end ─────────────────────────────────────────────────────────
        const checkEnd = () => {
          const won = found.size === TOTAL_CORRECT
          const lost = wrongAttempts >= MAX_WRONG

          if (!won && !lost) return

          gameOver = true

          if (lost && !won) {
            // Reveal unfound vulnerabilities
            hotspotBtns
              .filter((btn) => btn.dataset.correct === 'true' && !found.has(btn.dataset.id ?? ''))
              .forEach((btn) => btn.setAttribute('data-found', 'missed'))
          }

          if (overlayIcon instanceof HTMLElement) overlayIcon.textContent = won ? '🎉' : '💀'
          if (overlayTitle instanceof HTMLElement) overlayTitle.textContent = won ? winTitle : loseTitle
          if (overlayMsg instanceof HTMLElement) {
            overlayMsg.textContent = won ? winMsg : formatTemplate(loseMsgTemplate, { found: found.size, total: TOTAL_CORRECT })
          }
          if (overlayFound instanceof HTMLElement) overlayFound.textContent = String(found.size)

          gameOverlay.classList.remove('hidden')
          gameLayout.inert = true          // keep keyboard and screen readers inside the dialog
          ;(won ? continueBtn : resetBtn).focus()
          setVoice(
            won ? formatTemplate(voiceWinTemplate, { total: TOTAL_CORRECT }) : voiceLose,
            won ? 'correct' : 'wrong'
          )
        }

        // ── Click handler ────────────────────────────────────────────────────
        const handleClick = (e: Event) => {
          const btn = e.currentTarget
          if (!(btn instanceof HTMLElement)) return

          lastClicked = btn
          const id = btn.dataset.id ?? ''
          const correct = btn.dataset.correct === 'true'
          const label = btn.dataset.label ?? id
          const explain = btn.dataset.explain ?? ''

          if (gameOver) return

          if (btn.dataset.found === 'true') {
            setVoice(formatTemplate(voiceAlreadyTaggedTemplate, { label }), 'neutral')
            return
          }

          if (correct) {
            found.add(id)
            btn.setAttribute('data-found', 'true')
            setVoice(formatTemplate(voiceCorrectTemplate, { label, explain }), 'correct')
            updateFoundUI()
            checkEnd()
          } else {
            wrongAttempts++
            btn.classList.add('wrong-flash')
            setTimeout(() => btn.classList.remove('wrong-flash'), 600)
            updateLives()
            setVoice(formatTemplate(voiceWrongTemplate, { explain }), 'wrong')
            checkEnd()
          }
        }

        hotspotBtns.forEach((btn) => btn.addEventListener('click', handleClick))

        // The dialog has two controls: Tab and Shift+Tab move between them
        gameOverlay.addEventListener('keydown', (e) => {
          if (e.key !== 'Tab') return
          e.preventDefault()
          ;(document.activeElement === continueBtn ? resetBtn : continueBtn).focus()
        })

        // ── Reset part 1 ─────────────────────────────────────────────────────
        const resetPart1 = () => {
          found.clear()
          wrongAttempts = 0
          gameOver = false

          hotspotBtns.forEach((btn) => {
            btn.removeAttribute('data-found')
            btn.classList.remove('wrong-flash')
          })

          if (attackerBar instanceof HTMLElement) attackerBar.classList.remove('bar-correct', 'bar-wrong')

          gameOverlay.classList.add('hidden')
          gameLayout.inert = false
          updateLives()
          updateFoundUI()
          setVoice(voiceInitial, 'neutral')
        }

        resetBtn.addEventListener('click', () => {
          resetPart1()
          lastClicked?.focus()
        })

        // ═════════════════ PARTS 2–4: plan the attack · why and how to stop it · results ═════════════════
        const dataEl = document.getElementById('ap-challenge-data')
        if (dataEl) {
          const data = JSON.parse(dataEl.textContent ?? '{}') as {
            clues: { id: string; icon: string; text: string; explanation: string }[]
            goals: Record<string, { icon: string; title: string; hint: string }>
            motivations: Record<string, { name: string; desc: string }>
            motiveCases: { id: number; text: string; explanation: string }[]
            defendCases: { id: number; text: string; options: string[]; explanation: string }[]
            labels: Record<string, string>
          }
          const L = data.labels
          const clueById = new Map(data.clues.map((clue) => [clue.id, clue]))
          const clueGoal = new Map<string, ApGoal>(AP_CLUES.map((rule) => [rule.id, rule.goal]))
          const motiveById = new Map(data.motiveCases.map((item) => [item.id, item]))
          const defendById = new Map(data.defendCases.map((item) => [item.id, item]))
          const PLAN_TOTAL = AP_CLUES.length

          const q = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)
          const partLabel = q('[data-part-label]')
          const planTray = q('[data-plan-tray]')
          const planSummary = q('[data-plan-summary]')
          const planScore = q('[data-plan-score]')
          const toQuizBtn = q('[data-to-quiz]')
          const quizProgress = q('[data-quiz-progress]')
          const quizKind = q('[data-quiz-kind]')
          const quizText = q('[data-quiz-text]')
          const quizOptions = q('[data-quiz-options]')
          const quizNext = q('[data-quiz-next]')
          const finalScore = q('[data-final-score]')
          const finalMessage = q('[data-final-message]')
          const playAgainBtn = q('[data-play-again]')
          const chipTemplate = q<HTMLTemplateElement>('template[data-plan-chip-template]')
          const itemTemplate = q<HTMLTemplateElement>('template[data-plan-item-template]')
          const optionTemplate = q<HTMLTemplateElement>('template[data-quiz-option-template]')
          const goalButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-goal]'))
          const helpPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-help-for]'))
          const onlyPart1 = Array.from(root.querySelectorAll<HTMLElement>('[data-part-only]'))

          if (partLabel && planTray && planSummary && planScore && toQuizBtn && quizProgress && quizKind && quizText &&
              quizOptions && quizNext && finalScore && finalMessage && playAgainBtn && chipTemplate && itemTemplate &&
              optionTemplate && goalButtons.length === AP_GOALS.length) {

            // ── Which part is on screen ─────────────────────────────────────
            const partLabels = [L.part1Label, L.part1Label, L.part2Label, L.part3Label, L.part3Label]
            const showPart = (part: 1 | 2 | 3 | 4) => {
              root.querySelectorAll<HTMLElement>('[data-part-area]').forEach((area) => {
                area.hidden = area.dataset.partArea !== String(part)
              })
              onlyPart1.forEach((el) => { el.hidden = part !== 1 })
              helpPanels.forEach((el) => { el.hidden = !(el.dataset.helpFor ?? '').split(' ').includes(String(part)) })
              partLabel.textContent = partLabels[part]
              partLabel.hidden = part === 4
            }

            // ── Part 2: plan the attack ─────────────────────────────────────
            let planPlaced = 0
            let planFirstTry = 0
            let planMissed = new Set<string>()
            let selectedChip: HTMLElement | null = null
            let planBusy = false

            const chips = () => Array.from(planTray.querySelectorAll<HTMLElement>('.plan-chip'))
            const deselectChip = () => {
              selectedChip?.classList.remove('plan-chip--selected')
              selectedChip?.setAttribute('aria-pressed', 'false')
              selectedChip = null
            }

            const buildPlan = () => {
              planPlaced = 0
              planFirstTry = 0
              planMissed = new Set<string>()
              selectedChip = null
              planBusy = false
              planSummary.hidden = true
              root.querySelectorAll<HTMLElement>('[data-goal-list]').forEach((list) => list.replaceChildren())
              planTray.replaceChildren(
                ...shuffle(AP_CLUES).map((rule) => {
                  const clue = clueById.get(rule.id)
                  const chip = chipTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement
                  chip.dataset.clue = rule.id
                  chip.querySelector('.plan-chip__icon')!.textContent = clue?.icon ?? ''
                  chip.querySelector('.plan-chip__text')!.textContent = clue?.text ?? ''
                  return chip
                }),
              )
            }

            const placeClue = (chip: HTMLElement, goal: ApGoal) => {
              const id = chip.dataset.clue ?? ''
              const clue = clueById.get(id)
              if (!clue || planBusy) return
              if (clueGoal.get(id) === goal) {
                const item = itemTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement
                const spans = item.querySelectorAll('span')
                spans[0].textContent = clue.icon
                spans[1].textContent = clue.text
                root.querySelector(`[data-goal-list="${goal}"]`)?.append(item)
                chip.remove()
                selectedChip = null
                planPlaced++
                if (!planMissed.has(id)) planFirstTry++
                setVoice(formatTemplate(L.planVoiceCorrect, { explain: clue.explanation }), 'correct')
                if (planPlaced === PLAN_TOTAL) {
                  planScore.textContent = formatTemplate(L.planScoreTemplate, { n: planFirstTry, total: PLAN_TOTAL })
                  planSummary.hidden = false
                  toQuizBtn.focus()
                } else {
                  chips()[0]?.focus()
                }
              } else {
                planMissed.add(id)
                planBusy = true
                chip.classList.add('plan-chip--wrong')
                setVoice(formatTemplate(L.planVoiceWrong, { explain: clue.explanation }), 'wrong')
                setTimeout(() => { chip.classList.remove('plan-chip--wrong'); planBusy = false }, 600)
                deselectChip()
              }
            }

            planTray.addEventListener('click', (e) => {
              const chip = (e.target as HTMLElement).closest<HTMLElement>('.plan-chip')
              if (!chip || planBusy) return
              if (selectedChip === chip) { deselectChip(); return }
              deselectChip()
              selectedChip = chip
              chip.classList.add('plan-chip--selected')
              chip.setAttribute('aria-pressed', 'true')
              goalButtons[0]?.focus()
            })
            goalButtons.forEach((button) => button.addEventListener('click', () => {
              if (!selectedChip) { setVoice(L.planChooseLabel, 'neutral'); chips()[0]?.focus(); return }
              placeClue(selectedChip, button.dataset.goal as ApGoal)
            }))

            const startPart2 = () => {
              buildPlan()
              showPart(2)
              setVoice(L.planIntro, 'neutral')
              root.querySelector<HTMLElement>('#plan-title')?.focus()
            }

            // ── Part 3: why, and how to stop it ─────────────────────────────
            let questions: ApQuestion[] = []
            let qIndex = 0
            let qFirstTry = 0
            let qMissed = new Set<string>()
            let qAnswered = false

            const optionLabel = (question: ApQuestion, option: string): string =>
              question.kind === 'motive'
                ? data.motivations[option]?.name ?? option
                : defendById.get(question.id)?.options[Number(option.slice(1))] ?? option

            const renderQuestion = () => {
              const question = questions[qIndex]
              if (!question) return
              qAnswered = false
              const item = question.kind === 'motive' ? motiveById.get(question.id) : defendById.get(question.id)
              quizProgress.textContent = formatTemplate(L.quizProgressTemplate, { n: qIndex + 1, total: questions.length })
              quizKind.textContent = question.kind === 'motive' ? L.motiveLabel : L.defendLabel
              quizText.textContent = item?.text ?? ''
              quizNext.hidden = true
              quizNext.textContent = qIndex + 1 >= questions.length ? L.resultsButton : L.nextButton
              quizOptions.replaceChildren(
                ...question.options.map((option) => {
                  const button = optionTemplate.content.firstElementChild!.cloneNode(true) as HTMLButtonElement
                  button.dataset.option = option
                  button.textContent = optionLabel(question, option)
                  return button
                }),
              )
              setVoice(question.kind === 'motive' ? L.motiveLabel : L.defendLabel, 'neutral')
              ;(quizOptions.querySelector('button') as HTMLElement | null)?.focus({ preventScroll: true })
            }

            quizOptions.addEventListener('click', (e) => {
              const button = (e.target as HTMLElement).closest<HTMLButtonElement>('.quiz-option')
              const question = questions[qIndex]
              if (!button || !question || qAnswered) return
              const key = `${question.kind}-${question.id}`
              const item = question.kind === 'motive' ? motiveById.get(question.id) : defendById.get(question.id)
              const explain = item?.explanation ?? ''
              if (button.dataset.option === question.answer) {
                qAnswered = true
                if (!qMissed.has(key)) qFirstTry++
                quizOptions.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((other) => {
                  other.disabled = true
                  other.classList.toggle('quiz-option--right', other === button)
                })
                setVoice(formatTemplate(L.quizVoiceCorrect, { explain }), 'correct')
                quizNext.hidden = false
                quizNext.focus()
              } else {
                qMissed.add(key)
                button.disabled = true
                button.classList.add('quiz-option--wrong')
                setVoice(formatTemplate(L.quizVoiceWrong, { explain }), 'wrong')
              }
            })

            const startPart3 = () => {
              questions = dealQuestions()
              qIndex = 0
              qFirstTry = 0
              qMissed = new Set<string>()
              showPart(3)
              renderQuestion()
              root.querySelector<HTMLElement>('#quiz-title')?.scrollIntoView({ block: 'start' })
            }

            quizNext.addEventListener('click', () => {
              qIndex++
              if (qIndex >= questions.length) showFinal()
              else renderQuestion()
            })

            // ── Part 4: results ─────────────────────────────────────────────
            function showFinal() {
              const points = found.size + planFirstTry + qFirstTry
              const total = TOTAL_CORRECT + PLAN_TOTAL + questions.length
              recordResult('ap', points, total)
              showPart(4)
              finalScore.textContent = formatTemplate(L.finalScoreTemplate, { n: points, total })
              const lines: [string, number, number][] = [
                [L.finalPart1Template, found.size, TOTAL_CORRECT],
                [L.finalPart2Template, planFirstTry, PLAN_TOTAL],
                [L.finalPart3Template, qFirstTry, questions.length],
              ]
              lines.forEach(([template, n, of], i) => {
                const li = root.querySelector(`[data-final-part="${i + 1}"]`)
                if (li) li.textContent = formatTemplate(template, { n, total: of })
              })
              const rank = rankFor(points, total)
              finalMessage.textContent = rank === 'great' ? L.rankGreat : rank === 'good' ? L.rankGood : L.rankPractise
              setVoice(finalMessage.textContent, 'correct')
              root.querySelector<HTMLElement>('#final-title')?.focus()
            }

            // ── Hooks into part 1 and a full restart ────────────────────────
            continueBtn.addEventListener('click', () => {
              gameOverlay.classList.add('hidden')
              gameLayout.inert = false
              startPart2()
            })
            toQuizBtn.addEventListener('click', startPart3)
            playAgainBtn.addEventListener('click', () => {
              resetPart1()
              showPart(1)
              setVoice(voiceInitial, 'neutral')
              ;(root.querySelector('.hotspot-btn') as HTMLElement | null)?.focus()
            })

            continueBtn.textContent = L.continueButton
            showPart(1)
          }
        }

        // ── Init ─────────────────────────────────────────────────────────────
        updateLives()
        updateFoundUI()
        setVoice(voiceInitial, 'neutral')
      })
    }

    document.addEventListener('astro:page-load', initializeVulnerabilityChallenge)
    initializeVulnerabilityChallenge()
  </script>
</DefaultLayout>
