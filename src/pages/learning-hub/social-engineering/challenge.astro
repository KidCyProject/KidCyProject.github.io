---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import ChallengeShell from '@components/ChallengeShell.astro'
import HintPanel from '@components/HintPanel.astro'
import { useTranslations } from 'src/i18n/index'
import { toJsonScript } from '../../../utils/jsonScript'
import { SE_CASES_PER_GAME, SE_SCENARIOS } from '../../../data/challengeSE'

const { t, v } = useTranslations(Astro.currentLocale)
const { v: vEn } = useTranslations('en')

// Answer key (channel, best action, trick, goal) comes from src/data/challengeSE.ts and is the same for
// every language. The translation files only hold the text of each case, matched by id.
type CaseText = { id: number; from?: string; subject?: string; message?: string; explanation?: string }
const rawText = v<ReadonlyArray<CaseText>>('challengeSE.scenarios') ?? []
const enText = vEn<ReadonlyArray<CaseText>>('challengeSE.scenarios') ?? []
const textFor = (list: ReadonlyArray<CaseText>, id: number) => list.find((c) => Number(c.id) === id)

const scenarios = SE_SCENARIOS.map((rule) => {
  const raw = textFor(rawText, rule.id)
  const fb = textFor(enText, rule.id)
  return {
    ...rule,
    from: String(raw?.from ?? fb?.from ?? ''),
    subject: raw?.subject ?? fb?.subject,
    message: String(raw?.message ?? fb?.message ?? ''),
    explanation: String(raw?.explanation ?? fb?.explanation ?? ''),
  }
})

const tactics = v<Record<string, { label: string; desc: string }>>('challengeSE.tactics') ?? {}
const wants = v<Record<string, string>>('challengeSE.wants') ?? {}
const stca = v<ReadonlyArray<{ icon: string; label: string; text: string }>>('challengeSE.stca') ?? []
const redFlags = v<string[]>('challengeSE.redFlags') ?? vEn<string[]>('challengeSE.redFlags') ?? []

const labels = {
  caseLabel: t('challengeSE.caseLabel'),
  ofLabel: t('challengeSE.ofLabel'),
  nextCase: t('challengeSE.nextCase'),
  bestLabel: t('challengeSE.bestLabel'),
  safeLabel: t('challengeSE.safeLabel'),
  incorrectLabel: t('challengeSE.incorrectLabel'),
  bestAnswerTemplate: t('challengeSE.bestAnswerTemplate'),
  actionTrust: t('challengeSE.actionTrust'),
  actionCheck: t('challengeSE.actionCheck'),
  actionReport: t('challengeSE.actionReport'),
  safeNoteOverCautious: t('challengeSE.safeNoteOverCautious'),
  safeNoteAskOnScam: t('challengeSE.safeNoteAskOnScam'),
  safeNoteReportOnCheck: t('challengeSE.safeNoteReportOnCheck'),
  quizTitle: t('challengeSE.quizTitle'),
  quizCorrectTemplate: t('challengeSE.quizCorrectTemplate'),
  quizWrongTemplate: t('challengeSE.quizWrongTemplate'),
  trickLabel: t('challengeSE.trickLabel'),
  wantLabel: t('challengeSE.wantLabel'),
  emailBadge: t('challengeSE.emailBadge'),
  chatBadge: t('challengeSE.chatBadge'),
  smsBadge: t('challengeSE.smsBadge'),
  callBadge: t('challengeSE.callBadge'),
  personBadge: t('challengeSE.personBadge'),
  rankRookie: t('challengeSE.rankRookie'),
  rankRookieMsg: t('challengeSE.rankRookieMsg'),
  rankJunior: t('challengeSE.rankJunior'),
  rankJuniorMsg: t('challengeSE.rankJuniorMsg'),
  rankSenior: t('challengeSE.rankSenior'),
  rankSeniorMsg: t('challengeSE.rankSeniorMsg'),
  rankMaster: t('challengeSE.rankMaster'),
  rankMasterMsg: t('challengeSE.rankMasterMsg'),
  casesIdentified: t('challengeSE.casesIdentified'),
  tricksSpottedTemplate: t('challengeSE.tricksSpottedTemplate'),
  safeCountTemplate: t('challengeSE.safeCountTemplate'),
}

const startDescription = t('challengeSE.startDescription').replace('{n}', String(SE_CASES_PER_GAME))
---

<DefaultLayout title={t('challengeSE.title')}>
  <script
    type="application/json"
    id="se-challenge-data"
    set:html={toJsonScript({ scenarios, labels, tactics, wants })}
  />

  <ChallengeShell ns="challengeSE" brand="SE">
    <!-- Main Challenge Area -->
    <div class="ch-card">
      <!-- Game State: Loading -->
      <div id="game-loading" class="flex min-h-[28rem] items-center justify-center">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
          <h2 class="ch-title">{t('challengeSE.startTitle')}</h2>
          <p class="ch-lead">
            {startDescription}
          </p>
          <button id="btn-start-game" type="button" class="ch-btn ch-btn--primary mt-4">
            {t('challengeSE.startButton')}
          </button>
        </div>
      </div>

      <!-- Game State: Playing -->
      <div id="game-playing" class="hidden space-y-6">
        <!-- Progress Bar -->
        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm font-semibold text-slate-700">{t('challengeSE.caseProgress')}</span>
            <span id="progress-text" class="text-sm font-semibold text-slate-600"></span>
          </div>
          <div class="ch-meter">
            <div id="progress-bar" class="ch-meter__fill" style="width: 0%"></div>
          </div>
        </div>

        <!-- Message Card -->
        <div class="rounded-xl border-2 border-slate-300 bg-slate-50 p-6">
          <!-- Message Type Badge -->
          <div class="mb-4 flex items-center gap-2">
            <div
              id="msg-icon"
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-blue-100 text-lg"
              aria-hidden="true"
            >
              ✉️
            </div>
            <span id="msg-type-badge" class="text-xs font-bold uppercase text-slate-600"></span>
          </div>

          <!-- From/Sender -->
          <div class="mb-4 border-b border-slate-200 pb-4">
            <p class="text-xs font-bold uppercase text-slate-500">{t('challengeSE.fromLabel')}</p>
            <p id="msg-from" class="mt-1 font-semibold text-slate-900"></p>
          </div>

          <!-- Subject (Email only) -->
          <div id="msg-subject-container" class="mb-4 border-b border-slate-200 pb-4">
            <p class="text-xs font-bold uppercase text-slate-500">{t('challengeSE.subjectLabel')}</p>
            <p id="msg-subject" class="mt-1 font-semibold text-slate-900"></p>
          </div>

          <!-- Message Body -->
          <div class="mb-4 border-b border-slate-200 pb-4">
            <p class="text-xs font-bold uppercase text-slate-500">{t('challengeSE.messageLabel')}</p>
            <div id="msg-body" class="mt-3 rounded-lg bg-white p-4 leading-relaxed text-slate-900"></div>
          </div>

          <!-- Trick used + what the attacker wanted (shown after the answer, only for tricks) -->
          <div id="tactic-container" class="ch-note ch-note--warn ch-note--roomy hidden mb-4">
            <p class="mb-1 text-xs font-bold uppercase" id="red-flag-label"></p>
            <p id="msg-tactic" class="font-semibold"></p>
            <p id="msg-want" class="mt-2"></p>
          </div>
        </div>

        <!-- Action Buttons: Stop – Think – Check – Ask -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <button id="btn-trust" type="button" class="ch-btn ch-btn--safe ch-btn--block">
            {t('challengeSE.trustButton')}
          </button>
          <button id="btn-check" type="button" class="ch-btn ch-btn--info ch-btn--block">
            {t('challengeSE.checkButton')}
          </button>
          <button id="btn-report" type="button" class="ch-btn ch-btn--danger ch-btn--block">
            {t('challengeSE.ignoreButton')}
          </button>
        </div>

        <!-- Feedback Area -->
        <div id="feedback-container" class="ch-feedback hidden" role="status" aria-live="assertive">
          <p id="feedback-text" class="font-semibold"></p>
          <p id="feedback-explanation" class="mt-2 text-sm"></p>
          <p id="feedback-note" class="mt-2 text-sm font-semibold"></p>
        </div>

        <!-- Spot the trick (after a careful answer) -->
        <div id="quiz-container" class="hidden rounded-lg border border-slate-300 bg-white p-4" role="group" aria-labelledby="quiz-title">
          <p id="quiz-title" class="font-semibold text-slate-900"></p>
          <div id="quiz-options" class="mt-3 grid gap-2 sm:grid-cols-3"></div>
          <p id="quiz-result" class="mt-3 text-sm font-semibold text-slate-900" role="status" aria-live="polite"></p>
        </div>

        <!-- Next Button -->
        <button id="btn-next-case" type="button" class="ch-btn ch-btn--primary ch-btn--block hidden"></button>
      </div>

      <!-- Game State: Results -->
      <div id="game-results" class="ch-result hidden">
        <div>
          <h2 id="results-title" tabindex="-1" class="ch-result__title">{t('challengeSE.completedTitle')}</h2>
          <p class="ch-result__text">{t('challengeSE.completedDescription')}</p>
        </div>

        <!-- Score Display -->
        <div class="ch-result__score">
          <div class="ch-result__number" id="final-score">0</div>
          <p class="ch-result__label" id="cases-identified-label"></p>
          <div id="final-extra" class="mt-3 space-y-1 text-sm text-slate-700"></div>
        </div>

        <!-- Rank Badge -->
        <div class="w-full rounded-xl border-2 border-slate-200 bg-white p-6">
          <p class="mb-2 text-sm font-bold uppercase text-slate-600">{t('challengeSE.detectiveRankLabel')}</p>
          <div id="rank-display" class="mb-2 text-4xl font-bold text-slate-900">{t('challengeSE.defaultRank')}</div>
          <p id="rank-message" class="text-slate-600">{t('challengeSE.defaultRankMessage')}</p>
        </div>

        <!-- Review of every case -->
        <div class="w-full rounded-lg bg-slate-50 p-6 text-left">
          <h3 class="mb-3 font-bold text-slate-900">{t('challengeSE.performanceSummary')}</h3>
          <div id="summary-list" class="space-y-3 text-sm text-slate-700"></div>
        </div>

        <!-- Play Again Button -->
        <button id="btn-play-again" type="button" class="ch-btn ch-btn--primary ch-btn--block">
          {t('challengeSE.playAgain')}
        </button>
      </div>
    </div>

    <!-- Side Panel: Detective Notes (above the game, collapsed, on phones) -->
    <Fragment slot="side">
      <HintPanel title={t('challengeSE.detectiveNotes')} subtitle={t('challengeSE.detectiveTipsTitle')}>
        <!-- Stop – Think – Check – Ask -->
        <div class="ch-note ch-note--info">
          <p class="mb-2 text-sm font-bold">{t('challengeSE.stcaTitle')}</p>
          <ol class="space-y-2">
            {stca.map((step) => (
              <li class="flex gap-2 text-xs">
                <span aria-hidden="true">{step.icon}</span>
                <span><strong>{step.label}:</strong> {step.text}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="ch-stack pt-2">
          {redFlags.map((flag) => (
            <div class="ch-note ch-note--bad">{flag}</div>
          ))}
        </div>

        <div class="ch-note ch-note--info mt-4">
          <strong>💡</strong> {t('challengeSE.proTip')}
        </div>
      </HintPanel>
    </Fragment>
  </ChallengeShell>

  <script>
    import { dealDeck, evaluateChoice, quizOptions, rankFor } from '../../../data/challengeSE'
    import { recordResult } from '../../../utils/challengeProgress'
    import type { SeAction, SeOutcome, SeTactic } from '../../../data/challengeSE'

    type Case = {
      id: number
      channel: 'email' | 'chat' | 'sms' | 'call' | 'person'
      best: SeAction
      tactic?: SeTactic
      want?: 'information' | 'access' | 'money'
      from: string
      subject?: string
      message: string
      explanation: string
    }

    const initializeChallenge = () => {
      const dataEl = document.getElementById('se-challenge-data')
      if (!dataEl) return
      const { scenarios, labels, tactics, wants } = JSON.parse(dataEl.textContent ?? '{}') as {
        scenarios: Case[]
        labels: Record<string, string>
        tactics: Record<string, { label: string; desc: string }>
        wants: Record<string, string>
      }
      if (!scenarios || !labels) return

      const $ = (id: string) => document.getElementById(id)
      const gameLoading = $('game-loading')
      const gamePlaying = $('game-playing')
      const gameResults = $('game-results')

      const btnStartGame = $('btn-start-game')
      const btnTrust = $('btn-trust') as HTMLButtonElement | null
      const btnCheck = $('btn-check') as HTMLButtonElement | null
      const btnReport = $('btn-report') as HTMLButtonElement | null
      const btnNextCase = $('btn-next-case') as HTMLButtonElement | null
      const btnPlayAgain = $('btn-play-again') as HTMLButtonElement | null

      const progressText = $('progress-text')
      const progressBar = $('progress-bar')
      const msgIcon = $('msg-icon')
      const msgTypeBadge = $('msg-type-badge')
      const msgFrom = $('msg-from')
      const msgSubject = $('msg-subject')
      const msgSubjectContainer = $('msg-subject-container')
      const msgBody = $('msg-body')
      const msgTactic = $('msg-tactic')
      const msgWant = $('msg-want')
      const tacticContainer = $('tactic-container')
      const redFlagLabel = $('red-flag-label')

      const feedbackContainer = $('feedback-container')
      const feedbackText = $('feedback-text')
      const feedbackExplanation = $('feedback-explanation')
      const feedbackNote = $('feedback-note')

      const quizContainer = $('quiz-container')
      const quizTitle = $('quiz-title')
      const quizOptionsEl = $('quiz-options')
      const quizResult = $('quiz-result')

      const finalScore = $('final-score')
      const finalExtra = $('final-extra')
      const rankDisplay = $('rank-display')
      const rankMessage = $('rank-message')
      const summaryList = $('summary-list')
      const casesIdentifiedLabel = $('cases-identified-label')

      if (
        !gameLoading || !gamePlaying || !gameResults ||
        !btnStartGame || !btnTrust || !btnCheck || !btnReport || !btnNextCase || !btnPlayAgain ||
        !progressText || !progressBar || !msgIcon || !msgTypeBadge || !msgFrom ||
        !msgSubject || !msgSubjectContainer || !msgBody || !msgTactic || !msgWant || !tacticContainer || !redFlagLabel ||
        !feedbackContainer || !feedbackText || !feedbackExplanation || !feedbackNote ||
        !quizContainer || !quizTitle || !quizOptionsEl || !quizResult ||
        !finalScore || !finalExtra || !rankDisplay || !rankMessage || !summaryList
      ) {
        return
      }

      if (btnStartGame.dataset.bound === 'true') return
      btnStartGame.dataset.bound = 'true'

      const fmt = (template: string, vars: Record<string, string | number>) =>
        String(template ?? '').replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''))

      const scenarioById = new Map(scenarios.map((s) => [s.id, s]))
      const actionName: Record<SeAction, string> = { trust: labels.actionTrust, check: labels.actionCheck, report: labels.actionReport }
      const channelInfo: Record<Case['channel'], { icon: string; badge: string }> = {
        email: { icon: '✉️', badge: labels.emailBadge },
        chat: { icon: '💬', badge: labels.chatBadge },
        sms: { icon: '📱', badge: labels.smsBadge },
        call: { icon: '📞', badge: labels.callBadge },
        person: { icon: '🧍', badge: labels.personBadge },
      }
      const wantIcon: Record<string, string> = { information: '🪪', access: '🔑', money: '💰' }
      const outcomeIcon: Record<SeOutcome, string> = { best: '✅', safe: '🛡️', wrong: '❌' }
      const outcomeText: Record<SeOutcome, string> = { best: labels.bestLabel, safe: labels.safeLabel, wrong: labels.incorrectLabel }
      // Colour of the feedback bar: green (best), blue (safe choice, between the two), red (wrong)
      const feedbackClasses: Record<SeOutcome, string> = {
        best: 'ch-feedback--ok',
        safe: 'ch-feedback--info',
        wrong: 'ch-feedback--bad',
      }

      if (btnNextCase) btnNextCase.textContent = labels.nextCase
      if (redFlagLabel) redFlagLabel.textContent = labels.trickLabel
      quizTitle.textContent = labels.quizTitle

      type Answer = { scenario: Case; outcome: SeOutcome; trick: 'right' | 'wrong' | null }
      let deck: Case[] = []
      let currentIndex = 0
      let answered = false
      let answers: Answer[] = []

      const startGame = () => {
        deck = dealDeck()
          .map((rule) => scenarioById.get(rule.id))
          .filter((s): s is Case => Boolean(s))
        currentIndex = 0
        answered = false
        answers = []

        gameLoading.classList.add('hidden')
        gamePlaying.classList.remove('hidden')
        gameResults.classList.add('hidden')

        showCase()
      }

      const setDecisionButtons = (disabled: boolean) => {
        btnTrust.disabled = disabled
        btnCheck.disabled = disabled
        btnReport.disabled = disabled
      }

      const showCase = () => {
        if (currentIndex >= deck.length) {
          showResults()
          return
        }

        const scenario = deck[currentIndex]
        const info = channelInfo[scenario.channel]

        msgFrom.textContent = scenario.from
        msgBody.textContent = scenario.message
        msgIcon.textContent = info.icon
        msgTypeBadge.textContent = info.badge

        if (scenario.channel === 'email') {
          msgSubject.textContent = scenario.subject ?? ''
          msgSubjectContainer.classList.remove('hidden')
        } else {
          msgSubjectContainer.classList.add('hidden')
        }

        progressBar.style.width = `${(currentIndex / deck.length) * 100}%`
        progressText.textContent = `${labels.caseLabel} ${currentIndex + 1} ${labels.ofLabel} ${deck.length}`

        feedbackContainer.classList.add('hidden')
        tacticContainer.classList.add('hidden')
        quizContainer.classList.add('hidden')
        quizOptionsEl.replaceChildren()
        quizResult.textContent = ''
        btnNextCase.classList.add('hidden')

        setDecisionButtons(false)
        answered = false

        // Land on the first decision button and let a screen reader read the message with it
        const described = scenario.channel === 'email' ? 'msg-from msg-subject msg-body' : 'msg-from msg-body'
        ;[btnTrust, btnCheck, btnReport].forEach((b) => b.setAttribute('aria-describedby', described))
        btnTrust.focus()
      }

      const showNext = () => {
        btnNextCase.classList.remove('hidden')
        // The decision buttons / quiz just changed: hand the focus on once the live region starts reading
        setTimeout(() => btnNextCase.focus(), 200)
      }

      const revealTrick = (scenario: Case) => {
        if (!scenario.tactic) return
        const tactic = tactics[scenario.tactic]
        msgTactic.textContent = tactic ? `${tactic.label}: ${tactic.desc}` : ''
        msgWant.textContent = scenario.want ? `${labels.wantLabel}: ${wantIcon[scenario.want] ?? ''} ${wants[scenario.want] ?? ''}` : ''
        tacticContainer.classList.remove('hidden')
      }

      const handleAnswer = (choice: SeAction) => {
        if (answered) return
        answered = true

        const scenario = deck[currentIndex]
        const outcome = evaluateChoice(scenario, choice)
        setDecisionButtons(true)

        feedbackContainer.className = `ch-feedback ${feedbackClasses[outcome]}`
        feedbackText.className = 'font-semibold'
        feedbackText.textContent = `${outcomeIcon[outcome]} ${outcomeText[outcome]}`
        feedbackExplanation.textContent = scenario.explanation

        // What to do better, in plain words
        const notes: string[] = []
        if (outcome === 'safe') {
          if (choice === 'check') notes.push(scenario.best === 'trust' ? labels.safeNoteOverCautious : labels.safeNoteAskOnScam)
          else notes.push(labels.safeNoteReportOnCheck)
        }
        if (outcome !== 'best') notes.push(fmt(labels.bestAnswerTemplate, { action: actionName[scenario.best] }))
        feedbackNote.textContent = notes.join(' ')
        feedbackNote.className = 'mt-2 text-sm font-semibold'

        const answer: Answer = { scenario, outcome, trick: null }
        answers.push(answer)

        if (scenario.tactic && choice !== 'trust') {
          startQuiz(scenario, answer)
        } else {
          revealTrick(scenario)
          showNext()
        }
      }

      // "Spot the trick": three buttons, one right answer
      const startQuiz = (scenario: Case, answer: Answer) => {
        if (!scenario.tactic) return
        const correct = scenario.tactic
        quizOptionsEl.replaceChildren(
          ...quizOptions(correct).map((id) => {
            const option = document.createElement('button')
            option.type = 'button'
            option.className = 'quiz-btn'
            option.dataset.tactic = id
            option.textContent = tactics[id]?.label ?? id
            option.addEventListener('click', () => {
              const isRight = id === correct
              answer.trick = isRight ? 'right' : 'wrong'
              quizOptionsEl.querySelectorAll<HTMLButtonElement>('.quiz-btn').forEach((b) => {
                b.disabled = true
                if (b.dataset.tactic === correct) b.classList.add('quiz-btn--right')
              })
              if (!isRight) option.classList.add('quiz-btn--wrong')
              quizResult.textContent = fmt(isRight ? labels.quizCorrectTemplate : labels.quizWrongTemplate, { tactic: tactics[correct]?.label ?? correct })
              revealTrick(scenario)
              showNext()
            })
            return option
          }),
        )
        quizContainer.classList.remove('hidden')
        // After the feedback has been read, move on to the question
        setTimeout(() => quizOptionsEl.querySelector<HTMLButtonElement>('.quiz-btn')?.focus(), 200)
      }

      const showResults = () => {
        gamePlaying.classList.add('hidden')
        gameResults.classList.remove('hidden')
        $('results-title')?.focus()

        const total = answers.length
        const best = answers.filter((a) => a.outcome === 'best').length
        const safe = answers.filter((a) => a.outcome === 'safe').length
        const tricksAsked = answers.filter((a) => a.trick !== null).length
        const tricksSpotted = answers.filter((a) => a.trick === 'right').length

        recordResult('se', best, total)
        const rank = rankFor(best, total)
        const rankText = {
          rookie: [labels.rankRookie, labels.rankRookieMsg],
          junior: [labels.rankJunior, labels.rankJuniorMsg],
          senior: [labels.rankSenior, labels.rankSeniorMsg],
          master: [labels.rankMaster, labels.rankMasterMsg],
        }[rank]

        finalScore.textContent = String(best)
        if (casesIdentifiedLabel) casesIdentifiedLabel.textContent = fmt(labels.casesIdentified, { n: total })
        rankDisplay.textContent = rankText[0]
        rankMessage.textContent = rankText[1]

        finalExtra.replaceChildren()
        const addExtra = (text: string) => {
          const line = document.createElement('p')
          line.textContent = text
          finalExtra.appendChild(line)
        }
        if (tricksAsked > 0) addExtra(fmt(labels.tricksSpottedTemplate, { n: tricksSpotted, total: tricksAsked }))
        if (safe > 0) addExtra(fmt(labels.safeCountTemplate, { n: safe }))

        // Review: every case, and what the best answer was when it was not chosen
        summaryList.replaceChildren(
          ...answers.map((answer, idx) => {
            const row = document.createElement('div')
            row.className = 'flex items-start gap-2'
            const icon = document.createElement('span')
            icon.setAttribute('aria-hidden', 'true')
            icon.textContent = outcomeIcon[answer.outcome]
            const body = document.createElement('div')
            const title = document.createElement('p')
            title.className = 'font-semibold'
            title.textContent = `${labels.caseLabel} ${idx + 1}: ${answer.scenario.from} — ${outcomeText[answer.outcome]}`
            body.appendChild(title)
            if (answer.outcome !== 'best') {
              const hint = document.createElement('p')
              hint.textContent = fmt(labels.bestAnswerTemplate, { action: actionName[answer.scenario.best] })
              body.appendChild(hint)
            }
            row.append(icon, body)
            return row
          }),
        )
      }

      btnStartGame.addEventListener('click', startGame)
      btnTrust.addEventListener('click', () => handleAnswer('trust'))
      btnCheck.addEventListener('click', () => handleAnswer('check'))
      btnReport.addEventListener('click', () => handleAnswer('report'))
      btnNextCase.addEventListener('click', () => {
        currentIndex += 1
        showCase()
      })
      btnPlayAgain.addEventListener('click', startGame)
    }

    document.addEventListener('astro:page-load', initializeChallenge)
    initializeChallenge()
  </script>

  <style>
    /* The answer buttons of "Spot the trick" are created by the script (no Astro scope attribute) */
    #quiz-options :global(.quiz-btn) {
      min-height: 44px;
      padding: 0.5rem 0.75rem;
      border: 2px solid #94a3b8;
      border-radius: 0.5rem;
      background: #ffffff;
      color: #1e293b;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }

    #quiz-options :global(.quiz-btn:hover:not(:disabled)) {
      background: var(--ch-soft);
      border-color: var(--ch-strong);
    }

    #quiz-options :global(.quiz-btn:focus-visible) {
      outline: 3px solid #3b82f6;
      outline-offset: 2px;
    }

    #quiz-options :global(.quiz-btn:disabled) {
      cursor: default;
      opacity: 1;
    }

    #quiz-options :global(.quiz-btn--right) {
      border-color: #15803d;
      background: #dcfce7;
