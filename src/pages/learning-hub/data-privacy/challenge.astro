---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ChallengeIntro from '@components/ChallengeIntro.astro'
import ChallengeProgress from '@components/ChallengeProgress.astro'
import HintPanel from '@components/HintPanel.astro'
import HelpBox from '@components/HelpBox.astro'
import { useTranslations } from 'src/i18n/index'
import { toJsonScript } from '../../../utils/jsonScript'
import { DP_ACTIONS, DP_ZONES } from '../../../data/dpFootprint'

/**
 * Digital Footprint Sorter
 *
 * Step 1: sort activities into "on purpose" (active footprint), "in the background" (passive footprint)
 *         and "no digital footprint". Some cards look offline but leave a trace.
 * Step 2: clean up a profile — delete, hide, change or keep each part.
 *
 * Drag and drop with the mouse; on a phone or with a keyboard, select a card and use the buttons under it.
 * Answers and dealing live in src/data/dpFootprint.ts, all text in the translation files.
 */

const { t, v } = useTranslations(Astro.currentLocale)
const { v: vEn } = useTranslations('en')

type ZoneText = { icon: string; title: string; hint: string }
type ActivityText = { id: number; text: string; emoji: string; explanation: string }
type ProfileText = { id: number; icon: string; label: string; value: string; explanation: string }
type CheatItem = { icon: string; text: string }

const zonesEn = vEn<Record<string, ZoneText>>('challengeDP.zones') ?? {}
const zonesLocal = v<Record<string, ZoneText>>('challengeDP.zones') ?? {}
const zoneTexts = Object.fromEntries(DP_ZONES.map((zone) => [zone, { ...zonesEn[zone], ...zonesLocal[zone] }])) as Record<string, ZoneText>

const actionsEn = vEn<Record<string, string>>('challengeDP.actions') ?? {}
const actionsLocal = v<Record<string, string>>('challengeDP.actions') ?? {}
const actionTexts = Object.fromEntries(DP_ACTIONS.map((action) => [action, actionsLocal[action] ?? actionsEn[action]])) as Record<string, string>

// Texts by id: the page language, with English filling any gap
const activitiesEn = vEn<ReadonlyArray<ActivityText>>('challengeDP.activities') ?? []
const activitiesLocal = v<ReadonlyArray<ActivityText>>('challengeDP.activities') ?? []
const activities = activitiesEn.map((en) => ({ ...en, ...activitiesLocal.find((item) => item.id === en.id) }))

const profileEn = vEn<ReadonlyArray<ProfileText>>('challengeDP.profile') ?? []
const profileLocal = v<ReadonlyArray<ProfileText>>('challengeDP.profile') ?? []
const profile = profileEn.map((en) => ({ ...en, ...profileLocal.find((item) => item.id === en.id) }))

const cheatItems = v<ReadonlyArray<CheatItem>>('challengeDP.cheatItems') ?? vEn<ReadonlyArray<CheatItem>>('challengeDP.cheatItems') ?? []

const labels = {
  stage1Label: t('challengeDP.stage1Label'),
  stage2Label: t('challengeDP.stage2Label'),
  tryOtherZone: t('challengeDP.tryOtherZone'),
  correctInTemplate: t('challengeDP.correctInTemplate'),
  cleanupProgressTemplate: t('challengeDP.cleanupProgressTemplate'),
  cleanupScoreLabel: t('challengeDP.cleanupScoreLabel'),
  cleanupCorrect: t('challengeDP.cleanupCorrect'),
  cleanupAlso: t('challengeDP.cleanupAlso'),
  cleanupWrong: t('challengeDP.cleanupWrong'),
  cleanupBestTemplate: t('challengeDP.cleanupBestTemplate'),
  nextButton: t('challengeDP.nextButton'),
  resultsButton: t('challengeDP.resultsButton'),
  firstTryTemplate: t('challengeDP.firstTryTemplate'),
  winGreat: t('challengeDP.winGreat'),
  winGood: t('challengeDP.winGood'),
  winPractise: t('challengeDP.winPractise'),
}
---

<DefaultLayout title={t('challengeDP.title')}>
  <PageHeader
    title={t('challengeDP.title')}
    subtitle={t('challengeDP.subtitle')}
    bgType="module"
    underlineColor="var(--brand-DP)"
  />

  <ChallengeProgress />

  <script
    type="application/json"
    id="dp-challenge-data"
    set:html={toJsonScript({ activities, profile, zones: zoneTexts, actions: actionTexts, labels })}
  />

  <section class="my-12">
    <div class="container mb-12">
      <ChallengeIntro ns="challengeDP" brand="DP" />
    </div>
  </section>

  <section class="fp-game" data-fp-game>
    <div class="container">

      <!-- Cheat sheet: the two kinds of footprint and how to make them smaller (collapsed on phones) -->
      <HintPanel class="mb-6" title={t('challengeDP.cheatTitle')} subtitle={t('challengeDP.cheatSubtitle')}>
        {cheatItems.map((item) => (
          <div class="flex gap-2 text-sm">
            <span class="shrink-0" aria-hidden="true">{item.icon}</span>
            <div>{item.text}</div>
          </div>
        ))}
      </HintPanel>

      <p class="fp-game__stage" data-stage-label></p>

      <!-- Feedback: stays in view while scrolling, so the explanation is never left behind -->
      <div class="fp-game__feedback" data-feedback role="status" aria-live="polite" hidden>
        <p class="fp-game__feedback-title" data-feedback-title></p>
        <p class="fp-game__feedback-text" data-feedback-text></p>
      </div>

      <!-- ── STEP 1: sort the footprints ── -->
      <div data-stage="sort">
        <div class="fp-game__toolbar">
          <div class="fp-game__score" data-score aria-live="polite"></div>
          <button class="button fp-game__restart" type="button" data-restart>{t('challengeDP.tryAgain')}</button>
        </div>

        <div class="fp-game__board">
          <div class="fp-game__tray" data-tray>
            <h3 class="fp-game__tray-label">{t('challengeDP.activitiesToSort')}</h3>
            <div class="fp-game__cards-container" data-cards-tray></div>
          </div>

          <div class="fp-game__zones">
            {DP_ZONES.map((zone) => (
              <div
                class={`drop-zone drop-zone--${zone}`}
                data-zone={zone}
                role="region"
                aria-label={t('challengeDP.zoneAriaTemplate').replace('{zone}', zoneTexts[zone]?.title ?? zone)}
              >
                <div class="drop-zone__header">
                  <div>
                    <h3 class="drop-zone__title">{zoneTexts[zone]?.title}</h3>
                    <p class="drop-zone__hint">{zoneTexts[zone]?.hint}</p>
                  </div>
                  <span class="drop-zone__icon" aria-hidden="true">{zoneTexts[zone]?.icon}</span>
                </div>
                <div class="drop-zone__content" data-zone-content>
                  <p class="drop-zone__empty">{t('challengeDP.dragHere')}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Between the steps -->
      <div class="fp-game__between" data-between hidden>
        <span class="fp-game__between-icon" aria-hidden="true">👣</span>
        <h2 id="between-title" tabindex="-1">{t('challengeDP.stage1DoneTitle')}</h2>
        <p class="fp-game__between-summary" data-between-summary></p>
        <button class="button" type="button" data-to-cleanup>{t('challengeDP.toCleanupButton')}</button>
      </div>

      <!-- ── STEP 2: clean up a profile ── -->
      <div class="cleanup" data-stage="cleanup" hidden>
        <div class="cleanup__intro">
          <h2 id="cleanup-title" tabindex="-1">{t('challengeDP.cleanupTitle')}</h2>
          <p>{t('challengeDP.cleanupIntro')}</p>
        </div>

        <div class="fp-game__toolbar">
          <div class="fp-game__score" data-cleanup-score aria-live="polite"></div>
          <span class="cleanup__progress" data-cleanup-progress></span>
          <button class="button fp-game__restart" type="button" data-restart>{t('challengeDP.tryAgain')}</button>
        </div>

        <div class="cleanup-card">
          <div class="cleanup-card__icon" data-profile-icon aria-hidden="true"></div>
          <div class="cleanup-card__body">
            <p class="cleanup-card__label" id="profile-label-text" data-profile-label></p>
            <p class="cleanup-card__value" id="profile-value-text" data-profile-value></p>
            <p class="cleanup-card__visible">
              {t('challengeDP.profileVisibleLabel')}: <strong>{t('challengeDP.profileEveryone')}</strong>
            </p>
          </div>
        </div>

        <div class="cleanup-actions" role="group" aria-label={t('challengeDP.chooseActionLabel')} aria-describedby="profile-label-text profile-value-text">
          {DP_ACTIONS.map((action) => (
            <button type="button" class={`cleanup-action cleanup-action--${action}`} data-action={action}>
              {actionTexts[action]}
            </button>
          ))}
        </div>

        <button class="button cleanup__next" type="button" data-cleanup-next hidden></button>
      </div>

      <!-- Templates cloned by the script. Cloning keeps the scoped-style attributes, so the cards look the same as server-rendered ones -->
      <template data-card-template>
        <div class="activity-card-wrapper">
          <div class="activity-card" draggable="true" tabindex="0" role="button" aria-pressed="false">
            <div class="activity-card__emoji" aria-hidden="true"></div>
            <div class="activity-card__text"></div>
            <div class="activity-card__check" aria-hidden="true">✓</div>
          </div>
          <div class="activity-card__choices" role="group" aria-label={t('challengeDP.chooseZoneLabel')} hidden>
            {DP_ZONES.map((zone) => (
              <button type="button" class={`zone-choice zone-choice--${zone}`} data-choose={zone}>
                {zoneTexts[zone]?.icon} {zoneTexts[zone]?.title}
              </button>
            ))}
          </div>
        </div>
      </template>
      <template data-empty-template>
        <p class="drop-zone__empty">{t('challengeDP.dragHere')}</p>
      </template>
      <template data-review-template>
        <li class="fp-game__review-item">
          <span data-review-text></span>
          <span class="fp-game__review-answer" data-review-answer></span>
        </li>
      </template>

      <!-- Win celebration -->
      <div class="fp-game__win" data-win hidden>
        <div class="fp-game__win-inner">
          <span class="fp-game__win-icon" aria-hidden="true">🎉</span>
          <h2 id="win-title" tabindex="-1">{t('challengeDP.winTitle')}</h2>
          <p class="fp-game__win-summary" data-win-summary></p>
          <p data-win-message></p>
          <div class="fp-game__review" data-review hidden>
            <h3 class="fp-game__review-title">{t('challengeDP.reviewTitle')}</h3>
            <ul class="fp-game__review-list" data-review-list></ul>
          </div>
          <button class="button" type="button" data-restart>{t('challengeDP.playAgain')}</button>
        </div>
      </div>

    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <HelpBox class="mt-8" />
    </div>
  </section>

<script>
  import { DP_ACTIVITIES, dealActivities, dealProfile, isProfileRight, rankFor } from '../../../data/dpFootprint'
  import { recordResult } from '../../../utils/challengeProgress'
  import type { DpActivityRule, DpAction, DpProfileRule, DpZone } from '../../../data/dpFootprint'

  const initializeFootprintGame = () => {
    document.querySelectorAll('[data-fp-game]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return
      if (root.dataset.bound === 'true') return
      root.dataset.bound = 'true'

      const dataEl = document.getElementById('dp-challenge-data')
      if (!dataEl) return
      const { activities, profile, zones: zoneTexts, actions: actionTexts, labels } = JSON.parse(dataEl.textContent ?? '{}') as {
        activities: { id: number; text: string; emoji: string; explanation: string }[]
        profile: { id: number; icon: string; label: string; value: string; explanation: string }[]
        zones: Record<string, { icon: string; title: string; hint: string }>
        actions: Record<string, string>
        labels: Record<string, string>
      }
      const activityById = new Map(activities.map((item) => [item.id, item]))
      const profileById = new Map(profile.map((item) => [item.id, item]))
      const activityRuleById = new Map<number, DpActivityRule>(DP_ACTIVITIES.map((rule) => [rule.id, rule]))
      const fmt = (template: string, vars: Record<string, string | number>) =>
        String(template ?? '').replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''))
      const zoneLabel = (zone: string) => `${zoneTexts[zone]?.icon ?? ''} ${zoneTexts[zone]?.title ?? zone}`.trim()

      const q = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)
      const scoreEl = q('[data-score]')
      const stageLabel = q('[data-stage-label]')
      const feedbackEl = q('[data-feedback]')
      const feedbackTitle = q('[data-feedback-title]')
      const feedbackText = q('[data-feedback-text]')
      const sortStage = q('[data-stage="sort"]')
      const cleanupStage = q('[data-stage="cleanup"]')
      const betweenPanel = q('[data-between]')
      const betweenSummary = q('[data-between-summary]')
      const cleanupScore = q('[data-cleanup-score]')
      const cleanupProgress = q('[data-cleanup-progress]')
      const profileIcon = q('[data-profile-icon]')
      const profileLabel = q('[data-profile-label]')
      const profileValue = q('[data-profile-value]')
      const cleanupNext = q<HTMLButtonElement>('[data-cleanup-next]')
      const winPanel = q('[data-win]')
      const winSummary = q('[data-win-summary]')
      const winMessage = q('[data-win-message]')
      const reviewBox = q('[data-review]')
      const reviewList = q('[data-review-list]')
      const cardsTray = q('[data-cards-tray]')
      const zones = root.querySelectorAll<HTMLElement>('[data-zone]')
      const actionButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-action]'))
      const restartBtns = root.querySelectorAll('[data-restart]')
      const cardTemplate = q<HTMLTemplateElement>('template[data-card-template]')
      const emptyTemplate = q<HTMLTemplateElement>('template[data-empty-template]')
      const reviewTemplate = q<HTMLTemplateElement>('template[data-review-template]')

      if (!scoreEl || !stageLabel || !feedbackEl || !feedbackTitle || !feedbackText || !sortStage || !cleanupStage ||
          !betweenPanel || !betweenSummary || !cleanupScore || !cleanupProgress || !profileIcon || !profileLabel ||
          !profileValue || !cleanupNext || !winPanel || !winSummary || !winMessage || !reviewBox || !reviewList ||
          !cardsTray || !cardTemplate || !emptyTemplate || !reviewTemplate || zones.length === 0) return

      // ── State ─────────────────────────────────────────────────────────────
      let deck: DpActivityRule[] = []
      let placedCount = 0
      let sortFirstTry = 0
      let sortMissed = new Set<number>()
      let selectedCard: HTMLElement | null = null
      let draggedCard: HTMLElement | null = null
      let busy = false

      let profileDeck: DpProfileRule[] = []
      let profileIndex = 0
      let profileCorrect = 0
      let profileFirstTry = 0
      let profileMissed = new Set<number>()
      let profileAnswered = false

      const zoneMap = new Map<string, HTMLElement>()
      zones.forEach((zone) => zoneMap.set(zone.dataset.zone || '', zone))

      const getCards = () => Array.from(root.querySelectorAll<HTMLElement>('[data-activity-id]'))
      const getWrapper = (card: HTMLElement) => card.closest('.activity-card-wrapper') as HTMLElement | null
      const getChoices = (card: HTMLElement) => getWrapper(card)?.querySelector<HTMLElement>('.activity-card__choices') ?? null

      // ── Feedback: explanation of the last answer, always in view ──────────
      const showFeedback = (type: 'correct' | 'wrong' | 'info', title: string, text: string) => {
        feedbackTitle.textContent = title
        feedbackText.textContent = text
        feedbackEl.className = `fp-game__feedback fp-game__feedback--${type}`
        feedbackEl.hidden = false
      }
      const hideFeedback = () => {
        feedbackEl.hidden = true
        feedbackTitle.textContent = ''
        feedbackText.textContent = ''
      }

      // ── Which part of the game is on screen ───────────────────────────────
      const showStage = (stage: 'sort' | 'between' | 'cleanup' | 'done') => {
        sortStage.hidden = stage !== 'sort'
        betweenPanel.hidden = stage !== 'between'
        cleanupStage.hidden = stage !== 'cleanup'
        winPanel.hidden = stage !== 'done'
        stageLabel.hidden = stage === 'done'
        stageLabel.textContent = stage === 'cleanup' ? labels.stage2Label : labels.stage1Label
      }

      // ═════════════════════════ STEP 1: SORT ═══════════════════════════════
      const updateScore = () => {
        scoreEl.textContent = `${placedCount} / ${deck.length}`
      }

      const buildCard = (rule: DpActivityRule): HTMLElement => {
        const item = activityById.get(rule.id)
        const wrapper = cardTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement
        wrapper.querySelector<HTMLElement>('.activity-card')!.dataset.activityId = String(rule.id)
        wrapper.querySelector('.activity-card__emoji')!.textContent = item?.emoji ?? ''
        wrapper.querySelector('.activity-card__text')!.textContent = item?.text ?? ''
        return wrapper
      }

      const deselectCard = () => {
        if (selectedCard) {
          selectedCard.classList.remove('activity-card--selected')
          selectedCard.setAttribute('aria-pressed', 'false')
          const choices = getChoices(selectedCard)
          if (choices) choices.hidden = true
        }
        selectedCard = null
      }

      const handleCardClick = (card: HTMLElement) => {
        if (busy) return
        const id = Number(card.dataset.activityId)
        if (card.dataset.placed === 'true') {
          // A placed card can be tapped to read its explanation again
          const item = activityById.get(id)
          const rule = activityRuleById.get(id)
          if (item && rule) showFeedback('info', zoneLabel(rule.zone), item.explanation)
          return
        }
        if (selectedCard === card) {
          deselectCard()
          return
        }
        deselectCard()
        selectedCard = card
        card.classList.add('activity-card--selected')
        card.setAttribute('aria-pressed', 'true')
        const choices = getChoices(card)
        if (choices) choices.hidden = false
      }

      const moveCardToZone = (card: HTMLElement, zone: HTMLElement) => {
        const wrapper = getWrapper(card)
        const content = zone.querySelector('[data-zone-content]')
        if (!content || !wrapper) return
        content.querySelector('.drop-zone__empty')?.remove()
        content.appendChild(wrapper)
      }

      const focusNextCard = () => {
        getCards().find((card) => card.dataset.placed !== 'true')?.focus()
      }

      const performDrop = (card: HTMLElement, zone: HTMLElement, options: { focusNext?: boolean } = {}) => {
        if (card.dataset.placed === 'true' || busy) return
        const id = Number(card.dataset.activityId)
        const rule = activityRuleById.get(id)
        const item = activityById.get(id)
        if (!rule || !item) return

        busy = true
        const chosen = zone.dataset.zone as DpZone

        if (rule.zone === chosen) {
          card.dataset.placed = 'true'
          card.classList.add('activity-card--placed')
          card.draggable = false
          card.tabIndex = -1
          card.setAttribute('aria-pressed', 'false')
          deselectCard()
          moveCardToZone(card, zone)

          placedCount++
          if (!sortMissed.has(id)) sortFirstTry++
          updateScore()
          showFeedback('correct', fmt(labels.correctInTemplate, { zone: zoneLabel(chosen) }), item.explanation)
          if (options.focusNext) focusNextCard()

          setTimeout(() => {
            busy = false
            checkSortDone()
          }, 600)
        } else {
          // Wrong zone: counts against the first-try score, and the explanation says why
          sortMissed.add(id)
          card.classList.add('activity-card--wrong')
          showFeedback('wrong', labels.tryOtherZone, item.explanation)

          setTimeout(() => {
            card.classList.remove('activity-card--wrong')
            busy = false
          }, 700)
        }
      }

      const handleZoneClick = (zone: HTMLElement) => {
        if (!selectedCard || busy || selectedCard.dataset.placed === 'true') return
        performDrop(selectedCard, zone)
      }

      const checkSortDone = () => {
        if (getCards().length === 0 || !getCards().every((card) => card.dataset.placed === 'true')) return
        betweenSummary.textContent = fmt(labels.firstTryTemplate, { n: sortFirstTry, total: deck.length })
        setTimeout(() => {
          hideFeedback()
          showStage('between')
          root.querySelector<HTMLElement>('#between-title')?.focus()
        }, 400)
      }

      // ── Drag event handlers ───────────────────────────────────────────────
      const handleDragStart = (e: DragEvent) => {
        if (!(e.target instanceof HTMLElement)) return
        const card = e.target.closest('[data-activity-id]') as HTMLElement | null
        if (!card || card.dataset.placed === 'true') {
          e.preventDefault()
          return
        }
        draggedCard = card
        card.classList.add('activity-card--dragging')
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move'
          e.dataTransfer.setData('text/plain', card.dataset.activityId || '')
        }
      }

      const handleDragEnd = (e: DragEvent) => {
        if (!(e.target instanceof HTMLElement)) return
        e.target.closest('[data-activity-id]')?.classList.remove('activity-card--dragging')
        zones.forEach((zone) => zone.classList.remove('drop-zone--active'))
      }

      const handleDragOver = (e: DragEvent) => {
        e.preventDefault()
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move'
        const zone = (e.target as HTMLElement).closest('[data-zone]') as HTMLElement | null
        zone?.classList.add('drop-zone--active')
      }

      const handleDragLeave = (e: DragEvent) => {
        const zone = (e.target as HTMLElement).closest('[data-zone]') as HTMLElement | null
        if (zone && e.target === zone) zone.classList.remove('drop-zone--active')
      }

      const handleDrop = (e: DragEvent) => {
        e.preventDefault()
        if (!draggedCard) return
        const zone = (e.target as HTMLElement).closest('[data-zone]') as HTMLElement | null
        if (!zone) return
        zone.classList.remove('drop-zone--active')
        performDrop(draggedCard, zone)
        draggedCard = null
      }

      // ═════════════════════════ STEP 2: CLEAN UP ═══════════════════════════
      const updateCleanupScore = () => {
        cleanupScore.textContent = `${profileCorrect} / ${profileDeck.length} ${labels.cleanupScoreLabel}`.trim()
      }

      const renderProfile = () => {
        const rule = profileDeck[profileIndex]
        const item = rule && profileById.get(rule.id)
        if (!rule || !item) return
        profileAnswered = false
        hideFeedback()
        profileIcon.textContent = item.icon
        profileLabel.textContent = item.label
        profileValue.textContent = item.value
        cleanupProgress.textContent = fmt(labels.cleanupProgressTemplate, { n: profileIndex + 1, total: profileDeck.length })
        cleanupNext.hidden = true
        cleanupNext.textContent = profileIndex + 1 >= profileDeck.length ? labels.resultsButton : labels.nextButton
        actionButtons.forEach((button) => {
          button.disabled = false
          button.classList.remove('is-right', 'is-wrong')
          button.style.opacity = '1'
        })
        updateCleanupScore()
        actionButtons[0]?.focus({ preventScroll: true })
      }

      const handleAction = (button: HTMLButtonElement) => {
        if (profileAnswered) return
        const rule = profileDeck[profileIndex]
        const item = rule && profileById.get(rule.id)
        if (!rule || !item) return
        const chosen = button.dataset.action as DpAction

        if (isProfileRight(rule, chosen)) {
          profileAnswered = true
          profileCorrect++
          if (!profileMissed.has(rule.id)) profileFirstTry++
          const title = chosen === rule.best
            ? labels.cleanupCorrect
            : `${labels.cleanupAlso} ${fmt(labels.cleanupBestTemplate, { action: actionTexts[rule.best] })}`
          showFeedback('correct', title, item.explanation)
          actionButtons.forEach((other) => {
            other.disabled = true
            const isChosen = other === button
            other.classList.toggle('is-right', isChosen)
            other.style.opacity = isChosen ? '1' : '0.45'
          })
          updateCleanupScore()
          cleanupNext.hidden = false
          cleanupNext.focus()
        } else {
          // Wrong choice: it counts against the first-try score, and the explanation says why
          profileMissed.add(rule.id)
          button.disabled = true
          button.classList.add('is-wrong')
          button.style.opacity = '0.6'
          showFeedback('wrong', labels.cleanupWrong, item.explanation)
        }
      }

      const startCleanup = () => {
        hideFeedback()
        showStage('cleanup')
        renderProfile()
        root.querySelector<HTMLElement>('#cleanup-title')?.scrollIntoView({ block: 'start' })
      }

      const showFinal = () => {
        const total = deck.length + profileDeck.length
        const firstTry = sortFirstTry + profileFirstTry
        recordResult('dp', firstTry, total)
        winSummary.textContent = fmt(labels.firstTryTemplate, { n: firstTry, total })
        const rank = rankFor(firstTry, total)
        winMessage.textContent = rank === 'great' ? labels.winGreat : rank === 'good' ? labels.winGood : labels.winPractise

        reviewList.replaceChildren()
        const addReview = (text: string, answer: string) => {
          const row = reviewTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement
          row.querySelector('[data-review-text]')!.textContent = text
          row.querySelector('[data-review-answer]')!.textContent = `→ ${answer}`
          reviewList.append(row)
        }
        deck.filter((rule) => sortMissed.has(rule.id)).forEach((rule) => {
          const item = activityById.get(rule.id)
          addReview(`${item?.emoji ?? ''} ${item?.text ?? ''}`.trim(), zoneLabel(rule.zone))
        })
        profileDeck.filter((rule) => profileMissed.has(rule.id)).forEach((rule) => {
          const item = profileById.get(rule.id)
          addReview(`${item?.icon ?? ''} ${item?.label ?? ''}: ${item?.value ?? ''}`.trim(), actionTexts[rule.best])
        })
        reviewBox.hidden = reviewList.children.length === 0

        hideFeedback()
        showStage('done')
        winPanel.scrollIntoView({ behavior: 'smooth', block: 'center' })
        winPanel.querySelector<HTMLElement>('#win-title')?.focus({ preventScroll: true })
      }

      // ═════════════════════════ DEAL + RESTART ═════════════════════════════
      const emptyZones = () => {
        zones.forEach((zone) => {
          const content = zone.querySelector<HTMLElement>('[data-zone-content]')
          content?.replaceChildren(emptyTemplate.content.firstElementChild!.cloneNode(true))
        })
      }

      const deal = () => {
        deck = dealActivities()
        placedCount = 0
        sortFirstTry = 0
        sortMissed = new Set<number>()
        selectedCard = null
        draggedCard = null
        busy = false
        profileDeck = dealProfile()
        profileIndex = 0
        profileCorrect = 0
        profileFirstTry = 0
        profileMissed = new Set<number>()
        profileAnswered = false
        cardsTray.replaceChildren(...deck.map(buildCard))
        updateScore()
      }

      const restart = () => {
        hideFeedback()
        emptyZones()
        deal()
        showStage('sort')
        getCards()[0]?.focus({ preventScroll: true })
      }

      // ── Listeners ─────────────────────────────────────────────────────────
      root.addEventListener('dragstart', handleDragStart, true)
      root.addEventListener('dragend', handleDragEnd, true)

      zones.forEach((zone) => {
        zone.addEventListener('dragover', handleDragOver)
        zone.addEventListener('dragleave', handleDragLeave)
        zone.addEventListener('drop', handleDrop)
        zone.addEventListener('click', (e) => {
          // A click on a card or its buttons inside the zone is not a click on the zone itself
          if (e.target instanceof HTMLElement && e.target.closest('[data-activity-id], .activity-card__choices')) return
          handleZoneClick(zone)
        })
      })

      // Cards are created again for every game, so one set of delegated listeners handles them all
      root.addEventListener('click', (e) => {
        const target = e.target
        if (!(target instanceof HTMLElement)) return

        // "Where does it go?" buttons under the selected card
        const choice = target.closest<HTMLElement>('[data-choose]')
        if (choice) {
          const card = getWrapper(choice)?.querySelector<HTMLElement>('[data-activity-id]')
          const zone = zoneMap.get(choice.dataset.choose ?? '')
          if (card && zone) performDrop(card, zone, { focusNext: true })
          return
        }

        const card = target.closest<HTMLElement>('[data-activity-id]')
        if (card) handleCardClick(card)
      })

      root.addEventListener('keydown', (e) => {
        const target = e.target
        if (!(target instanceof HTMLElement)) return

        const card = target.closest<HTMLElement>('[data-activity-id]')
        if (card && target === card) {
          if (e.key === 'Escape' && selectedCard === card) {
            deselectCard()
            return
          }
          if ((e.key !== 'Enter' && e.key !== ' ') || e.repeat || card.dataset.placed === 'true') return
          e.preventDefault()
          const wasSelected = selectedCard === card
          handleCardClick(card)
          // Newly selected → continue with the buttons right below the card
          if (!wasSelected && selectedCard === card) getChoices(card)?.querySelector<HTMLElement>('button')?.focus()
          return
        }

        // Escape inside the zone buttons: back to the card
        if (e.key === 'Escape' && target.closest('.activity-card__choices') && selectedCard) {
          const back = selectedCard
          deselectCard()
          back.focus()
        }
      })

      actionButtons.forEach((button) => button.addEventListener('click', () => handleAction(button)))
      cleanupNext.addEventListener('click', () => {
        profileIndex++
        if (profileIndex >= profileDeck.length) showFinal()
        else renderProfile()
      })
      root.querySelector('[data-to-cleanup]')?.addEventListener('click', startCleanup)
      restartBtns.forEach((btn) => btn.addEventListener('click', restart))

      // Initial setup
      deal()
      showStage('sort')
    })
  }

  document.addEventListener('astro:page-load', initializeFootprintGame)
  initializeFootprintGame()
</script>

