---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Icon } from 'astro-icon/components'
import { localizePath } from '../i18n/i18n'
import { useTranslations } from '../i18n/index'

const locale = Astro.currentLocale
const { t } = useTranslations(locale)

const hub = localizePath(locale, '/learning-hub/introduction/')
const GITHUB = 'https://github.com/KidCyProject/KidCyProject.github.io'

const benefits = [
  { icon: 'lucide:presentation', title: 'benefitEducators', desc: 'benefitEducatorsDesc' },
  { icon: 'lucide:backpack', title: 'benefitStudents', desc: 'benefitStudentsDesc' },
  { icon: 'lucide:school', title: 'benefitSchools', desc: 'benefitSchoolsDesc' },
]

const values = [
  { image: '/images/about/scalable.webp', title: 'scalableImpact', desc: 'scalableImpactDesc' },
  { image: '/images/about/international.webp', title: 'internationalCollab', desc: 'internationalCollabDesc' },
  { image: '/images/about/adaptable.webp', title: 'practicalAdaptable', desc: 'practicalAdaptableDesc' },
  { image: '/images/about/european.webp', title: 'europeanCohesion', desc: 'europeanCohesionDesc' },
]

const partners = [
  {
    name: 'uniLiechtenstein',
    desc: 'uniLiechtensteinDesc',
    country: 'countryLI',
    logo: '/images/about/Universitat_Liechtenstein_logo.svg',
    url: 'https://www.uni.li/en',
  },
  {
    name: 'cyberSecurityHub',
    desc: 'cyberSecurityHubDesc',
    country: 'countryCZ',
    logo: '/images/about/cyberSecurityHubCZ-logo-black_cut.webp',
    url: 'https://www.cybersecurityhub.cz/',
  },
  {
    name: 'uniInlandNorway',
    desc: 'uniInlandNorwayDesc',
    country: 'countryNO',
    logo: '/images/about/University_of_Inland_Norway_logo.svg.webp',
    url: 'https://www.inn.no/english/',
  },
  {
    name: 'uniInnsbruck',
    desc: 'uniInnsbruckDesc',
    country: 'countryAT',
    logo: '/images/about/Universitaet-innsbruck-logo-rgb-farbe.svg.webp',
    url: 'https://www.uibk.ac.at/en',
  },
  {
    name: 'vilniusUni',
    desc: 'vilniusUniDesc',
    country: 'countryLT',
    logo: '/images/about/Logo_vilnius_university.webp',
    url: 'https://www.vu.lt/en',
  },
]

const involve = [
  { icon: 'lucide:bug', key: 'involvedIssue', href: `${GITHUB}/issues` },
  { icon: 'lucide:message-square-text', key: 'involvedFeedback', href: `${GITHUB}/issues` },
  { icon: 'lucide:handshake', key: 'involvedPartner', href: '#partners' },
]
---

<DefaultLayout title={t('pages.about.title')}>
  <PageHeader title={t('pages.about.title')} subtitle={t('pages.about.subtitle')} bgType="module" />

  <!-- Mission -->
  <section class="page-section" aria-labelledby="mission-title">
    <div class="container split">
      <div>
        <p class="eyebrow" id="mission-title">{t('pages.about.missionTitle')}</p>
        <p class="statement">{t('pages.about.missionStatement')}</p>
        <p class="section-sub">{t('pages.about.missionSummary')}</p>
        <details class="read-more">
          <summary>
            <span class="rm-closed">{t('pages.home.readMore')}</span>
            <span class="rm-open">{t('pages.home.readLess')}</span>
          </summary>
          <p>{t('pages.about.missionP1')}</p>
          <p>{t('pages.about.missionP2')}</p>
          <p>{t('pages.about.missionP3')}</p>
        </details>
      </div>
      <img class="float" src="/images/about/mission.webp" alt="" width="400" height="400" decoding="async" loading="eager" />
    </div>
  </section>

  <!-- Who benefits -->
  <section class="page-section page-section--alt" aria-labelledby="benefits-title">
    <div class="container">
      <p class="eyebrow">{t('pages.about.benefitsEyebrow')}</p>
      <h2 class="section-title" id="benefits-title">{t('pages.about.benefitsTitle')}</h2>

      <ul class="benefit-grid" role="list">
        {benefits.map((benefit) => (
          <li class="core-value-card benefit-card">
            <span class="benefit-card__icon" aria-hidden="true"><Icon name={benefit.icon} /></span>
            <h3 class="core-value-title">{t(`pages.about.${benefit.title}`)}</h3>
            <p class="core-value-description">{t(`pages.about.${benefit.desc}`)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Core values -->
  <section class="page-section" id="our-values" aria-labelledby="values-title">
    <div class="container">
      <p class="eyebrow">{t('pages.about.coreValuesEyebrow')}</p>
      <h2 class="section-title" id="values-title">{t('pages.about.coreValuesTitle')}</h2>

      <div class="core-values-grid">
        {values.map((value) => (
          <article class="core-value-card value-card">
            <div class="core-value-media">
              <img src={value.image} alt="" loading="lazy" />
            </div>
            <div class="value-card__text">
              <h3 class="core-value-title" set:html={t(`pages.about.${value.title}`)} />
              <p class="core-value-description">{t(`pages.about.${value.desc}`)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="page-section page-section--alt" id="partners" aria-labelledby="partners-title">
    <div class="container">
      <p class="eyebrow">{t('pages.about.partnersEyebrow')}</p>
      <h2 class="section-title" id="partners-title">{t('pages.about.partnersHeading')}</h2>
      <p class="section-sub">{t('pages.about.initiativeDesc')}</p>

      <ul class="partner-grid" role="list">
        {partners.map((partner) => (
          <li class="core-value-card initiative-partner-card">
            <img class="logo-image" src={partner.logo} alt="" loading="lazy" />
            <h3 class="partner-name">{t(`pages.about.${partner.name}`)}</h3>
            <p class="partner-country">
              <Icon name="lucide:map-pin" aria-hidden="true" />
              {t(`pages.about.${partner.country}`)}
            </p>
            <a class="button has-icon partner-link" href={partner.url} rel="noopener noreferrer">
              <Icon name="lucide:external-link" aria-hidden="true" />
              {t('pages.about.visitWebsite')}
              <span class="sr-only"> – {t(`pages.about.${partner.name}`)}</span>
            </a>
            <details class="read-more">
              <summary>
                <span class="rm-closed">{t('pages.home.readMore')}</span>
                <span class="rm-open">{t('pages.home.readLess')}</span>
              </summary>
              <p>{t(`pages.about.${partner.desc}`)}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Funding -->
  <section class="page-section" aria-labelledby="funding-title">
    <div class="container split">
      <div class="funding-logo">
        <img src="/images/EN_Co-fundedbytheEU_RGB_POS.webp" alt="Co-funded by the European Union" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">{t('pages.about.fundingEyebrow')}</p>
        <h2 class="section-title" id="funding-title">{t('pages.about.cofundEU')}</h2>
        <p class="section-sub">{t('pages.about.cofundEUDesc')}</p>
      </div>
    </div>
  </section>

  <!-- Get involved -->
  <section class="page-section page-section--alt" aria-labelledby="involved-title">
    <div class="container">
      <h2 class="section-title" id="involved-title">{t('pages.about.getInvolvedTitle')}</h2>
      <p class="section-sub">{t('pages.about.getInvolvedP1')}</p>
      <details class="read-more">
        <summary>
          <span class="rm-closed">{t('pages.home.readMore')}</span>
          <span class="rm-open">{t('pages.home.readLess')}</span>
        </summary>
        <p>{t('pages.about.getInvolvedP2')}</p>
        <p>{t('pages.about.getInvolvedP3')}</p>
      </details>

      <ul class="benefit-grid" role="list">
        {involve.map((item) => (
          <li class="core-value-card benefit-card">
            <span class="benefit-card__icon" aria-hidden="true"><Icon name={item.icon} /></span>
            <h3 class="core-value-title">{t(`pages.about.${item.key}Title`)}</h3>
            <p class="core-value-description">{t(`pages.about.${item.key}Desc`)}</p>
            <a class="button has-icon is-outline" href={item.href}>
              {t(`pages.about.${item.key}Cta`)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="page-section final-cta" aria-labelledby="cta-title">
    <div class="container">
      <h2 class="section-title" id="cta-title">{t('pages.about.ctaTitle')}</h2>
      <p class="section-sub">{t('pages.about.ctaText')}</p>
      <div class="cta-row">
        <a class="button has-icon" href={hub}>
          <Icon name="lucide:graduation-cap" />
          {t('layout.hero.explore')}
        </a>
        <a class="button has-icon is-outline" href={GITHUB} rel="noopener noreferrer">
          <Icon name="lucide:git-branch" />
          {t('pages.about.viewOnGithub')}
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  /* ── Two-column rows (mission, funding) ───────────────────────────────── */
  .split {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .statement {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .split > img {
    width: 100%;
    max-width: 380px;
    height: auto;
    justify-self: center;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  .float {
    animation: float 6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .float {
      animation: none;
    }
  }

  /* ── Cards: who benefits and ways to get involved ─────────────────────── */
  .benefit-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 768px) {
    .benefit-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .benefit-card {
    align-items: flex-start;
  }

  .benefit-card__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    font-size: 1.5rem;
    color: #1d4ed8;
    background: rgba(37, 99, 235, 0.12);
  }

  :global(html.darkmode) .benefit-card__icon {
    color: var(--dm-primary);
  }

  .benefit-card .button {
    margin-top: auto;
    border-radius: 10px;
  }

  /* ── Core values: 2 × 2 with full text ────────────────────────────────── */
  :global(.core-values-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 900px) {
    :global(.core-values-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .value-card {
    flex-direction: row;
    align-items: flex-start;
  }

  .value-card :global(.core-value-media) {
    flex: none;
    width: 7.5rem;
    min-height: 0;
    aspect-ratio: 1;
  }

  .value-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (max-width: 520px) {
    .value-card {
      flex-direction: column;
    }
  }

  :global(.core-value-card) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid #dbe2ea;
    border-radius: 1rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    box-shadow: var(--elevation-1);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  :global(.core-value-card:hover),
  :global(.core-value-card:focus-within) {
    transform: translateY(-4px);
    box-shadow: var(--elevation-3);
    border-color: #2563eb;
  }

  :global(.core-value-media) {
    display: grid;
    align-items: center;
    justify-items: center;
    padding: 0.75rem;
    border-radius: 0.9rem;
    border: 1px solid #bfdbfe;
    background: linear-gradient(160deg, #eff6ff 0%, #dbeafe 100%);
  }

  :global(.core-value-media img) {
    width: 100%;
    max-width: 120px;
    height: auto;
    object-fit: contain;
  }

  :global(.core-value-title) {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
    color: #0f172a;
  }

  :global(.core-value-description) {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #334155;
  }

  /* ── Partners ─────────────────────────────────────────────────────────── */
  .partner-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .initiative-partner-card {
    flex: 1 1 18rem;
    max-width: 24rem;
    height: auto;
    gap: 0.6rem;
  }

  .logo-image {
    width: 100%;
    height: 7.5rem;
    object-fit: contain;
    padding: 1.25rem;
    margin-bottom: 0.5rem;
    border-radius: 0.9rem;
    border: 1px solid #bfdbfe;
    background: linear-gradient(160deg, #eff6ff 0%, #dbeafe 100%);
  }

  .partner-name {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .partner-country {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    font-weight: 700;
    color: var(--link-color);
  }

  .partner-link {
    align-self: flex-start;
    margin-block: 0.25rem;
  }

  .initiative-partner-card .read-more {
    margin: 0.25rem 0 0;
  }

  /* ── Funding ──────────────────────────────────────────────────────────── */
  .funding-logo {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    border: 2px solid var(--brand-primary);
    border-radius: 1rem;
    background: #ffffff;
  }

  .funding-logo img {
    width: 100%;
    max-width: 26rem;
    height: auto;
  }

  /* ── Closing call to action ───────────────────────────────────────────── */
  .final-cta {
    text-align: center;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .button {
    border-radius: 10px;
    color: var(--button-text-color);
  }

  .button.is-outline {
    color: var(--link-color);
  }
</style>
