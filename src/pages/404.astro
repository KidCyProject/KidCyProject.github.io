---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Icon } from 'astro-icon/components'
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, localizePath } from '../i18n/i18n'
import { useTranslations } from '../i18n/index'

const homeHref = localizePath(Astro.currentLocale, '/')
const { t } = useTranslations(Astro.currentLocale)

// GitHub Pages answers every missing address with the one file 404.html (this page in English).
// The same page is also built per language at /cs/404/, /de/404/ …; the script below sends a
// visitor who was on a /cs/…, /de/… address to the 404 page in that language.
const localized = SUPPORTED_LOCALES.filter((code) => code !== DEFAULT_LOCALE)
---

<DefaultLayout title={t('notFound.title')} noindex>
  <script is:inline define:vars={{ localized }}>
    ;(function () {
      var parts = window.location.pathname.split('/').filter(Boolean)
      var language = parts[0]
      if (localized.indexOf(language) === -1) return // English address: this page is the right one
      if (parts.length === 2 && parts[1] === '404') return // already on the page of that language
      window.location.replace('/' + language + '/404/')
    })()
  </script>
  <section class="my-12 flex flex-col items-center justify-center text-center pb-12">
    <div class="container space-content">
      <div class="mb-6 mt-16 flex justify-center">
        <Icon name="lucide:map-pin-off" class="w-32 h-32 mx-auto" style="color: #2563eb;" />
      </div>

      <h1 class="font-black mb-2" style="font-size: clamp(3.5rem, 2rem + 3vw, 5rem); text-decoration: underline; text-decoration-color: #2563eb;">{t('notFound.code')}</h1>
      <h2 class="text-3xl font-bold mb-6 mt-2">{t('notFound.heading')}</h2>

      <p class="text-xl mb-12" style="color: var(--color-neutral-700); max-width: 600px; margin-left: auto; margin-right: auto;">
        {t('notFound.message')}
      </p>

      <div class="mt-10 flex flex-col items-center justify-center text-center">
        <a class="button has-icon text-lg" href={homeHref} style="background-color: #2563eb; color: #fff; border-color: #2563eb; border-radius: 10px; padding: 0.75rem 1.5rem;">
          <Icon name="lucide:home" />
          {t('notFound.backHome')}
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>
